// The first screen: the saves of the game in use, listed like the game's own Load
// screen with the selected save's picture and party beside them. With both games
// installed, one button switches to the other game's saves (and its colours).

import { Theme } from "theme.slint";
import { App, SaveRow } from "state.slint";
import { Button, Label, Note, Scroller, Field, IconButton } from "widgets.slint";

component SaveLine inherits Rectangle {
    in property <SaveRow> save;
    in property <bool> on;
    callback chosen();
    callback opened();
    height: 92px;
    border-radius: 7px;
    border-width: 1px;
    border-color: on ? Theme.accent : transparent;
    background: on ? Theme.selected : touch.has-hover ? Theme.hover : transparent;
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.chosen(); }
        double-clicked => { root.opened(); }
    }
    HorizontalLayout {
        padding: 10px;
        spacing: 16px;
        Rectangle {
            width: 96px;
            border-radius: 3px;
            border-width: 1px;
            border-color: Theme.edge;
            background: Theme.field;
            clip: true;
            if save.has-shot: Image { source: save.shot; width: parent.width; height: parent.height; image-fit: fill; }
        }
        VerticalLayout {
            alignment: center;
            spacing: 4px;
            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                Text {
                    text: save.name;
                    font-family: Theme.list-font;
                    font-size: 21px * Theme.ts;
                    color: on ? Theme.gold : Theme.text;
                    overflow: elide;
                }
                if save.tag != "": Rectangle {
                    border-width: 1px;
                    border-color: Theme.edge;
                    border-radius: 3px;
                    width: tag.preferred-width + 12px;
                    height: 18px;
                    y: 3px;
                    tag := Text { text: save.tag; font-family: Theme.label-font; font-size: 11px * Theme.ts; letter-spacing: 2px; color: Theme.accent; }
                }
            }
            Text { text: save.area; font-family: Theme.body-font; font-size: 14.5px * Theme.ts; color: Theme.muted; overflow: elide; }
        }
        VerticalLayout {
            alignment: center;
            spacing: 4px;
            Text { text: save.time; horizontal-alignment: right; font-family: Theme.body-font; font-size: 13.5px * Theme.ts; color: Theme.faint; }
            Text { text: save.date; horizontal-alignment: right; font-family: Theme.body-font; font-size: 13.5px * Theme.ts; color: Theme.faint; }
        }
    }
}

export component SavesPage inherits Rectangle {
    // The game switch, when both games are installed, left of the settings button.
    if App.has-k1 && App.has-k2: Rectangle {
        x: parent.width - 60px - 50px - 14px - self.width;
        y: 52px;
        width: 290px;
        height: 50px;
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.edge;
        clip: true;
        HorizontalLayout {
            for game[i] in ["KotOR", "KotOR II"]: Rectangle {
                property <bool> on: (i == 1) == App.showing-k2;
                background: on ? @linear-gradient(180deg, Theme.fill-top 0%, Theme.fill-bottom 100%) : Theme.field;
                Text { text: game; font-family: Theme.list-font; font-size: 19px * Theme.ts; color: on ? Theme.ink : Theme.soft; }
                TouchArea { mouse-cursor: pointer; clicked => { App.switch-game(i == 1); } }
            }
        }
    }

    property <length> list-width: (self.width - 120px - 24px) * 0.47;

    // The list.
    Rectangle {
        x: 60px;
        y: 200px;
        width: list-width;
        height: parent.height - 200px - 66px;
        background: Theme.panel;
        border-width: 1px;
        border-color: Theme.panel-edge;
        border-radius: 10px;
        HorizontalLayout {
            x: 24px;
            y: 18px;
            height: 24px;
            spacing: 16px;
            alignment: start;
            Label { text: App.showing-k2 ? "KOTOR II SAVES" : "KOTOR SAVES"; vertical-alignment: center; }
            Note { text: App.saves-note; vertical-alignment: center; }
        }
        list := Scroller {
            x: 14px;
            y: 56px;
            width: parent.width - 20px;
            height: parent.height - 70px;
            content-height: App.saves.length * 96px;
            VerticalLayout {
                spacing: 4px;
                for row[i] in App.saves: SaveLine {
                    save: row;
                    on: i == App.selected-save;
                    chosen => { App.select-save(i); }
                    opened => { App.select-save(i); App.open-save(); }
                }
            }
        }
        if App.saves.length == 0: VerticalLayout {
            x: 40px;
            y: 90px;
            width: parent.width - 80px;
            spacing: 10px;
            Text { text: App.empty-title; font-family: Theme.title-font; font-size: 24px * Theme.ts; color: Theme.text; wrap: word-wrap; }
            Note { text: App.empty-note; font-size: 15px * Theme.ts; }
        }
    }

    // The selected save.
    Rectangle {
        x: 60px + list-width + 24px;
        y: 200px;
        width: parent.width - self.x - 60px;
        height: parent.height - 200px - 66px;
        background: Theme.panel;
        border-width: 1px;
        border-color: Theme.panel-edge;
        border-radius: 10px;
        visible: App.saves.length > 0;
        property <length> inner: self.width - 44px;
        // the pen pressed: the name is a text box until Enter, the save icon or Escape
        property <bool> renaming;
        property <string> new-name;
        shot := Rectangle {
            x: 22px;
            y: 22px;
            width: inner;
            height: min(inner * 0.5, parent.height - 300px);
            border-radius: 6px;
            border-width: 1px;
            border-color: Theme.edge;
            background: Theme.field;
            clip: true;
            if App.preview-has-shot: Image { source: App.preview-shot; width: parent.width; height: parent.height; image-fit: fill; }
        }
        // The name with its pen, the place under it, and Copy on the right (2026-10-24, the
        // maintainer).
        HorizontalLayout {
            x: 22px;
            y: shot.y + shot.height + 18px;
            width: inner;
            spacing: 18px;
            VerticalLayout {
                spacing: 4px;
                alignment: start;
                horizontal-stretch: 1;
                HorizontalLayout {
                    height: 44px;
                    spacing: renaming ? 12px : 4px;
                    alignment: start;
                    if !renaming: Text {
                        max-width: inner - 260px;
                        text: App.preview-name;
                        font-family: Theme.title-font;
                        font-size: 30px * Theme.ts;
                        color: Theme.text;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    // the pen: only its lines, at the name's top right, yellow under the mouse
                    if !renaming: VerticalLayout {
                        alignment: start;
                        Rectangle {
                            width: 22px;
                            height: 22px;
                            Path {
                                width: 18px;
                                height: 18px;
                                viewbox-width: 24;
                                viewbox-height: 24;
                                stroke: pen-touch.has-hover ? Theme.hover-edge : Theme.accent;
                                stroke-width: 1.8px;
                                stroke-line-cap: round;
                                commands: "M 4 20 L 8 20 L 19 9 L 15 5 L 4 16 Z M 13 7 L 17 11";
                            }
                            pen-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    new-name = App.preview-name;
                                    renaming = true;
                                }
                            }
                        }
                    }
                    if renaming: FocusScope {
                        width: inner - 260px;
                        key-pressed(event) => {
                            if event.text == Key.Escape {
                                renaming = false;
                                return accept;
                            }
                            reject
                        }
                        name-box := Field {
                            height: 44px;
                            text <=> new-name;
                            font: Theme.title-font;
                            font-size: 24px * Theme.ts;
                            init => { self.focus-all(); }
                            accepted(t) => {
                                renaming = false;
                                App.rename-save(t);
                            }
                        }
                    }
                    if renaming: IconButton {
                        width: 44px;
                        lit: true;
                        icon: "M 5 4 L 16 4 L 19 7 L 19 20 L 5 20 Z M 8 4 L 8 9 L 15 9 L 15 4 M 8 20 L 8 14 L 16 14 L 16 20";
                        clicked => {
                            renaming = false;
                            App.rename-save(new-name);
                        }
                    }
                }
                Text { text: App.preview-area; font-family: Theme.body-font; font-size: 16px * Theme.ts; color: Theme.muted; overflow: elide; }
            }
            VerticalLayout {
                alignment: start;
                IconButton {
                    text: "Copy";
                    icon: "M 6.6 7 L 11.3 7 L 15.2 10.9 L 15.2 18.5 A 1.6 1.6 0 0 1 13.6 20.1 L 6.6 20.1 A 1.6 1.6 0 0 1 5 18.5 L 5 8.6 A 1.6 1.6 0 0 1 6.6 7 Z M 11.3 7 L 11.3 10.9 L 15.2 10.9 M 8.9 6.6 L 8.9 4.6 A 1.6 1.6 0 0 1 10.5 3 L 15.5 3 L 19.3 6.8 L 19.3 14.7 A 1.6 1.6 0 0 1 17.7 16.3 L 16.6 16.3 M 15.5 3 L 15.5 6.8 L 19.3 6.8";
                    clicked => { App.copy-save(); }
                }
            }
        }
        // The party, and on the same level the character, time played and date.
        VerticalLayout {
            x: parent.width - 22px - self.width;
            y: shot.y + shot.height + 100px;
            height: 64px;
            spacing: 5px;
            alignment: center;
            for f in [["Character", App.preview-pc], ["Time played", App.preview-time], ["Saved", App.preview-date]]: HorizontalLayout {
                spacing: 18px;
                alignment: end;
                Text { text: f[0]; horizontal-alignment: right; font-family: Theme.body-font; font-size: 14.5px * Theme.ts; color: Theme.muted; }
                Text { width: 170px; text: f[1]; horizontal-alignment: right; font-family: Theme.body-font; font-size: 14.5px * Theme.ts; color: Theme.text; }
            }
        }
        HorizontalLayout {
            x: 22px;
            y: shot.y + shot.height + 100px;
            spacing: 10px;
            alignment: start;
            for p[i] in App.preview-party: Rectangle {
                width: 64px;
                height: 64px;
                border-radius: 5px;
                border-width: 1px;
                border-color: i == 0 ? Theme.gold : Theme.edge;
                clip: true;
                Image { source: p; width: parent.width; height: parent.height; }
            }
        }
        if App.preview-warning != "": Note {
            x: 22px + App.preview-party.length * 74px + 12px;
            y: shot.y + shot.height + 100px;
            width: inner - App.preview-party.length * 74px - 12px - 320px;
            text: App.preview-warning;
            color: Theme.changed;
        }
        HorizontalLayout {
            x: 22px;
            y: parent.height - 22px - 56px;
            width: inner;
            height: 56px;
            spacing: 12px;
            Button { text: "Show in Folder"; kind: 1; horizontal-stretch: 1; clicked => { App.show-folder(); } }
            Button {
                text: App.preview-read-only ? "Open to Look" : "Open This Save";
                kind: 0;
                horizontal-stretch: 2;
                clicked => { App.open-save(); }
            }
        }
    }
}
