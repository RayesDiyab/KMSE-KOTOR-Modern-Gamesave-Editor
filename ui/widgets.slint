// The controls, drawn in the KMRP style rather than taken from a widget toolkit, so they
// look the same on Windows, Linux and macOS. Nothing animates.

import { Theme } from "theme.slint";

// kind: 0 cyan fill (the main action), 1 outline, 2 grey fill (Revert), 3 small outline,
// 4 red fill (taking something out of the save)
// A rounded fill with a gradient. The software renderer rounds only a solid fill: a gradient
// one kept square corners, so every filled button showed square corners inside its rounded edge
// (2026-11-07, the maintainer: Finish Quest's corners). So the corners are drawn as solid caps in
// the gradient's end colours, and only the straight middle carries the gradient; the pieces meet
// without overlapping, so a see-through fill is not doubled where they meet. `across` runs the
// gradient left to right, `mid` adds a middle stop.
export component RoundFill inherits Rectangle {
    in property <color> from;
    in property <color> to;
    in property <color> mid;
    in property <bool> has-mid;
    in property <bool> across;
    in property <length> r: 5px;
    in property <length> r-tl: r;
    in property <length> r-tr: r;
    in property <length> r-bl: r;
    in property <length> r-br: r;
    property <length> cap: max(r-tl, r-tr, r-bl, r-br);
    if !across: Rectangle {
        y: 0; height: root.cap;
        background: root.from;
        border-top-left-radius: root.r-tl;
        border-top-right-radius: root.r-tr;
    }
    if !across: Rectangle {
        y: root.cap; height: root.height - 2 * root.cap;
        background: root.has-mid ? @linear-gradient(180deg, root.from 0%, root.mid 50%, root.to 100%) : @linear-gradient(180deg, root.from 0%, root.to 100%);
    }
    if !across: Rectangle {
        y: root.height - root.cap; height: root.cap;
        background: root.to;
        border-bottom-left-radius: root.r-bl;
        border-bottom-right-radius: root.r-br;
    }
    if across: Rectangle {
        x: 0; width: root.cap;
        background: root.from;
        border-top-left-radius: root.r-tl;
        border-bottom-left-radius: root.r-bl;
    }
    if across: Rectangle {
        x: root.cap; width: root.width - 2 * root.cap;
        background: root.has-mid ? @linear-gradient(90deg, root.from 0%, root.mid 50%, root.to 100%) : @linear-gradient(90deg, root.from 0%, root.to 100%);
    }
    if across: Rectangle {
        x: root.width - root.cap; width: root.cap;
        background: root.to;
        border-top-right-radius: root.r-tr;
        border-bottom-right-radius: root.r-br;
    }
}

export component Button inherits Rectangle {
    in property <string> text;
    in property <int> kind: 1;
    in property <bool> enabled: true;
    in property <length> font-size: 20px * Theme.ts;
    // A row-sized button of any kind (the map's rail).
    in property <bool> compact;
    callback clicked;
    min-height: kind == 3 || compact ? 38px : 50px;
    min-width: label.preferred-width + (kind == 3 ? 32px : 48px);
    border-radius: 5px;
    property <bool> graded: enabled && (kind == 0 || kind == 2);
    background: !enabled ? (kind == 0 ? Theme.selected : Theme.field)
        : graded ? transparent
        : kind == 4 ? (touch.has-hover ? Theme.danger.brighter(0.15) : Theme.danger)
        : (touch.has-hover ? Theme.hover : Theme.field);
    // the filled kinds' gradient, with its corners rounded as the edge is
    // (the grey one, which has an edge, inside it, so the two arcs do not mix into a fuzzy rim)
    property <length> inset: kind == 2 ? 1px : 0px;
    if graded: RoundFill {
        x: root.inset; y: root.inset;
        width: root.width - 2 * root.inset;
        height: root.height - 2 * root.inset;
        r: 5px - root.inset;
        from: kind == 0 ? (touch.has-hover ? Theme.fill-hover : Theme.fill-top) : Theme.grey-top;
        to: kind == 0 ? Theme.fill-bottom : Theme.grey-bottom;
    }
    // the edge, over the fill: an edge at rest on every kind but the filled ones, whose fill is
    // their edge (Revert's grey and a greyed-out Save Changes had none, 2026-11-06)
    Rectangle {
        border-radius: 5px;
        border-width: touch.has-hover && enabled ? 2px : kind == 1 || kind == 2 || kind == 3 || !enabled ? 1px : 0px;
        border-color: touch.has-hover && enabled ? Theme.hover-edge : Theme.edge;
    }
    label := Text {
        text: root.text;
        font-family: Theme.list-font;
        font-size: kind == 3 ? 16px * Theme.ts : root.font-size;
        color: !enabled ? Theme.faint : kind == 0 ? Theme.ink : kind == 4 ? #ffffff : Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// Plus and minus drawn with the cross's 2 px stroke.
export component Sign inherits Path {
    in property <color> colour;
    in property <bool> plus;
    width: 12px;
    height: 12px;
    viewbox-width: 12;
    viewbox-height: 12;
    stroke: colour;
    stroke-width: 2px;
    commands: plus ? "M 0 6 L 12 6 M 6 0 L 6 12" : "M 0 6 L 12 6";
}

// A number with minus and plus beside it. Typing a number works too.
export component Stepper inherits Rectangle {
    in property <int> value;
    in property <int> minimum: 0;
    in property <int> maximum: 255;
    in property <bool> changed;
    in property <length> font-size: 20px * Theme.ts;
    callback set(int);
    // Typing ends `text: value`, so the box is told, or it would keep what was typed.
    changed value => { input.text = root.value; }
    height: 40px;
    min-width: 110px;
    border-radius: 5px;
    border-width: 1px;
    border-color: changed ? Theme.changed : Theme.edge;
    background: Theme.field;
    HorizontalLayout {
        Rectangle {
            width: self.height;
            Sign { colour: value > minimum ? Theme.accent : Theme.faint; }
            TouchArea { mouse-cursor: pointer; clicked => { if (value > minimum) { root.set(value - 1); } } }
        }
        Rectangle {
            input := TextInput {
                text: value;
                font-family: Theme.title-font;
                font-size: root.font-size;
                color: changed ? Theme.changed : Theme.text;
                horizontal-alignment: center;
                vertical-alignment: center;
                input-type: number;
                accepted => {
                    if self.text.is-float() {
                        root.set(Math.clamp(self.text.to-float(), minimum, maximum));
                    }
                    self.text = root.value;
                    self.clear-focus();
                }
                // Clicking anywhere else is Enter too (main.rs takes the focus away).
                changed has-focus => {
                    if !self.has-focus {
                        if self.text.is-float() && self.text.to-float() != root.value {
                            root.set(Math.clamp(self.text.to-float(), minimum, maximum));
                        }
                        self.text = root.value;
                    }
                }
            }
        }
        Rectangle {
            width: self.height;
            Sign { plus: true; colour: value < maximum ? Theme.accent : Theme.faint; }
            TouchArea { mouse-cursor: pointer; clicked => { if (value < maximum) { root.set(value + 1); } } }
        }
    }
}

// A one-line text box in the KMRP field style.
export component Field inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> changed;
    in property <bool> read-only;
    in property <bool> accept-on-blur: true;
    in property <string> font: Theme.list-font;
    in property <length> font-size: 18px * Theme.ts;
    callback edited(string);
    callback accepted(string);
    // The text when the box was entered, so leaving it unchanged does nothing.
    property <string> at-focus;
    public function focus-all() {
        input.focus();
        input.select-all();
    }
    height: 40px;
    border-radius: 5px;
    border-width: 1px;
    border-color: changed ? Theme.changed : input.has-focus ? Theme.accent : Theme.edge;
    background: Theme.field;
    clip: true;
    Text {
        x: 12px;
        visible: input.text == "";
        text: placeholder;
        color: Theme.faint;
        font-family: Theme.body-font;
        font-size: 14px * Theme.ts;
        vertical-alignment: center;
        height: parent.height;
    }
    Rectangle {
        x: 12px;
        width: parent.width - 24px;
        height: parent.height;
        clip: true;
        input := TextInput {
            property <length> scroll-x: 0px;
            x: min(0px, max(parent.width - self.width - self.text-cursor-width, self.scroll-x));
            width: max(parent.width - self.text-cursor-width, self.preferred-width);
            cursor-position-changed(cursor) => {
                if cursor.x + self.scroll-x < 2px {
                    self.scroll-x = -cursor.x + 2px;
                } else if cursor.x + self.scroll-x > parent.width - 2px - self.text-cursor-width {
                    self.scroll-x = parent.width - cursor.x - 2px - self.text-cursor-width;
                }
            }
            height: parent.height;
            text <=> root.text;
            read-only: root.read-only;
            font-family: root.font;
            font-size: root.font-size;
            color: changed ? Theme.changed : Theme.text;
            vertical-alignment: center;
            single-line: true;
            edited => { root.edited(self.text); }
            accepted => {
                root.at-focus = self.text;
                root.accepted(self.text);
            }
            // Clicking anywhere else is Enter too, when the text changed since the box was entered.
            changed has-focus => {
                if self.has-focus {
                    root.at-focus = self.text;
                } else if root.accept-on-blur && self.text != root.at-focus {
                    root.at-focus = self.text;
                    root.accepted(self.text);
                }
            }
        }
    }
}

// On and off, as a small switch.
export component Switch inherits Rectangle {
    in property <bool> on;
    in property <bool> changed;
    in property <bool> enabled: true;
    callback toggled(bool);
    width: 50px;
    height: 26px;
    border-radius: 13px;
    background: !enabled ? Theme.row-line : on ? (changed ? Theme.changed : Theme.accent) : Theme.field;
    border-width: 1px;
    border-color: changed ? Theme.changed : on ? Theme.accent : Theme.edge;
    Rectangle {
        x: on ? parent.width - self.width - 4px : 4px;
        y: 4px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: on ? Theme.ink : Theme.soft;
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.toggled(!on); }
    }
}

// The spaced capital labels over each section ("ATTRIBUTES").
// A note too long for its place: an "i" in a circle, its text in a box of as many lines as it
// needs while the pointer is over it (2026-11-08, the maintainer: the orange line under Heal
// Everyone was cut off). The box opens down and to the left, so a dot at a column's right edge
// keeps it in the column. Put the dot last among its siblings: what comes after it draws over.
export component InfoDot inherits Rectangle {
    in property <string> text;
    in property <length> box-width: 320px;
    in property <brush> tone: Theme.changed;
    width: 22px * Theme.ts;
    height: self.width;
    border-radius: self.width / 2;
    border-width: 1.5px;
    border-color: root.tone;
    background: touch.has-hover ? Theme.hover : transparent;
    Text {
        width: parent.width;
        height: parent.height;
        text: "i";
        horizontal-alignment: center;
        vertical-alignment: center;
        font-family: Theme.body-font;
        font-size: 14px * Theme.ts;
        font-weight: 700;
        color: root.tone;
    }
    touch := TouchArea { }
    if touch.has-hover: Rectangle {
        x: root.width - self.width;
        y: root.height + 6px;
        width: root.box-width;
        height: body.preferred-height + 24px;
        background: Theme.panel;
        border-width: 1px;
        border-color: root.tone;
        border-radius: 6px;
        body := Text {
            x: 12px;
            y: 12px;
            width: parent.width - 24px;
            text: root.text;
            wrap: word-wrap;
            font-family: Theme.body-font;
            font-size: 13.5px * Theme.ts;
            color: Theme.text;
        }
    }
}

export component Label inherits Text {
    font-family: Theme.label-font;
    font-size: 15px * Theme.ts;
    letter-spacing: 4px;
    color: Theme.accent;
    overflow: elide;
}

export component Note inherits Text {
    font-family: Theme.body-font;
    font-size: 13.5px * Theme.ts;
    color: Theme.faint;
    wrap: word-wrap;
}

// A vertical list that scrolls, with a thin cyan bar to show where it is.
export component Scroller inherits Rectangle {
    in property <length> content-height;
    in-out property <length> offset: 0;
    clip: true;
    flick := Flickable {
        width: parent.width - 12px;
        x: 0;
        content-height: max(root.content-height + 24px, self.height);
        content-y <=> root.offset;
        @children
    }
    if content-height > root.height: Rectangle {
        x: parent.width - 5px;
        width: 4px;
        height: max(36px, root.height * root.height / content-height);
        y: (root.height - self.height) * (-root.offset / max(1px, content-height - root.height));
        border-radius: 2px;
        background: Theme.accent;
    }
}

// A change's icon in a story preview: the games' own notification icons traced into outlines
// (2026-11-07, the maintainer: vectors, so they are drawn sharp at any size), one even-odd
// layer per colour on a 32-unit box: the black under everything, the game's colour, white.
// The shapes are KotOR's (XP, credits, level, the journal, an item received or taken; the
// party is KotOR II's), in the open game's colours (Theme.icon-*). Alignment is the dark
// side's icon and the light side's, half each. The other rows show the game's own icons, read from
// the game (main.rs game_icon), not this.
export component ChangeIcon inherits Rectangle {
    in property <string> kind;
    width: 30px;
    height: self.width;
    if root.kind == "xp": Path {
        width: root.width; height: root.height;
        viewbox-width: 32; viewbox-height: 32;
        fill: #000000;
        fill-rule: evenodd;
        commands: "M 16 32 L 11.21 32 L 11.15 31.8 C 11.11 31.66 11.04 31.58 10.94 31.55 C 10.85 31.52 10.56 31.49 10.29 31.46 C 9.85 31.43 9.78 31.41 9.56 31.21 C 9.39 31.05 9.27 31 9.11 31 C 8.98 31 8.81 30.97 8.73 30.94 C 8.65 30.91 8.51 30.81 8.42 30.72 C 8.32 30.63 8.15 30.55 8 30.52 C 7.81 30.49 7.67 30.41 7.51 30.25 C 7.34 30.08 7.2 30 7.01 29.97 C 6.82 29.94 6.71 29.87 6.61 29.75 C 6.54 29.65 6.4 29.54 6.3 29.5 C 6.2 29.45 6.08 29.34 6.03 29.25 C 5.98 29.15 5.85 29.04 5.74 29.01 C 5.63 28.97 5.46 28.86 5.35 28.76 C 5.24 28.66 4.78 28.2 4.31 27.74 C 3.85 27.28 3.39 26.8 3.29 26.68 C 3.19 26.57 3.06 26.37 2.99 26.24 C 2.93 26.11 2.82 25.99 2.75 25.97 C 2.68 25.95 2.58 25.84 2.52 25.73 C 2.47 25.62 2.34 25.47 2.25 25.39 C 2.13 25.29 2.06 25.17 2.03 24.99 C 2 24.8 1.92 24.66 1.75 24.49 C 1.59 24.33 1.51 24.19 1.48 24.01 C 1.45 23.85 1.36 23.66 1.24 23.53 C 1.09 23.36 1.04 23.23 1.01 22.98 C 0.99 22.73 0.94 22.61 0.8 22.46 C 0.67 22.32 0.59 22.16 0.56 21.96 C 0.53 21.79 0.51 21.53 0.5 21.37 C 0.5 21.17 0.46 21.04 0.37 20.95 C 0.3 20.87 0.19 20.81 0.12 20.81 C 0 20.81 0 20.74 0 16 C 0 11.26 0 11.19 0.12 11.19 C 0.19 11.19 0.3 11.13 0.37 11.05 C 0.46 10.96 0.5 10.83 0.5 10.63 C 0.51 10.47 0.53 10.21 0.56 10.04 C 0.59 9.84 0.67 9.68 0.8 9.54 C 0.94 9.39 0.99 9.27 1.01 9.02 C 1.04 8.77 1.09 8.64 1.24 8.47 C 1.36 8.34 1.45 8.15 1.48 7.99 C 1.51 7.81 1.59 7.67 1.75 7.51 C 1.92 7.34 2 7.2 2.03 7.01 C 2.06 6.83 2.13 6.71 2.25 6.61 C 2.34 6.53 2.47 6.38 2.52 6.27 C 2.58 6.16 2.68 6.05 2.75 6.03 C 2.82 6.01 2.93 5.89 2.99 5.76 C 3.06 5.63 3.19 5.43 3.29 5.32 C 3.39 5.2 3.85 4.72 4.31 4.26 C 4.78 3.8 5.24 3.34 5.35 3.24 C 5.46 3.14 5.63 3.03 5.74 2.99 C 5.85 2.96 5.98 2.85 6.03 2.75 C 6.08 2.66 6.2 2.55 6.3 2.5 C 6.4 2.46 6.54 2.35 6.61 2.25 C 6.71 2.13 6.82 2.06 7.01 2.03 C 7.2 2 7.34 1.92 7.51 1.75 C 7.67 1.59 7.81 1.51 8 1.48 C 8.15 1.45 8.32 1.37 8.42 1.28 C 8.51 1.19 8.65 1.09 8.73 1.06 C 8.81 1.03 8.98 1 9.11 1 C 9.27 1 9.39 0.95 9.56 0.79 C 9.78 0.59 9.85 0.57 10.29 0.54 C 10.56 0.51 10.85 0.48 10.94 0.45 C 11.04 0.42 11.11 0.34 11.15 0.2 L 11.21 0 L 16 0 L 20.79 0 L 20.85 0.2 C 20.89 0.34 20.96 0.42 21.06 0.45 C 21.15 0.48 21.44 0.51 21.71 0.54 C 22.15 0.57 22.22 0.59 22.44 0.79 C 22.61 0.95 22.73 1 22.89 1 C 23.02 1 23.19 1.03 23.27 1.06 C 23.35 1.09 23.49 1.19 23.58 1.28 C 23.68 1.37 23.85 1.45 24 1.48 C 24.19 1.51 24.33 1.59 24.49 1.75 C 24.66 1.92 24.8 2 24.99 2.03 C 25.18 2.06 25.29 2.13 25.39 2.25 C 25.46 2.35 25.6 2.46 25.69 2.5 C 25.79 2.54 25.93 2.67 26 2.79 C 26.07 2.92 26.17 3 26.25 3 C 26.32 3 26.49 3.11 26.64 3.23 C 26.78 3.36 27.27 3.84 27.71 4.29 C 28.16 4.73 28.61 5.2 28.71 5.32 C 28.81 5.43 28.94 5.63 29.01 5.76 C 29.07 5.89 29.18 6.01 29.25 6.03 C 29.32 6.05 29.42 6.16 29.48 6.27 C 29.53 6.38 29.66 6.53 29.75 6.61 C 29.87 6.71 29.94 6.83 29.97 7.01 C 30 7.2 30.08 7.34 30.25 7.51 C 30.41 7.67 30.49 7.81 30.52 7.99 C 30.55 8.15 30.64 8.34 30.76 8.47 C 30.91 8.64 30.96 8.77 30.99 9.02 C 31.01 9.27 31.06 9.39 31.2 9.54 C 31.33 9.68 31.41 9.84 31.44 10.04 C 31.47 10.21 31.49 10.47 31.5 10.63 C 31.5 10.83 31.54 10.96 31.63 11.05 C 31.7 11.13 31.81 11.19 31.88 11.19 C 32 11.19 32 11.26 32 16 C 32 20.74 32 20.81 31.88 20.81 C 31.81 20.81 31.7 20.87 31.63 20.95 C 31.54 21.04 31.5 21.17 31.5 21.37 C 31.49 21.53 31.47 21.79 31.44 21.96 C 31.41 22.16 31.33 22.32 31.2 22.46 C 31.06 22.61 31.01 22.73 30.99 22.98 C 30.96 23.23 30.91 23.36 30.76 23.53 C 30.64 23.66 30.55 23.85 30.52 24.01 C 30.49 24.19 30.41 24.33 30.25 24.49 C 30.08 24.66 30 24.8 29.97 24.99 C 29.94 25.17 29.87 25.29 29.75 25.39 C 29.66 25.47 29.53 25.62 29.48 25.73 C 29.42 25.84 29.32 25.95 29.25 25.97 C 29.18 25.99 29.07 26.11 29.01 26.24 C 28.94 26.37 28.81 26.57 28.71 26.68 C 28.61 26.8 28.15 27.28 27.69 27.74 C 27.22 28.2 26.76 28.66 26.65 28.76 C 26.54 28.86 26.37 28.97 26.26 29.01 C 26.15 29.04 26.02 29.15 25.97 29.25 C 25.92 29.34 25.8 29.45 25.7 29.5 C 25.6 29.54 25.46 29.65 25.39 29.75 C 25.29 29.87 25.18 29.94 24.99 29.97 C 24.8 30 24.66 30.08 24.49 30.25 C 24.33 30.41 24.19 30.49 24 30.52 C 23.85 30.55 23.68 30.63 23.58 30.72 C 23.49 30.81 23.35 30.91 23.27 30.94 C 23.19 30.97 23.02 31 22.89 31 C 22.73 31 22.61 31.05 22.44 31.21 C 22.22 31.41 22.15 31.43 21.71 31.46 C 21.44 31.49 21.15 31.52 21.06 31.55 C 20.96 31.58 20.89 31.66 20.85 31.8 L 20.79 32 L 16 32 Z";
    }
    if root.kind == "xp": Path {
        width: root.width; height: root.height;
        viewbox-width: 32; viewbox-height: 32;
