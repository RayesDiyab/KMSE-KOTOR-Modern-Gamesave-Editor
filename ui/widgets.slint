// The moon and the sun of the Appearance choice in Settings.
export component Moon inherits Path {
    in property <color> colour;
    width: 20px;
    height: 20px;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: colour;
    commands: "M 15.5 3 A 9.5 9.5 0 1 0 21 17.5 A 7.5 7.5 0 1 1 15.5 3 Z";
}

export component Sun inherits Path {
    in property <color> colour;
    width: 22px;
    height: 22px;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: colour;
    stroke-width: 2px;
    fill: colour;
    commands: "M 12 7.5 A 4.5 4.5 0 1 0 12 16.5 A 4.5 4.5 0 1 0 12 7.5 Z M 12 1.5 L 12 4 M 12 20 L 12 22.5 M 1.5 12 L 4 12 M 20 12 L 22.5 12 M 4.6 4.6 L 6.4 6.4 M 17.6 17.6 L 19.4 19.4 M 4.6 19.4 L 6.4 17.6 M 17.6 6.4 L 19.4 4.6";
}

// The settings button: the KMRP installer's gear (src/patcher/icons/Settings.png, 2000 px,
// cropped square around the gear, made white and area-averaged to the 32 px it is drawn at in
// assets/settings.png: a 64 px picture halved at run time came out hard-edged, 2026-10-24),
// square, the game switch's height.
export component SettingsButton inherits Rectangle {
    callback clicked;
    width: 50px;
    height: 50px;
    border-radius: 6px;
    border-width: touch.has-hover ? 2px : 1px;
    border-color: touch.has-hover ? Theme.hover-edge : Theme.edge;
    background: touch.has-hover ? Theme.hover : Theme.field;
    Image {
        source: @image-url("../assets/settings.png");
        width: 32px;
        height: 32px;
        colorize: touch.has-hover ? Theme.accent : Theme.soft;
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// The copy button, the settings button's twin: two pages, the back one behind the front
// (the maintainer's icon, 2026-10-24), drawn as lines so it stays smooth at any size.
export component CopyButton inherits Rectangle {
    callback clicked;
    // the line drawing, 24 units: two pages by default; History's clock with its arrow
    // turning back passes its own
    in property <string> icon: "M 6.6 7 L 11.3 7 L 15.2 10.9 L 15.2 18.5 A 1.6 1.6 0 0 1 13.6 20.1 L 6.6 20.1 A 1.6 1.6 0 0 1 5 18.5 L 5 8.6 A 1.6 1.6 0 0 1 6.6 7 Z M 11.3 7 L 11.3 10.9 L 15.2 10.9 M 8.9 6.6 L 8.9 4.6 A 1.6 1.6 0 0 1 10.5 3 L 15.5 3 L 19.3 6.8 L 19.3 14.7 A 1.6 1.6 0 0 1 17.7 16.3 L 16.6 16.3 M 15.5 3 L 15.5 6.8 L 19.3 6.8";
    width: 50px;
    height: 50px;
    border-radius: 6px;
    border-width: touch.has-hover ? 2px : 1px;
    border-color: touch.has-hover ? Theme.hover-edge : Theme.edge;
    background: touch.has-hover ? Theme.hover : Theme.field;
    Path {
        width: 30px;
        height: 30px;
        viewbox-width: 24;
        viewbox-height: 24;
        stroke: touch.has-hover ? Theme.accent : Theme.soft;
        stroke-width: 1.8px;
        stroke-line-cap: round;
        commands: root.icon;
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// A small square button with a line icon (a 24-unit path), and words after it when given:
// the saves page's pen, save and Copy (2026-10-24, the maintainer).
export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    in property <bool> lit;
    // the icon's size: larger where the button has no words beside it
    in property <length> icon-size: 22px;
    callback clicked;
    height: 44px;
    // as wide as the icon and words need, whatever the layout around it has to spare
    width: root.text == "" ? self.height : 16px + 22px + 10px + measure.preferred-width + 18px;
    border-radius: 6px;
    border-width: touch.has-hover ? 2px : 1px;
    border-color: touch.has-hover ? Theme.hover-edge : lit ? Theme.accent : Theme.edge;
    background: touch.has-hover ? Theme.hover : Theme.field;
    // the words' width, measured apart from the layout
    measure := Text { visible: false; text: root.text; font-family: Theme.list-font; font-size: 18px * Theme.ts; }
    // the icon alone: placed in the middle itself (2026-11-06, the maintainer: in a layout with
    // an empty label beside it the save button's disk sat 6 px left of centre)
    if root.text == "": Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.icon-size;
        height: root.icon-size;
        viewbox-width: 24;
        viewbox-height: 24;
        stroke: touch.has-hover || lit ? Theme.accent : Theme.soft;
        stroke-width: 1.8px;
        stroke-line-cap: round;
        commands: root.icon;
    }
    if root.text != "": HorizontalLayout {
        padding-left: 16px;
        padding-right: 18px;
        spacing: 10px;
        alignment: center;
        VerticalLayout {
            alignment: center;
            Path {
                width: root.icon-size;
                height: root.icon-size;
                viewbox-width: 24;
                viewbox-height: 24;
                stroke: touch.has-hover || lit ? Theme.accent : Theme.soft;
                stroke-width: 1.8px;
                stroke-line-cap: round;
                commands: root.icon;
            }
        }
        Text {
            text: root.text;
            font-family: Theme.list-font;
            font-size: 18px * Theme.ts;
            color: Theme.text;
            vertical-alignment: center;
        }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// A few choices side by side, the picked one filled: the game switch's look.
// icons: 1 puts the moon before the first choice and the sun before the second.
export component Choice inherits Rectangle {
    in property <[string]> options;
    in property <int> current;
    in property <int> icons: 0;
    in property <length> font-size: 18px * Theme.ts;
    callback picked(int);
    height: 46px;
    // The outline is drawn last, over the choices: under them the picked one's fill hid it,
    // and each choice rounded all four corners inside its square cell, so the fill showed
    // notches where two met and the corners did not match what a click reaches (2026-11-06,
    // the maintainer: "the edges of the button seem invisible ... the actual edge might be
    // rounded but the clickable button is square"). Now only the outer corners are round.
    property <length> r: 6px;
    HorizontalLayout {
        for o[i] in options: Rectangle {
            property <bool> on: i == current;
            property <bool> first: i == 0;
            property <bool> last: i == options.length - 1;
            width: root.width / options.length;
            background: on ? transparent : ct.has-hover ? Theme.hover : Theme.field;
            // the fill inside the outline, its corners one pixel tighter: on the outline's own
            // arc the two smoothed edges mixed into a fuzzy grey rim (2026-11-07, the maintainer)
            if on: RoundFill {
                x: parent.first ? 1px : 0px;
                y: 1px;
                width: parent.width - (parent.first ? 1px : 0px) - (parent.last ? 1px : 0px);
                height: parent.height - 2px;
                from: Theme.fill-top;
                to: Theme.fill-bottom;
                r: root.r - 1px;
                r-tl: parent.first ? root.r - 1px : 0px;
                r-bl: parent.first ? root.r - 1px : 0px;
                r-tr: parent.last ? root.r - 1px : 0px;
                r-br: parent.last ? root.r - 1px : 0px;
            }
            border-width: ct.has-hover && !on ? 2px : 0px;
            border-color: Theme.hover-edge;
            border-top-left-radius: self.first ? root.r : 0px;
            border-bottom-left-radius: self.first ? root.r : 0px;
            border-top-right-radius: self.last ? root.r : 0px;
            border-bottom-right-radius: self.last ? root.r : 0px;
            if i > 0: Rectangle { x: 0; width: 1px; background: Theme.edge; }
            HorizontalLayout {
                alignment: center;
                spacing: 10px;
                if icons == 1 && i == 0: VerticalLayout { alignment: center; Moon { colour: on ? Theme.ink : Theme.gold; } }
                if icons == 1 && i == 1: VerticalLayout { alignment: center; Sun { colour: on ? Theme.ink : Theme.gold; } }
                Text { text: o; vertical-alignment: center; font-family: Theme.list-font; font-size: root.font-size; color: on ? Theme.ink : Theme.soft; }
            }
            ct := TouchArea { mouse-cursor: pointer; clicked => { root.picked(i); } }
        }
    }
    // the outline, over the choices
    Rectangle {
        border-radius: root.r;
        border-width: 1px;
        border-color: Theme.edge;
    }
}

// The crest (the sigil over KMSE, made like KMRP's: tools/build_brand_image.py in KMRP with
// assets/sigil.png, --text KMSE --tracking 0.12 --whole-crest, then area-averaged to the 142x110
// it is drawn at: shrunk at run time instead, the renderer left the sigil's edges hard) and the
// program's name (2026-10-24, the maintainer); with a save open, only "Gamesave Editor".
export component Brand inherits HorizontalLayout {
    in property <bool> short;
    // the name beside the crest, left out where the buttons on the right need its room
    in property <bool> named: true;
    spacing: 30px;
    alignment: start;
    Image {
        source: @image-url("../assets/kmse-logo.png");
        height: 110px;
        width: 142px;
        image-fit: contain;
    }
    if root.named: Text {
        text: root.short ? "Gamesave Editor" : "KOTOR Modern Gamesave Editor";
        font-family: Theme.title-font;
        font-size: 40px;
        color: Theme.text;
        vertical-alignment: center;
        letter-spacing: 1px;
    }
}

// A link-like text button for the footer.
export component Link inherits Text {
    callback clicked;
    font-family: Theme.body-font;
    font-size: 15px * Theme.ts;
    color: touch.has-hover ? Theme.text : Theme.accent;
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// A drawn cross (the KMRP fonts have no multiplication sign).
export component Cross inherits Path {
    in property <color> colour;
    width: 12px;
    height: 12px;
    viewbox-width: 12;
    viewbox-height: 12;
    stroke: colour;
    stroke-width: 2px;
    commands: "M 1 1 L 11 11 M 11 1 L 1 11";
}

// A large arrow pointing left: back to the list of saves.
export component BackArrow inherits Rectangle {
    callback clicked;
    width: 64px;
    height: 64px;
    border-radius: 32px;
    border-width: 2px;
    border-color: touch.has-hover ? Theme.hover-edge : Theme.edge;
    background: touch.has-hover ? Theme.hover : Theme.field;
    Path {
        width: 28px;
        height: 28px;
        viewbox-width: 28;
        viewbox-height: 28;
        stroke: touch.has-hover ? Theme.text : Theme.accent;
        stroke-width: 3px;
        commands: "M 25 14 L 4 14 M 13 4 L 3 14 L 13 24";
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}


// Story rewind's alignment target. The pointer updates the value while dragging;
// only release prepares a new story result. Keyboard and numeric input commit directly.
export component AlignmentChoice inherits Rectangle {
    in property <int> value: 50;
    callback set(int);
    callback committed();
    changed value => { number.text = root.value; }
    property <bool> narrow: self.width < 720px;
    height: narrow ? 152px : 110px;
    property <string> side: value == 50 ? "Neutral" : value < 50 ? "Dark side" : "Light side";
    VerticalLayout {
        x: 0px; y: 0px;
        width: root.narrow ? parent.width : parent.width - 350px;
        height: 40px;
        Label { text: "ALIGNMENT AFTER GOING BACK"; font-size: 11px * Theme.ts; letter-spacing: 1px; }
        Note { text: "Starts at 50 (Neutral). Adjust before applying."; font-size: 12px * Theme.ts; }
    }
    HorizontalLayout {
        x: root.narrow ? 0px : parent.width - 330px;
        y: root.narrow ? 44px : 0px;
        width: 330px;
        height: 40px;
        spacing: 12px;
        number := Field {
            width: 70px;
            text: root.value;
            font-size: 16px * Theme.ts;
            accepted(v) => {
                if v.is-float() { root.set(Math.round(Math.clamp(v.to-float(), 0, 100))); }
                self.text = root.value;
                root.committed();
            }
        }
        Text { width: 80px; text: root.side; color: Theme.text; font-size: 13px * Theme.ts; vertical-alignment: center; }
        Link { text: "Reset to Neutral"; clicked => { root.set(50); root.committed(); } }
    }
    slider := FocusScope {
        x: 10px; y: root.narrow ? 90px : 48px; width: parent.width - 20px; height: 34px;
        key-pressed(e) => {
            if e.text == Key.LeftArrow || e.text == Key.DownArrow { root.set(max(0, root.value - 1)); root.committed(); return accept; }
            if e.text == Key.RightArrow || e.text == Key.UpArrow { root.set(min(100, root.value + 1)); root.committed(); return accept; }
            if e.text == Key.Home { root.set(0); root.committed(); return accept; }
            if e.text == Key.End { root.set(100); root.committed(); return accept; }
            reject
        }
        RoundFill {
            y: 14px; height: 7px; r: 3.5px; across: true;
            from: #ff405d33; mid: #c6d5e322; to: #20d8ff33; has-mid: true;
        }
        RoundFill {
            y: 16px; height: 3px; r: 1.5px; across: true;
            from: #ff405d; mid: #d2dae5; to: #20d8ff; has-mid: true;
        }
        Rectangle {
            x: parent.width * root.value / 100 - 10px; y: 7px; width: 20px; height: 20px;
            border-radius: 10px; border-width: 2px;
            border-color: slider.has-focus || touch.has-hover ? Theme.hover-edge : #91dfff;
            background: Theme.field;
            Rectangle { width: 5px; height: 5px; border-radius: 3px; background: Theme.text; }
        }
        touch := TouchArea {
            mouse-cursor: pointer;
            pointer-event(e) => {
                if e.kind == PointerEventKind.down {
                    slider.focus();
                    root.set(Math.round(Math.clamp(self.mouse-x / self.width * 100, 0, 100)));
                }
                if e.kind == PointerEventKind.up { root.committed(); }
            }
            moved => {
                if self.pressed { root.set(Math.round(Math.clamp(self.mouse-x / self.width * 100, 0, 100))); }
            }
        }
    }
    HorizontalLayout {
        y: root.narrow ? 126px : 84px; height: 20px;
        Note { text: "0 · Dark"; font-size: 11px * Theme.ts; }
        Text { text: "50 · Neutral"; font-size: 11px * Theme.ts; color: Theme.muted; horizontal-alignment: center; }
        Text { text: "100 · Light"; font-size: 11px * Theme.ts; color: Theme.muted; horizontal-alignment: right; }
    }
}

