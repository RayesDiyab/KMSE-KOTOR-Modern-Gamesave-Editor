// The controls, drawn in the KMRP style rather than taken from a widget toolkit, so they
// look the same on Windows, Linux and macOS. Nothing animates.

import { Theme } from "theme.slint";

// kind: 0 cyan fill (the main action), 1 outline, 2 grey fill (Revert), 3 small outline,
// 4 red fill (taking something out of the save)
// A rounded fill with a gradient. The software renderer rounds only a solid fill: a gradient
// one kept square corners, so every filled button showed square corners inside its rounded edge
// (2026-11-07, the maintainer: Finish Quest's corners). So the corners are drawn as solid caps in
// the gradient's end colours, and only the straight middle carries the gradient; the pieces meet
// without overlapping, so a see-through fill is not doubled where they meet. `across` runs the
// gradient left to right, `mid` adds a middle stop.
export component RoundFill inherits Rectangle {
    in property <color> from;
    in property <color> to;
    in property <color> mid;
    in property <bool> has-mid;
    in property <bool> across;
    in property <length> r: 5px;
    in property <length> r-tl: r;
    in property <length> r-tr: r;
    in property <length> r-bl: r;
    in property <length> r-br: r;
    property <length> cap: max(r-tl, r-tr, r-bl, r-br);
    if !across: Rectangle {
        y: 0; height: root.cap;
        background: root.from;
        border-top-left-radius: root.r-tl;
        border-top-right-radius: root.r-tr;
    }
    if !across: Rectangle {
        y: root.cap; height: root.height - 2 * root.cap;
        background: root.has-mid ? @linear-gradient(180deg, root.from 0%, root.mid 50%, root.to 100%) : @linear-gradient(180deg, root.from 0%, root.to 100%);
    }
    if !across: Rectangle {
        y: root.height - root.cap; height: root.cap;
        background: root.to;
        border-bottom-left-radius: root.r-bl;
        border-bottom-right-radius: root.r-br;
    }
    if across: Rectangle {
        x: 0; width: root.cap;
        background: root.from;
        border-top-left-radius: root.r-tl;
        border-bottom-left-radius: root.r-bl;
    }
    if across: Rectangle {
        x: root.cap; width: root.width - 2 * root.cap;
        background: root.has-mid ? @linear-gradient(90deg, root.from 0%, root.mid 50%, root.to 100%) : @linear-gradient(90deg, root.from 0%, root.to 100%);
    }
    if across: Rectangle {
        x: root.width - root.cap; width: root.cap;
        background: root.to;
        border-top-right-radius: root.r-tr;
        border-bottom-right-radius: root.r-br;
    }
}

export component Button inherits Rectangle {
    in property <string> text;
    in property <int> kind: 1;
    in property <bool> enabled: true;
    in property <length> font-size: 20px * Theme.ts;
    // A row-sized button of any kind (the map's rail).
    in property <bool> compact;
    callback clicked;
    min-height: kind == 3 || compact ? 38px : 50px;
    min-width: label.preferred-width + (kind == 3 ? 32px : 48px);
    border-radius: 5px;
    property <bool> graded: enabled && (kind == 0 || kind == 2);
    background: !enabled ? (kind == 0 ? Theme.selected : Theme.field)
        : graded ? transparent
        : kind == 4 ? (touch.has-hover ? Theme.danger.brighter(0.15) : Theme.danger)
        : (touch.has-hover ? Theme.hover : Theme.field);
    // the filled kinds' gradient, with its corners rounded as the edge is
    // (the grey one, which has an edge, inside it, so the two arcs do not mix into a fuzzy rim)
    property <length> inset: kind == 2 ? 1px : 0px;
    if graded: RoundFill {
        x: root.inset; y: root.inset;
        width: root.width - 2 * root.inset;
        height: root.height - 2 * root.inset;
        r: 5px - root.inset;
        from: kind == 0 ? (touch.has-hover ? Theme.fill-hover : Theme.fill-top) : Theme.grey-top;
        to: kind == 0 ? Theme.fill-bottom : Theme.grey-bottom;
    }
    // the edge, over the fill: an edge at rest on every kind but the filled ones, whose fill is
    // their edge (Revert's grey and a greyed-out Save Changes had none, 2026-11-06)
    Rectangle {
        border-radius: 5px;
        border-width: touch.has-hover && enabled ? 2px : kind == 1 || kind == 2 || kind == 3 || !enabled ? 1px : 0px;
        border-color: touch.has-hover && enabled ? Theme.hover-edge : Theme.edge;
    }
    label := Text {
        text: root.text;
        font-family: Theme.list-font;
        font-size: kind == 3 ? 16px * Theme.ts : root.font-size;
        color: !enabled ? Theme.faint : kind == 0 ? Theme.ink : kind == 4 ? #ffffff : Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// Plus and minus drawn with the cross's 2 px stroke.
export component Sign inherits Path {
    in property <color> colour;
    in property <bool> plus;
    width: 12px;
    height: 12px;
    viewbox-width: 12;
    viewbox-height: 12;
    stroke: colour;
    stroke-width: 2px;
    commands: plus ? "M 0 6 L 12 6 M 6 0 L 6 12" : "M 0 6 L 12 6";
}

// A number with minus and plus beside it. Typing a number works too.
export component Stepper inherits Rectangle {
    in property <int> value;
    in property <int> minimum: 0;
    in property <int> maximum: 255;
    in property <bool> changed;
    in property <length> font-size: 20px * Theme.ts;
    callback set(int);
    // Typing ends `text: value`, so the box is told, or it would keep what was typed.
    changed value => { input.text = root.value; }
    height: 40px;
    min-width: 110px;
    border-radius: 5px;
    border-width: 1px;
    border-color: changed ? Theme.changed : Theme.edge;
    background: Theme.field;
    HorizontalLayout {
        Rectangle {
            width: self.height;
            Sign { colour: value > minimum ? Theme.accent : Theme.faint; }
            TouchArea { mouse-cursor: pointer; clicked => { if (value > minimum) { root.set(value - 1); } } }
        }
        Rectangle {
            input := TextInput {
                text: value;
                font-family: Theme.title-font;
                font-size: root.font-size;
                color: changed ? Theme.changed : Theme.text;
                horizontal-alignment: center;
                vertical-alignment: center;
                input-type: number;
                accepted => {
                    if self.text.is-float() {
                        root.set(Math.clamp(self.text.to-float(), minimum, maximum));
                    }
                    self.text = root.value;
                    self.clear-focus();
                }
                // Clicking anywhere else is Enter too (main.rs takes the focus away).
                changed has-focus => {
                    if !self.has-focus {
                        if self.text.is-float() && self.text.to-float() != root.value {
                            root.set(Math.clamp(self.text.to-float(), minimum, maximum));
                        }
                        self.text = root.value;
                    }
                }
            }
        }
        Rectangle {
            width: self.height;
            Sign { plus: true; colour: value < maximum ? Theme.accent : Theme.faint; }
            TouchArea { mouse-cursor: pointer; clicked => { if (value < maximum) { root.set(value + 1); } } }
        }
    }
}

// A one-line text box in the KMRP field style.
export component Field inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> changed;
    in property <bool> read-only;
    in property <bool> accept-on-blur: true;
    in property <string> font: Theme.list-font;
    in property <length> font-size: 18px * Theme.ts;
    callback edited(string);
    callback accepted(string);
    // The text when the box was entered, so leaving it unchanged does nothing.
    property <string> at-focus;
    public function focus-all() {
        input.focus();
        input.select-all();
    }
    height: 40px;
    border-radius: 5px;
    border-width: 1px;
    border-color: changed ? Theme.changed : input.has-focus ? Theme.accent : Theme.edge;
    background: Theme.field;
    clip: true;
    Text {
        x: 12px;
        visible: input.text == "";
        text: placeholder;
        color: Theme.faint;
        font-family: Theme.body-font;
        font-size: 14px * Theme.ts;
        vertical-alignment: center;
        height: parent.height;
    }
    Rectangle {
        x: 12px;
        width: parent.width - 24px;
        height: parent.height;
        clip: true;
        input := TextInput {
            property <length> scroll-x: 0px;
            x: min(0px, max(parent.width - self.width - self.text-cursor-width, self.scroll-x));
            width: max(parent.width - self.text-cursor-width, self.preferred-width);
            cursor-position-changed(cursor) => {
                if cursor.x + self.scroll-x < 2px {
                    self.scroll-x = -cursor.x + 2px;
                } else if cursor.x + self.scroll-x > parent.width - 2px - self.text-cursor-width {
                    self.scroll-x = parent.width - cursor.x - 2px - self.text-cursor-width;
                }
            }
            height: parent.height;
            text <=> root.text;
            read-only: root.read-only;
            font-family: root.font;
            font-size: root.font-size;
            color: changed ? Theme.changed : Theme.text;
            vertical-alignment: center;
            single-line: true;
            edited => { root.edited(self.text); }
            accepted => {
                root.at-focus = self.text;
                root.accepted(self.text);
            }
            // Clicking anywhere else is Enter too, when the text changed since the box was entered.
            changed has-focus => {
                if self.has-focus {
                    root.at-focus = self.text;
                } else if root.accept-on-blur && self.text != root.at-focus {
                    root.at-focus = self.text;
                    root.accepted(self.text);
                }
            }
        }
    }
}

// On and off, as a small switch.
export component Switch inherits Rectangle {
    in property <bool> on;
    in property <bool> changed;
    in property <bool> enabled: true;
    callback toggled(bool);
    width: 50px;
    height: 26px;
    border-radius: 13px;
    background: !enabled ? Theme.row-line : on ? (changed ? Theme.changed : Theme.accent) : Theme.field;
    border-width: 1px;
    border-color: changed ? Theme.changed : on ? Theme.accent : Theme.edge;
    Rectangle {
        x: on ? parent.width - self.width - 4px : 4px;
        y: 4px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: on ? Theme.ink : Theme.soft;
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.toggled(!on); }
    }
}

// The spaced capital labels over each section ("ATTRIBUTES").
export component Label inherits Text {
    font-family: Theme.label-font;
    font-size: 15px * Theme.ts;
    letter-spacing: 4px;
    color: Theme.accent;
    overflow: elide;
}

export component Note inherits Text {
    font-family: Theme.body-font;
    font-size: 13.5px * Theme.ts;
    color: Theme.faint;
    wrap: word-wrap;
}

// A vertical list that scrolls, with a thin cyan bar to show where it is.
export component Scroller inherits Rectangle {
    in property <length> content-height;
    in-out property <length> offset: 0;
    clip: true;
    flick := Flickable {
        width: parent.width - 12px;
        x: 0;
        content-height: max(root.content-height + 24px, self.height);
        content-y <=> root.offset;
        @children
    }
    if content-height > root.height: Rectangle {
        x: parent.width - 5px;
        width: 4px;
        height: max(36px, root.height * root.height / content-height);
        y: (root.height - self.height) * (-root.offset / max(1px, content-height - root.height));
        border-radius: 2px;
        background: Theme.accent;
    }
}

// A change's icon in a story preview, drawn by the program after the games' own notification
// icons (2026-11-07, the maintainer: "draw them ourselves"), in the open game's colours: xp,
// credits, level, party, align (half dark side, half light side), quest, gain, loss. Any size;
// everything scales with the width.
export component ChangeIcon inherits Rectangle {
    in property <string> kind;
    width: 30px;
    height: self.width;
    property <float> u: self.width / 32px;
    property <bool> ringed: kind == "xp" || kind == "credits" || kind == "quest" || kind == "gain" || kind == "loss";
    property <color> c: kind == "credits" || kind == "quest" ? Theme.icon-green : kind == "loss" ? Theme.icon-red : Theme.icon-blue;
    // a ring on black, as the game's round icons are
    if ringed: Rectangle {
        x: 1px * root.u; y: 1px * root.u;
        width: 30px * root.u; height: self.width;
        border-radius: self.width / 2;
        border-width: 2.6px * root.u;
        border-color: root.c;
        background: #000000;
    }
    // XP in bold strokes (the font's letters came out thin, and a text stroke hollow)
    if kind == "xp": Path {
        width: root.width; height: root.height;
        viewbox-width: 32; viewbox-height: 32;
        stroke: root.c; stroke-width: 3.2px * root.u;
        commands: "M 6.5 10.5 L 14 21.5 M 14 10.5 L 6.5 21.5 M 18 22 L 18 10.5 L 22 10.5 Q 26 10.5 26 14 Q 26 17.5 22 17.5 L 18 17.5";
    }
    // the credit sign: two uprights crossed by a bar, and a stroke turning down from it
    if kind == "credits": Path {
        width: root.width; height: root.height;
        viewbox-width: 32; viewbox-height: 32;
        stroke: root.c; stroke-width: 2.6px * root.u;
        commands: "M 10 8.5 L 10 17 M 14 8.5 L 14 17 M 7.5 12.5 L 16.5 12.5 M 12.5 9.5 L 24.5 9.5 L 16 24";
    }
    // the journal: an open book
    if kind == "quest": Path {
        width: root.width; height: root.height;
        viewbox-width: 32; viewbox-height: 32;
        fill: root.c;
        commands: "M 8.5 10 L 15.3 12 L 15.3 23.5 L 8.5 21.5 Z M 16.7 12 L 23.5 10 L 23.5 21.5 L 16.7 23.5 Z";
    }
    if kind == "gain" || kind == "loss": Path {
        width: root.width; height: root.height;
        viewbox-width: 32; viewbox-height: 32;
        stroke: root.c; stroke-width: 3px * root.u;
        commands: kind == "gain" ? "M 10 16 L 22 16 M 16 10 L 16 22" : "M 10 16 L 22 16";
    }
    // level: an arrow up into an L
    if kind == "level": Path {
        width: root.width; height: root.height;
        viewbox-width: 32; viewbox-height: 32;
        fill: Theme.icon-level;
        stroke: #000000; stroke-width: 1px * root.u;
        commands: "M 16 2 L 23.5 10 L 19.5 10 L 19.5 23 L 26 23 L 26 29.5 L 12.5 29.5 L 12.5 10 L 8.5 10 Z";
    }
    // the party: two behind, one in front, the front one edged so the three stay apart
    if kind == "party": Path {
        width: root.width; height: root.height;
        viewbox-width: 32; viewbox-height: 32;
        fill: Theme.icon-party;
        commands: "M 5.5 11.5 A 3.6 3.6 0 1 1 12.7 11.5 A 3.6 3.6 0 1 1 5.5 11.5 Z M 19.3 11.5 A 3.6 3.6 0 1 1 26.5 11.5 A 3.6 3.6 0 1 1 19.3 11.5 Z M 1.5 25 Q 1.5 17 9.1 17 Q 16.7 17 16.7 25 Z M 15.3 25 Q 15.3 17 22.9 17 Q 30.5 17 30.5 25 Z";
    }
    if kind == "party": Path {
        width: root.width; height: root.height;
        viewbox-width: 32; viewbox-height: 32;
        fill: Theme.icon-party;
        stroke: #000000; stroke-width: 1.4px * root.u;
        commands: "M 11.2 10.5 A 4.8 4.8 0 1 1 20.8 10.5 A 4.8 4.8 0 1 1 11.2 10.5 Z M 6.5 29.5 Q 6.5 18.5 16 18.5 Q 25.5 18.5 25.5 29.5 Z";
    }
    // alignment: the dark side's half on the left, the light side's on the right, one figure
    if kind == "align": Path {
        width: root.width; height: root.height;
        viewbox-width: 32; viewbox-height: 32;
        fill: Theme.icon-red;
        commands: "M 16 1.5 A 14.5 14.5 0 0 0 16 30.5 Z";
    }
    if kind == "align": Path {
        width: root.width; height: root.height;
        viewbox-width: 32; viewbox-height: 32;
        fill: Theme.icon-blue;
        commands: "M 16 1.5 A 14.5 14.5 0 0 1 16 30.5 Z";
    }
    if kind == "align": Path {
        width: root.width; height: root.height;
        viewbox-width: 32; viewbox-height: 32;
        fill: #000000;
        commands: "M 10.8 11.5 A 5.2 5.2 0 1 1 21.2 11.5 A 5.2 5.2 0 1 1 10.8 11.5 Z M 7.6 26.8 Q 8.5 18.6 16 18.6 Q 23.5 18.6 24.4 26.8 Q 20.6 30.3 16 30.3 Q 11.4 30.3 7.6 26.8 Z";
    }
}

// The moon and the sun of the Appearance choice in Settings.
export component Moon inherits Path {
    in property <color> colour;
    width: 20px;
    height: 20px;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: colour;
    commands: "M 15.5 3 A 9.5 9.5 0 1 0 21 17.5 A 7.5 7.5 0 1 1 15.5 3 Z";
}

export component Sun inherits Path {
    in property <color> colour;
    width: 22px;
    height: 22px;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: colour;
    stroke-width: 2px;
    fill: colour;
    commands: "M 12 7.5 A 4.5 4.5 0 1 0 12 16.5 A 4.5 4.5 0 1 0 12 7.5 Z M 12 1.5 L 12 4 M 12 20 L 12 22.5 M 1.5 12 L 4 12 M 20 12 L 22.5 12 M 4.6 4.6 L 6.4 6.4 M 17.6 17.6 L 19.4 19.4 M 4.6 19.4 L 6.4 17.6 M 17.6 6.4 L 19.4 4.6";
}

// The settings button: the KMRP installer's gear (src/patcher/icons/Settings.png, 2000 px,
// cropped square around the gear, made white and area-averaged to the 32 px it is drawn at in
// assets/settings.png: a 64 px picture halved at run time came out hard-edged, 2026-10-24),
// square, the game switch's height.
export component SettingsButton inherits Rectangle {
    callback clicked;
    width: 50px;
    height: 50px;
    border-radius: 6px;
    border-width: touch.has-hover ? 2px : 1px;
    border-color: touch.has-hover ? Theme.hover-edge : Theme.edge;
    background: touch.has-hover ? Theme.hover : Theme.field;
    Image {
        source: @image-url("../assets/settings.png");
        width: 32px;
        height: 32px;
        colorize: touch.has-hover ? Theme.accent : Theme.soft;
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// The copy button, the settings button's twin: two pages, the back one behind the front
// (the maintainer's icon, 2026-10-24), drawn as lines so it stays smooth at any size.
export component CopyButton inherits Rectangle {
    callback clicked;
    width: 50px;
    height: 50px;
    border-radius: 6px;
    border-width: touch.has-hover ? 2px : 1px;
    border-color: touch.has-hover ? Theme.hover-edge : Theme.edge;
    background: touch.has-hover ? Theme.hover : Theme.field;
    Path {
        width: 30px;
        height: 30px;
        viewbox-width: 24;
        viewbox-height: 24;
        stroke: touch.has-hover ? Theme.accent : Theme.soft;
        stroke-width: 1.8px;
        stroke-line-cap: round;
        commands: "M 6.6 7 L 11.3 7 L 15.2 10.9 L 15.2 18.5 A 1.6 1.6 0 0 1 13.6 20.1 L 6.6 20.1 A 1.6 1.6 0 0 1 5 18.5 L 5 8.6 A 1.6 1.6 0 0 1 6.6 7 Z M 11.3 7 L 11.3 10.9 L 15.2 10.9 M 8.9 6.6 L 8.9 4.6 A 1.6 1.6 0 0 1 10.5 3 L 15.5 3 L 19.3 6.8 L 19.3 14.7 A 1.6 1.6 0 0 1 17.7 16.3 L 16.6 16.3 M 15.5 3 L 15.5 6.8 L 19.3 6.8";
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// A small square button with a line icon (a 24-unit path), and words after it when given:
// the saves page's pen, save and Copy (2026-10-24, the maintainer).
export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    in property <bool> lit;
    // the icon's size: larger where the button has no words beside it
    in property <length> icon-size: 22px;
    callback clicked;
    height: 44px;
    // as wide as the icon and words need, whatever the layout around it has to spare
    width: root.text == "" ? self.height : 16px + 22px + 10px + measure.preferred-width + 18px;
    border-radius: 6px;
    border-width: touch.has-hover ? 2px : 1px;
    border-color: touch.has-hover ? Theme.hover-edge : lit ? Theme.accent : Theme.edge;
    background: touch.has-hover ? Theme.hover : Theme.field;
    // the words' width, measured apart from the layout
    measure := Text { visible: false; text: root.text; font-family: Theme.list-font; font-size: 18px * Theme.ts; }
    // the icon alone: placed in the middle itself (2026-11-06, the maintainer: in a layout with
    // an empty label beside it the save button's disk sat 6 px left of centre)
    if root.text == "": Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.icon-size;
        height: root.icon-size;
        viewbox-width: 24;
        viewbox-height: 24;
        stroke: touch.has-hover || lit ? Theme.accent : Theme.soft;
        stroke-width: 1.8px;
        stroke-line-cap: round;
        commands: root.icon;
    }
    if root.text != "": HorizontalLayout {
        padding-left: 16px;
        padding-right: 18px;
        spacing: 10px;
        alignment: center;
        VerticalLayout {
            alignment: center;
            Path {
                width: root.icon-size;
                height: root.icon-size;
                viewbox-width: 24;
                viewbox-height: 24;
                stroke: touch.has-hover || lit ? Theme.accent : Theme.soft;
                stroke-width: 1.8px;
                stroke-line-cap: round;
                commands: root.icon;
            }
        }
        Text {
            text: root.text;
            font-family: Theme.list-font;
            font-size: 18px * Theme.ts;
            color: Theme.text;
            vertical-alignment: center;
        }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// A few choices side by side, the picked one filled: the game switch's look.
// icons: 1 puts the moon before the first choice and the sun before the second.
export component Choice inherits Rectangle {
    in property <[string]> options;
    in property <int> current;
    in property <int> icons: 0;
    in property <length> font-size: 18px * Theme.ts;
    callback picked(int);
    height: 46px;
    // The outline is drawn last, over the choices: under them the picked one's fill hid it,
    // and each choice rounded all four corners inside its square cell, so the fill showed
    // notches where two met and the corners did not match what a click reaches (2026-11-06,
    // the maintainer: "the edges of the button seem invisible ... the actual edge might be
    // rounded but the clickable button is square"). Now only the outer corners are round.
    property <length> r: 6px;
    HorizontalLayout {
        for o[i] in options: Rectangle {
            property <bool> on: i == current;
            property <bool> first: i == 0;
            property <bool> last: i == options.length - 1;
            width: root.width / options.length;
            background: on ? transparent : ct.has-hover ? Theme.hover : Theme.field;
            // the fill inside the outline, its corners one pixel tighter: on the outline's own
            // arc the two smoothed edges mixed into a fuzzy grey rim (2026-11-07, the maintainer)
            if on: RoundFill {
                x: parent.first ? 1px : 0px;
                y: 1px;
                width: parent.width - (parent.first ? 1px : 0px) - (parent.last ? 1px : 0px);
                height: parent.height - 2px;
                from: Theme.fill-top;
                to: Theme.fill-bottom;
                r: root.r - 1px;
                r-tl: parent.first ? root.r - 1px : 0px;
                r-bl: parent.first ? root.r - 1px : 0px;
                r-tr: parent.last ? root.r - 1px : 0px;
                r-br: parent.last ? root.r - 1px : 0px;
            }
            border-width: ct.has-hover && !on ? 2px : 0px;
            border-color: Theme.hover-edge;
            border-top-left-radius: self.first ? root.r : 0px;
            border-bottom-left-radius: self.first ? root.r : 0px;
            border-top-right-radius: self.last ? root.r : 0px;
            border-bottom-right-radius: self.last ? root.r : 0px;
            if i > 0: Rectangle { x: 0; width: 1px; background: Theme.edge; }
            HorizontalLayout {
                alignment: center;
                spacing: 10px;
                if icons == 1 && i == 0: VerticalLayout { alignment: center; Moon { colour: on ? Theme.ink : Theme.gold; } }
                if icons == 1 && i == 1: VerticalLayout { alignment: center; Sun { colour: on ? Theme.ink : Theme.gold; } }
                Text { text: o; vertical-alignment: center; font-family: Theme.list-font; font-size: root.font-size; color: on ? Theme.ink : Theme.soft; }
            }
            ct := TouchArea { mouse-cursor: pointer; clicked => { root.picked(i); } }
        }
    }
    // the outline, over the choices
    Rectangle {
        border-radius: root.r;
        border-width: 1px;
        border-color: Theme.edge;
    }
}

// The crest (the sigil over KMSE, made like KMRP's: tools/build_brand_image.py in KMRP with
// assets/sigil.png, --text KMSE --tracking 0.12 --whole-crest, then area-averaged to the 142x110
// it is drawn at: shrunk at run time instead, the renderer left the sigil's edges hard) and the
// program's name (2026-10-24, the maintainer); with a save open, only "Gamesave Editor".
export component Brand inherits HorizontalLayout {
    in property <bool> short;
    // the name beside the crest, left out where the buttons on the right need its room
    in property <bool> named: true;
    spacing: 30px;
    alignment: start;
    Image {
        source: @image-url("../assets/kmse-logo.png");
        height: 110px;
        width: 142px;
        image-fit: contain;
    }
    if root.named: Text {
        text: root.short ? "Gamesave Editor" : "KOTOR Modern Gamesave Editor";
        font-family: Theme.title-font;
        font-size: 40px;
        color: Theme.text;
        vertical-alignment: center;
        letter-spacing: 1px;
    }
}

// A link-like text button for the footer.
export component Link inherits Text {
    callback clicked;
    font-family: Theme.body-font;
    font-size: 15px * Theme.ts;
    color: touch.has-hover ? Theme.text : Theme.accent;
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// A drawn cross (the KMRP fonts have no multiplication sign).
export component Cross inherits Path {
    in property <color> colour;
    width: 12px;
    height: 12px;
    viewbox-width: 12;
    viewbox-height: 12;
    stroke: colour;
    stroke-width: 2px;
    commands: "M 1 1 L 11 11 M 11 1 L 1 11";
}

// A large arrow pointing left: back to the list of saves.
export component BackArrow inherits Rectangle {
    callback clicked;
    width: 64px;
    height: 64px;
    border-radius: 32px;
    border-width: 2px;
    border-color: touch.has-hover ? Theme.hover-edge : Theme.edge;
    background: touch.has-hover ? Theme.hover : Theme.field;
    Path {
        width: 28px;
        height: 28px;
        viewbox-width: 28;
        viewbox-height: 28;
        stroke: touch.has-hover ? Theme.text : Theme.accent;
        stroke-width: 3px;
        commands: "M 25 14 L 4 14 M 13 4 L 3 14 L 13 24";
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}


// Story rewind's alignment target. The pointer updates the value while dragging;
// only release prepares a new story result. Keyboard and numeric input commit directly.
export component AlignmentChoice inherits Rectangle {
    in property <int> value: 50;
    callback set(int);
    callback committed();
    changed value => { number.text = root.value; }
    property <bool> narrow: self.width < 720px;
    height: narrow ? 152px : 110px;
    property <string> side: value == 50 ? "Neutral" : value < 50 ? "Dark side" : "Light side";
    VerticalLayout {
        x: 0px; y: 0px;
        width: root.narrow ? parent.width : parent.width - 350px;
        height: 40px;
        Label { text: "ALIGNMENT AFTER GOING BACK"; font-size: 11px * Theme.ts; letter-spacing: 1px; }
        Note { text: "Starts at 50 (Neutral). Adjust before applying."; font-size: 12px * Theme.ts; }
    }
    HorizontalLayout {
        x: root.narrow ? 0px : parent.width - 330px;
        y: root.narrow ? 44px : 0px;
        width: 330px;
        height: 40px;
        spacing: 12px;
        number := Field {
            width: 70px;
            text: root.value;
            font-size: 16px * Theme.ts;
            accepted(v) => {
                if v.is-float() { root.set(Math.round(Math.clamp(v.to-float(), 0, 100))); }
                self.text = root.value;
                root.committed();
            }
        }
        Text { width: 80px; text: root.side; color: Theme.text; font-size: 13px * Theme.ts; vertical-alignment: center; }
        Link { text: "Reset to Neutral"; clicked => { root.set(50); root.committed(); } }
    }
    slider := FocusScope {
        x: 10px; y: root.narrow ? 90px : 48px; width: parent.width - 20px; height: 34px;
        key-pressed(e) => {
            if e.text == Key.LeftArrow || e.text == Key.DownArrow { root.set(max(0, root.value - 1)); root.committed(); return accept; }
            if e.text == Key.RightArrow || e.text == Key.UpArrow { root.set(min(100, root.value + 1)); root.committed(); return accept; }
            if e.text == Key.Home { root.set(0); root.committed(); return accept; }
            if e.text == Key.End { root.set(100); root.committed(); return accept; }
            reject
        }
        RoundFill {
            y: 14px; height: 7px; r: 3.5px; across: true;
            from: #ff405d33; mid: #c6d5e322; to: #20d8ff33; has-mid: true;
        }
        RoundFill {
            y: 16px; height: 3px; r: 1.5px; across: true;
            from: #ff405d; mid: #d2dae5; to: #20d8ff; has-mid: true;
        }
        Rectangle {
            x: parent.width * root.value / 100 - 10px; y: 7px; width: 20px; height: 20px;
            border-radius: 10px; border-width: 2px;
            border-color: slider.has-focus || touch.has-hover ? Theme.hover-edge : #91dfff;
            background: Theme.field;
            Rectangle { width: 5px; height: 5px; border-radius: 3px; background: Theme.text; }
        }
        touch := TouchArea {
            mouse-cursor: pointer;
            pointer-event(e) => {
                if e.kind == PointerEventKind.down {
                    slider.focus();
                    root.set(Math.round(Math.clamp(self.mouse-x / self.width * 100, 0, 100)));
                }
                if e.kind == PointerEventKind.up { root.committed(); }
            }
            moved => {
                if self.pressed { root.set(Math.round(Math.clamp(self.mouse-x / self.width * 100, 0, 100))); }
            }
        }
    }
    HorizontalLayout {
        y: root.narrow ? 126px : 84px; height: 20px;
        Note { text: "0 · Dark"; font-size: 11px * Theme.ts; }
        Text { text: "50 · Neutral"; font-size: 11px * Theme.ts; color: Theme.muted; horizontal-alignment: center; }
        Text { text: "100 · Light"; font-size: 11px * Theme.ts; color: Theme.muted; horizontal-alignment: right; }
    }
}

