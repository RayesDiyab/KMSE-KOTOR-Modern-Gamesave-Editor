// The controls, drawn in the KMRP style rather than taken from a widget toolkit, so they
// look the same on Windows, Linux and macOS. Nothing animates.

import { Theme } from "theme.slint";

// kind: 0 cyan fill (the main action), 1 outline, 2 grey fill (Revert), 3 small outline,
// 4 red fill (taking something out of the save)
export component Button inherits Rectangle {
    in property <string> text;
    in property <int> kind: 1;
    in property <bool> enabled: true;
    in property <length> font-size: 20px * Theme.ts;
    // A row-sized button of any kind (the map's rail).
    in property <bool> compact;
    callback clicked;
    min-height: kind == 3 || compact ? 38px : 50px;
    min-width: label.preferred-width + (kind == 3 ? 32px : 48px);
    border-radius: 5px;
    border-width: touch.has-hover && enabled ? 2px : kind == 1 || kind == 3 ? 1px : 0px;
    border-color: touch.has-hover && enabled ? Theme.hover-edge : Theme.edge;
    background: !enabled ? (kind == 0 ? Theme.selected : Theme.field)
        : kind == 0 ? @linear-gradient(180deg, touch.has-hover ? Theme.fill-hover : Theme.fill-top 0%, Theme.fill-bottom 100%)
        : kind == 2 ? @linear-gradient(180deg, Theme.grey-top 0%, Theme.grey-bottom 100%)
        : kind == 4 ? (touch.has-hover ? Theme.danger.brighter(0.15) : Theme.danger)
        : (touch.has-hover ? Theme.hover : Theme.field);
    label := Text {
        text: root.text;
        font-family: Theme.list-font;
        font-size: kind == 3 ? 16px * Theme.ts : root.font-size;
        color: !enabled ? Theme.faint : kind == 0 ? Theme.ink : kind == 4 ? #ffffff : Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// Plus and minus drawn with the cross's 2 px stroke.
export component Sign inherits Path {
    in property <color> colour;
    in property <bool> plus;
    width: 12px;
    height: 12px;
    viewbox-width: 12;
    viewbox-height: 12;
    stroke: colour;
    stroke-width: 2px;
    commands: plus ? "M 0 6 L 12 6 M 6 0 L 6 12" : "M 0 6 L 12 6";
}

// A number with minus and plus beside it. Typing a number works too.
export component Stepper inherits Rectangle {
    in property <int> value;
    in property <int> minimum: 0;
    in property <int> maximum: 255;
    in property <bool> changed;
    in property <length> font-size: 20px * Theme.ts;
    callback set(int);
    height: 40px;
    min-width: 110px;
    border-radius: 5px;
    border-width: 1px;
    border-color: changed ? Theme.changed : Theme.edge;
    background: Theme.field;
    HorizontalLayout {
        Rectangle {
            width: self.height;
            Sign { colour: value > minimum ? Theme.accent : Theme.faint; }
            TouchArea { mouse-cursor: pointer; clicked => { if (value > minimum) { root.set(value - 1); } } }
        }
        Rectangle {
            input := TextInput {
                text: value;
                font-family: Theme.title-font;
                font-size: root.font-size;
                color: changed ? Theme.changed : Theme.text;
                horizontal-alignment: center;
                vertical-alignment: center;
                input-type: number;
                accepted => {
                    root.set(Math.clamp(self.text.to-float(), minimum, maximum));
                    self.clear-focus();
                }
                // Clicking anywhere else is Enter too (main.rs takes the focus away).
                changed has-focus => {
                    if !self.has-focus && self.text.to-float() != root.value {
                        root.set(Math.clamp(self.text.to-float(), minimum, maximum));
                    }
                }
            }
        }
        Rectangle {
            width: self.height;
            Sign { plus: true; colour: value < maximum ? Theme.accent : Theme.faint; }
            TouchArea { mouse-cursor: pointer; clicked => { if (value < maximum) { root.set(value + 1); } } }
        }
    }
}

// A one-line text box in the KMRP field style.
export component Field inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> changed;
    in property <bool> read-only;
    in property <string> font: Theme.list-font;
    in property <length> font-size: 18px * Theme.ts;
    callback edited(string);
    callback accepted(string);
    // The text when the box was entered, so leaving it unchanged does nothing.
    property <string> at-focus;
    public function focus-all() {
        input.focus();
        input.select-all();
    }
    height: 40px;
    border-radius: 5px;
    border-width: 1px;
    border-color: changed ? Theme.changed : input.has-focus ? Theme.accent : Theme.edge;
    background: Theme.field;
    clip: true;
    Text {
        x: 12px;
        visible: input.text == "";
        text: placeholder;
        color: Theme.faint;
        font-family: Theme.body-font;
        font-size: 14px * Theme.ts;
        vertical-alignment: center;
        height: parent.height;
    }
    input := TextInput {
        x: 12px;
        width: parent.width - 24px;
        height: parent.height;
        text <=> root.text;
        read-only: root.read-only;
        font-family: root.font;
        font-size: root.font-size;
        color: changed ? Theme.changed : Theme.text;
        vertical-alignment: center;
        single-line: true;
        edited => { root.edited(self.text); }
        accepted => {
            root.at-focus = self.text;
            root.accepted(self.text);
        }
        // Clicking anywhere else is Enter too, when the text changed since the box was entered.
        changed has-focus => {
            if self.has-focus {
                root.at-focus = self.text;
            } else if self.text != root.at-focus {
                root.at-focus = self.text;
                root.accepted(self.text);
            }
        }
    }
}

// On and off, as a small switch.
export component Switch inherits Rectangle {
    in property <bool> on;
    in property <bool> changed;
    in property <bool> enabled: true;
    callback toggled(bool);
    width: 50px;
    height: 26px;
    border-radius: 13px;
    background: !enabled ? Theme.row-line : on ? (changed ? Theme.changed : Theme.accent) : Theme.field;
    border-width: 1px;
    border-color: changed ? Theme.changed : on ? Theme.accent : Theme.edge;
    Rectangle {
        x: on ? parent.width - self.width - 4px : 4px;
        y: 4px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: on ? Theme.ink : Theme.soft;
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.toggled(!on); }
    }
}

// The spaced capital labels over each section ("ATTRIBUTES").
export component Label inherits Text {
    font-family: Theme.label-font;
    font-size: 15px * Theme.ts;
    letter-spacing: 4px;
    color: Theme.accent;
    overflow: elide;
}

export component Note inherits Text {
    font-family: Theme.body-font;
    font-size: 13.5px * Theme.ts;
    color: Theme.faint;
    wrap: word-wrap;
}

// A vertical list that scrolls, with a thin cyan bar to show where it is.
export component Scroller inherits Rectangle {
    in property <length> content-height;
    in-out property <length> offset: 0;
    clip: true;
    flick := Flickable {
        width: parent.width - 12px;
        x: 0;
        content-height: max(root.content-height + 24px, self.height);
        content-y <=> root.offset;
        @children
    }
    if content-height > root.height: Rectangle {
        x: parent.width - 5px;
        width: 4px;
        height: max(36px, root.height * root.height / content-height);
        y: (root.height - self.height) * (-root.offset / max(1px, content-height - root.height));
        border-radius: 2px;
        background: Theme.accent;
    }
}

// The moon and the sun of the Appearance choice in Settings.
export component Moon inherits Path {
    in property <color> colour;
    width: 20px;
    height: 20px;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: colour;
    commands: "M 15.5 3 A 9.5 9.5 0 1 0 21 17.5 A 7.5 7.5 0 1 1 15.5 3 Z";
}

export component Sun inherits Path {
    in property <color> colour;
    width: 22px;
    height: 22px;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: colour;
    stroke-width: 2px;
    fill: colour;
    commands: "M 12 7.5 A 4.5 4.5 0 1 0 12 16.5 A 4.5 4.5 0 1 0 12 7.5 Z M 12 1.5 L 12 4 M 12 20 L 12 22.5 M 1.5 12 L 4 12 M 20 12 L 22.5 12 M 4.6 4.6 L 6.4 6.4 M 17.6 17.6 L 19.4 19.4 M 4.6 19.4 L 6.4 17.6 M 17.6 6.4 L 19.4 4.6";
}

// The settings button: the KMRP installer's gear (src/patcher/icons/Settings.png, 2000 px,
// cropped square around the gear, made white and area-averaged to the 32 px it is drawn at in
// assets/settings.png: a 64 px picture halved at run time came out hard-edged, 2026-10-24),
// square, the game switch's height.
export component SettingsButton inherits Rectangle {
    callback clicked;
    width: 50px;
    height: 50px;
    border-radius: 6px;
    border-width: touch.has-hover ? 2px : 1px;
    border-color: touch.has-hover ? Theme.hover-edge : Theme.edge;
    background: touch.has-hover ? Theme.hover : Theme.field;
    Image {
        source: @image-url("../assets/settings.png");
        width: 32px;
        height: 32px;
        colorize: touch.has-hover ? Theme.accent : Theme.soft;
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// The copy button, the settings button's twin: two pages, the back one behind the front
// (the maintainer's icon, 2026-10-24), drawn as lines so it stays smooth at any size.
export component CopyButton inherits Rectangle {
    callback clicked;
    width: 50px;
    height: 50px;
    border-radius: 6px;
    border-width: touch.has-hover ? 2px : 1px;
    border-color: touch.has-hover ? Theme.hover-edge : Theme.edge;
    background: touch.has-hover ? Theme.hover : Theme.field;
    Path {
        width: 30px;
        height: 30px;
        viewbox-width: 24;
        viewbox-height: 24;
        stroke: touch.has-hover ? Theme.accent : Theme.soft;
        stroke-width: 1.8px;
        stroke-line-cap: round;
        commands: "M 6.6 7 L 11.3 7 L 15.2 10.9 L 15.2 18.5 A 1.6 1.6 0 0 1 13.6 20.1 L 6.6 20.1 A 1.6 1.6 0 0 1 5 18.5 L 5 8.6 A 1.6 1.6 0 0 1 6.6 7 Z M 11.3 7 L 11.3 10.9 L 15.2 10.9 M 8.9 6.6 L 8.9 4.6 A 1.6 1.6 0 0 1 10.5 3 L 15.5 3 L 19.3 6.8 L 19.3 14.7 A 1.6 1.6 0 0 1 17.7 16.3 L 16.6 16.3 M 15.5 3 L 15.5 6.8 L 19.3 6.8";
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// A small square button with a line icon (a 24-unit path), and words after it when given:
// the saves page's pen, save and Copy (2026-10-24, the maintainer).
export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    in property <bool> lit;
    callback clicked;
    height: 44px;
    // as wide as the icon and words need, whatever the layout around it has to spare
    width: root.text == "" ? self.height : 16px + 22px + 10px + label.preferred-width + 18px;
    border-radius: 6px;
    border-width: touch.has-hover ? 2px : 1px;
    border-color: touch.has-hover ? Theme.hover-edge : lit ? Theme.accent : Theme.edge;
    background: touch.has-hover ? Theme.hover : Theme.field;
    HorizontalLayout {
        padding-left: root.text == "" ? 0 : 16px;
        padding-right: root.text == "" ? 0 : 18px;
        spacing: root.text == "" ? 0 : 10px;
        alignment: center;
        VerticalLayout {
            alignment: center;
            Path {
                width: 22px;
                height: 22px;
                viewbox-width: 24;
                viewbox-height: 24;
                stroke: touch.has-hover || lit ? Theme.accent : Theme.soft;
                stroke-width: 1.8px;
                stroke-line-cap: round;
                commands: root.icon;
            }
        }
        label := Text {
            visible: root.text != "";
            text: root.text;
            font-family: Theme.list-font;
            font-size: 18px * Theme.ts;
            color: Theme.text;
            vertical-alignment: center;
        }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// A few choices side by side, the picked one filled: the game switch's look.
// icons: 1 puts the moon before the first choice and the sun before the second.
export component Choice inherits Rectangle {
    in property <[string]> options;
    in property <int> current;
    in property <int> icons: 0;
    in property <length> font-size: 18px * Theme.ts;
    callback picked(int);
    height: 46px;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.edge;
    clip: true;
    HorizontalLayout {
        for o[i] in options: Rectangle {
            property <bool> on: i == current;
            width: root.width / options.length;
            background: on ? @linear-gradient(180deg, Theme.fill-top 0%, Theme.fill-bottom 100%) : ct.has-hover ? Theme.hover : Theme.field;
            border-width: ct.has-hover && !on ? 2px : 0px;
            border-color: Theme.hover-edge;
            border-radius: 6px;
            if i > 0: Rectangle { x: 0; width: 1px; background: Theme.edge; }
            HorizontalLayout {
                alignment: center;
                spacing: 10px;
                if icons == 1 && i == 0: VerticalLayout { alignment: center; Moon { colour: on ? Theme.ink : Theme.gold; } }
                if icons == 1 && i == 1: VerticalLayout { alignment: center; Sun { colour: on ? Theme.ink : Theme.gold; } }
                Text { text: o; vertical-alignment: center; font-family: Theme.list-font; font-size: root.font-size; color: on ? Theme.ink : Theme.soft; }
            }
            ct := TouchArea { mouse-cursor: pointer; clicked => { root.picked(i); } }
        }
    }
}

// The crest (the sigil over KMSE, made like KMRP's: tools/build_brand_image.py in KMRP with
// assets/sigil.png, --text KMSE --tracking 0.12 --whole-crest, then area-averaged to the 142x110
// it is drawn at: shrunk at run time instead, the renderer left the sigil's edges hard) and the
// program's name (2026-10-24, the maintainer); with a save open, only "Gamesave Editor".
export component Brand inherits HorizontalLayout {
    in property <bool> short;
    spacing: 30px;
    alignment: start;
    Image {
        source: @image-url("../assets/kmse-logo.png");
        height: 110px;
        width: 142px;
        image-fit: contain;
    }
    Text {
        text: root.short ? "Gamesave Editor" : "KOTOR Modern Gamesave Editor";
        font-family: Theme.title-font;
        font-size: 40px;
        color: Theme.text;
        vertical-alignment: center;
        letter-spacing: 1px;
    }
}

// A link-like text button for the footer.
export component Link inherits Text {
    callback clicked;
    font-family: Theme.body-font;
    font-size: 15px * Theme.ts;
    color: touch.has-hover ? Theme.text : Theme.accent;
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// A drawn cross (the KMRP fonts have no multiplication sign).
export component Cross inherits Path {
    in property <color> colour;
    width: 12px;
    height: 12px;
    viewbox-width: 12;
    viewbox-height: 12;
    stroke: colour;
    stroke-width: 2px;
    commands: "M 1 1 L 11 11 M 11 1 L 1 11";
}

// A large arrow pointing left: back to the list of saves.
export component BackArrow inherits Rectangle {
    callback clicked;
    width: 64px;
    height: 64px;
    border-radius: 32px;
    border-width: 2px;
    border-color: touch.has-hover ? Theme.hover-edge : Theme.edge;
    background: touch.has-hover ? Theme.hover : Theme.field;
    Path {
        width: 28px;
        height: 28px;
        viewbox-width: 28;
        viewbox-height: 28;
        stroke: touch.has-hover ? Theme.text : Theme.accent;
        stroke-width: 3px;
        commands: "M 25 14 L 4 14 M 13 4 L 3 14 L 13 24";
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

