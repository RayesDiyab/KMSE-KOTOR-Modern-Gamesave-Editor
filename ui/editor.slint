// The editor, shaped like the game's in-game menu: tabs across the top, the party down
// the left, and every value changed where it is shown. A changed value turns orange
// until it is saved.

import { Theme } from "theme.slint";
// written by build.rs: Yavin Station, made from the player's game
import { TimelineArt } from "timeline-art.slint";
import { App, Stat, Named, ItemRow, NpcRow, GlobalRow, DoorRow, BoxRow, Toggle, MapMark, AreaRow, SlotRow, TimelineNode, TimelineSave, TimelineGroup, GalaxyStop, GalaxyLane, StageRow } from "state.slint";
import { Button, Stepper, Field, Switch, Label, Note, Scroller, Cross, Sign, BackArrow, Choice, Link, CopyButton } from "widgets.slint";

component Line inherits Rectangle {
    height: 56px;
    Rectangle { x: 0; y: parent.height - 1px; height: 1px; background: Theme.row-line; }
}

component StatLine inherits Line {
    in property <Stat> stat;
    in property <length> label-size: 19px;
    callback set(int);
    height: stat.note != "" ? 60px : 52px;
    HorizontalLayout {
        spacing: 12px;
        if stat.has-icon: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 34px;
                height: 34px;
                border-radius: 4px;
                background: Theme.field;
                clip: true;
                Image { source: stat.icon; width: parent.width; height: parent.height; }
            }
        }
        VerticalLayout {
            alignment: center;
            Text { text: stat.label; font-family: Theme.list-font; font-size: label-size * Theme.ts; color: Theme.text; overflow: elide; }
            if stat.note != "": Text { text: stat.note; font-family: Theme.body-font; font-size: 12.5px * Theme.ts; color: Theme.faint; overflow: elide; }
        }
        VerticalLayout {
            alignment: center;
            Stepper {
                width: 116px;
                value: stat.value;
                minimum: stat.minimum;
                maximum: stat.maximum;
                changed: stat.changed;
                set(v) => { root.set(v); }
            }
        }
        if stat.mod != "": Text {
            width: 34px;
            text: stat.mod;
            horizontal-alignment: right;
            vertical-alignment: center;
            font-family: Theme.list-font;
            font-size: 17px * Theme.ts;
            color: Theme.muted;
        }
    }
}

// Every feat or power the game has, in its groups, with its icon. What the character
// has is lit, with a cross to remove it; the rest have a plus. Typing narrows the list.
component AbilityList inherits Rectangle {
    in property <string> title;
    in property <string> hint;
    in property <string> placeholder;
    in property <[Named]> rows;
    in property <bool> enabled: true;
    callback search(string);
    callback add(int);
    callback remove(int);
    in-out property <string> query;
    // the box empties when main.rs clears the list's search (another member, a feat added)
    in property <int> reset: App.ability-reset;
    changed reset => { root.query = ""; }
    HorizontalLayout {
        x: 0;
        y: 0;
        height: 24px;
        spacing: 10px;
        Label { text: title; min-width: self.preferred-width; }
        Note { text: hint; horizontal-alignment: right; vertical-alignment: center; wrap: no-wrap; overflow: elide; }
    }
    Field {
        x: 0;
        y: 34px;
        height: 40px;
        text <=> query;
        placeholder: root.placeholder;
        font: Theme.body-font;
        font-size: 15px * Theme.ts;
        read-only: !enabled;
        edited(t) => { root.search(t); }
    }
    Scroller {
        x: 0;
        y: 84px;
        height: parent.height - 84px;
        content-height: list.preferred-height;
        list := VerticalLayout {
            // the list's own width, whatever its names: a long name (KotOR II's German ones)
            // widened every row, and the add and remove column went off the right edge
            // (2026-11-06, the maintainer: "abilities in kotor 2 dont work to add or remove")
            width: root.width - 12px;
            // each row as tall as its name needs: a name on three lines was cut at 50 px
            for r in rows: Rectangle {
                height: r.header ? 50px : max(50px, nm.preferred-height + 14px);
                background: r.owned ? Theme.selected : transparent;
                border-radius: 5px;
                if r.header: Label { x: 4px; y: 22px; text: r.name; font-size: 13px * Theme.ts; color: Theme.soft; }
                if !r.header: Rectangle { x: 0; y: parent.height - 1px; height: 1px; background: Theme.row-line; }
                // not an `if`: the row's height reads the name's
                Rectangle { visible: !r.header; HorizontalLayout {
                    padding-left: 6px;
                    spacing: 10px;
                    Rectangle {
                        width: 38px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                height: 38px;
                                border-radius: 4px;
                                background: Theme.field;
                                border-width: 1px;
                                border-color: r.owned ? Theme.accent : Theme.edge;
                                clip: true;
                                if r.has-icon: Image { source: r.icon; width: parent.width; height: parent.height; }
                            }
                        }
                    }
                    // the name alone, on two lines when it is long; the line under it (the
                    // description's first line: "Prerequisites:", "Universal Power") only
                    // repeated the group (2026-10-24, the maintainer)
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        min-width: 0px;
                        // it wraps in the room left, and never asks for more
                        nm := Text {
                            min-width: 0px;
                            text: r.name;
                            font-family: Theme.list-font;
                            font-size: 16px * Theme.ts;
                            color: r.changed ? Theme.changed : r.owned ? Theme.gold : Theme.text;
                            wrap: word-wrap;
                        }
                    }
                    Rectangle {
                        width: 40px;
                        if !r.owned && root.enabled: Sign { plus: true; colour: act.has-hover ? Theme.text : Theme.accent; }
                        if r.owned: Cross { colour: act.has-hover ? Theme.danger : Theme.faint; }
                        act := TouchArea {
                            enabled: (root.enabled || r.owned) && !r.header;
                            mouse-cursor: pointer;
                            clicked => { if (r.owned) { root.remove(r.id); } else { root.add(r.id); } }
                        }
                    }
                } }
            }
        }
    }
}

component CharacterTab inherits Rectangle {
    property <length> colw: (self.width - 2 * 34px) / 3;
    // the labels of the Who column, narrower where the column is (the fields need the room)
    property <length> labelw: min(130px * Theme.ts, colw * 0.42);
    // their size: smaller where the column is narrow
    property <length> labelf: (labelw < 130px * Theme.ts ? 16px : 19px) * Theme.ts;
    // Who
    Rectangle {
        x: 0;
        width: colw;
        Label { x: 0; y: 0; text: "WHO"; }
        VerticalLayout {
            x: 0; y: 32px;
            height: self.preferred-height;
            spacing: 0px;
            Line {
                HorizontalLayout {
                    spacing: 12px;
                    Text { width: root.labelw; text: "Name"; vertical-alignment: center; font-family: Theme.list-font; font-size: root.labelf; color: Theme.text; overflow: elide; }
                    VerticalLayout {
                        alignment: center;
                        Field {
                            property <int> epoch: App.pool-epoch; changed epoch => { self.text = App.name; } text: App.name;
                            font-size: (root.colw < 380px * Theme.ts ? 15px : 18px) * Theme.ts;
                            changed: App.name-changed;
                            accepted(t) => { App.set-name(t); }
                            edited(t) => { App.set-name(t); }
                        }
                    }
                }
            }
            Line {
                HorizontalLayout {
                    spacing: 12px;
                    Text { width: root.labelw; text: "Classes"; vertical-alignment: center; font-family: Theme.list-font; font-size: root.labelf; color: Theme.text; overflow: elide; }
                    // the classes as text in a box: cut with "..." where it is narrow (a read-only
                    // field cut the text through a letter)
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            height: 40px;
                            border-radius: 5px;
                            border-width: 1px;
                            border-color: Theme.edge;
                            background: Theme.field;
                            Text { x: 10px; width: parent.width - 20px; text: App.classes; vertical-alignment: center; font-family: Theme.body-font; font-size: 14px * Theme.ts; color: Theme.text; overflow: elide; }
                        }
                    }
                    VerticalLayout { alignment: center; Button { kind: 3; text: "Edit"; clicked => { App.open-classes(); } } }
                }
            }
            Line {
                HorizontalLayout {
                    spacing: 12px;
                    Text { width: root.labelw; text: "Experience"; vertical-alignment: center; font-family: Theme.list-font; font-size: root.labelf; color: Theme.text; overflow: elide; }
                    VerticalLayout {
                        alignment: center;
                        Field {
                            property <int> epoch: App.pool-epoch; changed epoch => { self.text = App.xp; } text: App.xp;
                            changed: App.xp-changed;
                            accepted(t) => { if t.is-float() { App.set-xp(t.to-float()); } else { self.text = App.xp; } }
                        }
                    }
                }
            }
        }
        // the note, then the level buttons under it however many lines it takes
        VerticalLayout {
            x: 0; y: 210px;
            width: parent.width;
            height: self.preferred-height;
            spacing: 8px;
            Note { text: App.level-note; }
            HorizontalLayout {
                height: 38px;
                spacing: 10px;
                alignment: start;
                Button { kind: 3; text: "Next Level"; clicked => { App.xp-to-next(); } }
                Button { kind: 3; text: "Level " + App.max-level; clicked => { App.xp-to-max(); } }
            }
        }
        Label { x: 0; y: 370px; text: "ALIGNMENT"; }
        Rectangle {
            x: 0; y: 404px;
            height: 14px;
            border-radius: 7px;
            background: @linear-gradient(90deg, #b8333a 0%, #6a6a6a 50%, #3b8fe0 100%);
            Rectangle {
                x: parent.width * App.alignment / 100 - 2px;
                y: -6px;
                width: 4px;
                height: 26px;
                border-radius: 2px;
                background: App.alignment-changed ? Theme.changed : Theme.text;
            }
            TouchArea {
                y: -8px;
                height: parent.height + 16px;
                mouse-cursor: pointer;
                pointer-event(e) => {
                    if (self.pressed) { App.set-alignment(Math.round(Math.clamp(self.mouse-x / parent.width * 100, 0, 100))); }
                }
                moved => { App.set-alignment(Math.round(Math.clamp(self.mouse-x / parent.width * 100, 0, 100))); }
            }
        }
        HorizontalLayout {
            x: 0; y: 426px;
            height: 20px;
            Note { text: "Dark side"; }
            Text {
                text: App.alignment;
                horizontal-alignment: center;
                font-family: Theme.body-font;
                font-size: 14px * Theme.ts;
                color: App.alignment-changed ? Theme.changed : Theme.text;
            }
            Note { text: "Light side"; horizontal-alignment: right; }
        }
    }
    // Attributes
    Rectangle {
        x: colw + 34px;
        width: colw;
        Label { x: 0; y: 0; text: "ATTRIBUTES"; }
        VerticalLayout {
            x: 0; y: 32px;
            height: self.preferred-height;
            for s[i] in App.attributes: StatLine { stat: s; label-size: root.colw < 380px * Theme.ts ? 16px : 19px; set(v) => { App.set-attribute(i, v); } }
        }
        Note {
            x: 0; y: 32px + 6 * 60px + 10px;
            width: parent.width;
            text: "Base scores, before items and powers. The game works out Defence and saving throws from them.";
        }
    }
    // Health, Force, look
    Rectangle {
        x: 2 * (colw + 34px);
        width: colw;
        Label { x: 0; y: 0; text: "HEALTH AND FORCE"; }
        property <int> epoch: App.pool-epoch;
        changed epoch => {
            hn.text = App.hp-current;
            hm.text = App.hp-max;
            fn.text = App.fp-current;
            fm.text = App.fp-max;
        }
        // the boxes hold four digits at every text size (2026-11-06: 944 and 1052 were cut
        // at Large text in 72 px)
        VerticalLayout {
            x: 0; y: 32px;
            height: self.preferred-height;
            Line {
                HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        Text { text: "Health"; font-family: Theme.list-font; font-size: 19px * Theme.ts; color: Theme.text; }
                        Text { text: App.health-note; font-family: Theme.body-font; font-size: 12.5px * Theme.ts; color: Theme.faint; overflow: elide; }
                    }
                    VerticalLayout { alignment: center; hn := Field { width: 60px + 26px * Theme.ts; font-size: 16px * Theme.ts; text: App.hp-current; changed: App.hp-changed; accepted(t) => { if hn.text.is-float() && hm.text.is-float() { App.set-hp(hn.text.to-float(), hm.text.to-float()); } else { hn.text = App.hp-current; hm.text = App.hp-max; } } } }
                    VerticalLayout { alignment: center; hm := Field { width: 60px + 26px * Theme.ts; font-size: 16px * Theme.ts; text: App.hp-max; changed: App.hp-changed; accepted(t) => { if hn.text.is-float() && hm.text.is-float() { App.set-hp(hn.text.to-float(), hm.text.to-float()); } else { hn.text = App.hp-current; hm.text = App.hp-max; } } } }
                }
            }
            Line {
                HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        Text { text: "Force"; font-family: Theme.list-font; font-size: 19px * Theme.ts; color: Theme.text; }
                        Text { text: App.force-note; font-family: Theme.body-font; font-size: 12.5px * Theme.ts; color: Theme.faint; overflow: elide; }
                    }
                    VerticalLayout { alignment: center; fn := Field { width: 60px + 26px * Theme.ts; font-size: 16px * Theme.ts; text: App.fp-current; changed: App.fp-changed; accepted(t) => { if fn.text.is-float() && fm.text.is-float() { App.set-fp(fn.text.to-float(), fm.text.to-float()); } else { fn.text = App.fp-current; fm.text = App.fp-max; } } } }
                    VerticalLayout { alignment: center; fm := Field { width: 60px + 26px * Theme.ts; font-size: 16px * Theme.ts; text: App.fp-max; changed: App.fp-changed; accepted(t) => { if fn.text.is-float() && fm.text.is-float() { App.set-fp(fn.text.to-float(), fm.text.to-float()); } else { fn.text = App.fp-current; fm.text = App.fp-max; } } } }
                }
            }
        }
        // Heal Everyone, and the switch on the same line where the column has room for both,
        // under it where not (2026-11-06: at 1600 by 900 "Cannot die" ran off the panel)
        property <bool> heal-wide: root.colw >= 420px * Theme.ts;
        HorizontalLayout {
            x: 0; y: 152px;
            height: 38px;
            spacing: 14px;
            alignment: start;
            Button { kind: 3; text: "Heal Everyone"; clicked => { App.heal-all(); } }
            if heal-wide: VerticalLayout { alignment: center; Switch { on: App.min1hp; changed: App.min1hp-changed; toggled(v) => { App.set-min1hp(v); } } }
            if heal-wide: Text { text: "Cannot die"; vertical-alignment: center; font-family: Theme.body-font; font-size: 14px * Theme.ts; color: Theme.muted; }
        }
        if !heal-wide: HorizontalLayout {
            x: 0; y: 198px;
            height: 30px;
            spacing: 12px;
            alignment: start;
            VerticalLayout { alignment: center; Switch { on: App.min1hp; changed: App.min1hp-changed; toggled(v) => { App.set-min1hp(v); } } }
            Text { text: "Cannot die"; vertical-alignment: center; font-family: Theme.body-font; font-size: 14px * Theme.ts; color: Theme.muted; }
        }
        property <length> shift: heal-wide ? 0px : 40px;
        if App.records-warning != "": Text {
            x: 0; y: 194px + shift;
            width: parent.width;
            text: App.records-warning;
            font-family: Theme.body-font;
            font-size: 12.5px * Theme.ts;
            color: Theme.changed;
            overflow: elide;
        }
        Label { x: 0; y: 214px + shift; text: "LOOK AND VOICE"; }
        Rectangle {
            x: 0; y: 246px + shift;
            width: 84px;
            height: 84px;
            border-radius: 5px;
            border-width: App.look-changed ? 2px : 1px;
            border-color: App.look-changed ? Theme.changed : Theme.edge;
            background: Theme.field;
            clip: true;
            if App.has-portrait: Image { source: App.portrait; width: parent.width; height: parent.height; }
            TouchArea { mouse-cursor: pointer; clicked => { App.open-look(); } }
        }
        VerticalLayout {
            x: 98px; y: 240px + shift;
            width: parent.width - 98px;
            height: self.preferred-height;
            for f in [
                { label: "Portrait", value: "Change", which: 0 },
                { label: "Body", value: App.body-name, which: 1 },
                { label: "Voice", value: App.voice-name, which: 2 },
                { label: "Gender", value: App.gender-name, which: 3 },
            ]: Rectangle {
                height: 34px;
                Rectangle { x: 0; y: parent.height - 1px; height: 1px; background: Theme.row-line; }
                HorizontalLayout {
                    spacing: 8px;
                    Text { width: 64px; text: f.label; vertical-alignment: center; font-family: Theme.body-font; font-size: 13px * Theme.ts; color: Theme.faint; }
                    Text { text: f.value; vertical-alignment: center; font-family: Theme.list-font; font-size: 15px * Theme.ts; color: lk.has-hover ? Theme.accent : Theme.text; overflow: elide; }
                }
                lk := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        if (f.which == 0) { App.open-look(); }
                        if (f.which == 1) { App.open-body(); }
                        if (f.which == 2) { App.open-voice(); }
                        if (f.which == 3) { App.open-gender(); }
                    }
                }
            }
        }
    }
}

component AbilitiesTab inherits Rectangle {
    property <length> colw: (self.width - 2 * 34px) / 3;
    property <length> pick-w: (root.width - colw * 0.92 - 68px) / 2;
    Rectangle {
        x: 0;
        width: colw * 0.92;
        Label { x: 0; y: 0; text: "SKILLS"; }
        VerticalLayout {
            x: 0; y: 32px;
            height: self.preferred-height;
            for s[i] in App.skills: StatLine { stat: s; label-size: 15px; height: 50px; set(v) => { App.set-skill(i, v); } }
        }
        Note { x: 0; y: 32px + App.skills.length * 50px + 10px; width: parent.width; visible: self.y + self.preferred-height <= root.height; text: "Ranks the character has bought. Items and attributes add on top in the game."; }
    }
    AbilityList {
        x: colw * 0.92 + 34px;
        width: pick-w;
        title: "FEATS · " + App.feat-count;
        placeholder: "Type to narrow the list";
        rows: App.feats;
        search(t) => { App.search-feats(t); }
        add(id) => { App.add-feat(id); }
        remove(id) => { App.remove-feat(id); }
    }
    AbilityList {
        x: colw * 0.92 + 34px + pick-w + 34px;
        width: pick-w;
        title: "FORCE POWERS · " + App.power-count;
        hint: App.power-note;
        enabled: App.can-powers;
        placeholder: App.can-powers ? "Type to narrow the list" : "Only a Jedi class learns Force powers";
        rows: App.powers;
        search(t) => { App.search-powers(t); }
        add(id) => { App.add-power(id); }
        remove(id) => { App.remove-power(id); }
    }
}

component ItemLine inherits Rectangle {
    in property <ItemRow> item;
    in property <bool> editable: true;
    callback stack(int);
    callback remove();
    height: 50px;
    Rectangle { x: 0; y: parent.height - 1px; height: 1px; background: Theme.row-line; }
    HorizontalLayout {
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 40px;
                height: 40px;
                border-radius: 4px;
                border-width: 1px;
                border-color: Theme.edge;
                background: Theme.field;
                clip: true;
                if item.has-icon: Image { source: item.icon; width: parent.width; height: parent.height; }
            }
        }
        VerticalLayout {
            alignment: center;
            Text { text: item.name; font-family: Theme.list-font; font-size: 17px * Theme.ts; color: item.changed ? Theme.changed : Theme.text; overflow: elide; }
            Text { text: item.kind; font-family: Theme.body-font; font-size: 12px * Theme.ts; color: Theme.faint; overflow: elide; }
        }
        if editable && item.max-stack > 1: VerticalLayout {
            alignment: center;
            Stepper { width: 130px; height: 34px; value: item.stack; minimum: 1; maximum: item.max-stack; changed: item.changed; font-size: 17px * Theme.ts; set(v) => { root.stack(v); } }
        }
        if !editable || item.max-stack <= 1: Text {
            width: 130px;
            text: item.stack > 1 ? "× " + item.stack : "";
            horizontal-alignment: center;
            vertical-alignment: center;
            font-family: Theme.list-font;
            font-size: 16px * Theme.ts;
            color: Theme.muted;
        }
        if editable: Rectangle {
            width: 36px;
            Cross { colour: rm.has-hover ? Theme.danger : Theme.faint; }
            rm := TouchArea { mouse-cursor: pointer; clicked => { root.remove(); } }
        }
    }
}

component Money inherits Line {
    in property <string> label;
    in property <string> note;
    in property <int> value;
    in property <bool> changed;
    callback set(int);
    HorizontalLayout {
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Text { text: label; font-family: Theme.list-font; font-size: 19px * Theme.ts; color: Theme.text; }
            if note != "": Text { text: note; font-family: Theme.body-font; font-size: 12.5px * Theme.ts; color: Theme.faint; }
        }
        VerticalLayout {
            alignment: center;
            Field { width: min(170px, root.width - 150px); property <int> epoch: App.pool-epoch; changed epoch => { self.text = value; } text: value; changed: changed; accepted(t) => { if t.is-float() { root.set(t.to-float()); } else { self.text = value; } } }
        }
    }
}

// A party amount as a name over its box, for KotOR II's three side by side (as three rows
// they took the height the Equipped slots need, 2026-11-06).
component MoneyBox inherits VerticalLayout {
    in property <string> label;
    in property <int> value;
    in property <bool> changed;
    callback set(int);
    spacing: 6px;
    // smaller in a narrow box, so "Components" is not cut
    Text { text: label; font-family: Theme.list-font; font-size: min(14px * Theme.ts, root.width / 8.8); color: Theme.text; overflow: elide; }
    Field {
        height: 40px;
        // smaller in a narrow box, so seven digits still fit
        font-size: min(16px * Theme.ts, root.width / 8);
        property <int> epoch: App.pool-epoch;
        changed epoch => { self.text = root.value; }
        text: root.value;
        changed: root.changed;
        accepted(t) => { if t.is-float() { root.set(t.to-float()); } else { self.text = root.value; } }
    }
}

// The kinds of item as a row of tabs; on two rows when the row would not fit.
component KindTab inherits Rectangle {
    in property <string> text;
    in property <bool> on;
    callback chosen;
    width: kt.preferred-width + 20px;
    height: 34px;
    border-radius: 5px;
    border-width: 1px;
    border-color: on ? Theme.accent : Theme.edge;
    background: on ? Theme.selected : kta.has-hover ? Theme.hover : Theme.field;
    kt := Text { text: root.text; font-family: Theme.list-font; font-size: 14px * Theme.ts; color: on ? Theme.text : Theme.soft; }
    kta := TouchArea { mouse-cursor: pointer; clicked => { root.chosen(); } }
}

// A run of the kind tabs, from `from` up to (not including) `to`, each with its gap after it.
component TabRow inherits HorizontalLayout {
    in property <int> from;
    in property <int> to;
    in property <int> selected: -1;
    callback chosen(int);
    height: 34px;
    spacing: 0;
    alignment: start;
    for t[i] in App.picker-tabs: Rectangle {
        width: i >= root.from && i < root.to ? tab.width + 6px : 0px;
        visible: i >= root.from && i < root.to;
        tab := KindTab { x: 0; text: t; on: i == root.selected; chosen => { root.chosen(i); } }
    }
}

component KindTabs inherits Rectangle {
    in property <int> selected;
    callback chosen(int);
    // As many tabs as fit in the first row, the rest in a second: hidden runs of the first
    // 1 to 8 tabs are measured and the longest that fits is used.
    p1 := TabRow { y: 0; opacity: 0; from: 0; to: 1; }
    p2 := TabRow { y: 0; opacity: 0; from: 0; to: 2; }
    p3 := TabRow { y: 0; opacity: 0; from: 0; to: 3; }
    p4 := TabRow { y: 0; opacity: 0; from: 0; to: 4; }
    p5 := TabRow { y: 0; opacity: 0; from: 0; to: 5; }
    p6 := TabRow { y: 0; opacity: 0; from: 0; to: 6; }
    p7 := TabRow { y: 0; opacity: 0; from: 0; to: 7; }
    p8 := TabRow { y: 0; opacity: 0; from: 0; to: 8; }
    property <int> fit: min(App.picker-tabs.length, p8.preferred-width <= root.width + 6px ? 8 : p7.preferred-width <= root.width + 6px ? 7 : p6.preferred-width <= root.width + 6px ? 6 : p5.preferred-width <= root.width + 6px ? 5 : p4.preferred-width <= root.width + 6px ? 4 : p3.preferred-width <= root.width + 6px ? 3 : p2.preferred-width <= root.width + 6px ? 2 : p1.preferred-width <= root.width + 6px ? 1 : 1);
    height: fit < App.picker-tabs.length ? 74px : 34px;
    TabRow { y: 0; from: 0; to: fit; selected: root.selected; chosen(i) => { root.chosen(i); } }
    if fit < App.picker-tabs.length: TabRow { y: 40px; from: fit; to: App.picker-tabs.length; selected: root.selected; chosen(i) => { root.chosen(i); } }
}

// One slot of the game's equip screen, drawn from the shapes of its frames (lbl_top,
// lbl_mid, lbl_bot; measured from KMRP's 192-pixel redraws of them): the top row rounded
// above, the middle rows with a tab that sits in the notch above, the bottom row rounded
// below. Each frame stands in a square of the game's 64 units; rows and columns step 50,
// so the tabs and notches interlock as they do in the game.
component EquipSlot inherits Rectangle {
    in property <SlotRow> slot;
    // 0 top row, 1 a middle row, 2 the bottom row.
    in property <int> shape;
    in property <bool> picked;
    callback clicked;
    // An empty slot's picture is the whole tile, as in the game (drawn in the same 64-unit
    // square as the frame); the frame goes over it.
    // KotOR's pictures leave the frame's margin round them; KotOR II's fill their texture,
    // so they go inside the frame (they spilled over the next slot, 2026-11-06)
    if slot.empty && slot.has-art: Image {
        x: Theme.k2 ? parent.width * 0.15 : 0;
        y: Theme.k2 ? parent.height * 0.13 : 0;
        width: parent.width * (Theme.k2 ? 0.7 : 1);
        height: parent.height * (Theme.k2 ? 0.75 : 1);
        source: slot.art;
    }
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 192;
        viewbox-height: 192;
        stroke-width: (picked ? 4px : 2.5px) * parent.width / 120px;
        stroke: picked ? Theme.gold : slot.changed ? Theme.changed : touch.has-hover ? Theme.text : Theme.accent;
        // An empty slot glows faintly in the accent, as the game's empty slots do; a worn
        // item sits on the plain frame.
        fill: slot.empty && slot.has-art ? transparent : picked ? Theme.selected : touch.has-hover ? Theme.hover : Theme.field;
        commands: shape == 0
            ? "M 27.5 33 Q 94 3 160.5 33 L 160.5 170.5 L 133.5 170.5 L 118.5 155.5 L 69.5 155.5 L 54.5 170.5 L 27.5 170.5 Z"
            : shape == 1
            ? "M 27.5 35.5 L 58 35.5 L 76 17.5 L 112 17.5 L 130 35.5 L 160.5 35.5 L 160.5 170.5 L 133.5 170.5 L 118.5 155.5 L 69.5 155.5 L 54.5 170.5 L 27.5 170.5 Z"
            : "M 27.5 35.5 L 58 35.5 L 76 17.5 L 112 17.5 L 130 35.5 L 160.5 35.5 L 160.5 152 Q 94 186 27.5 152 Z";
    }
    // the worn item as large as the frame's inside (it was half the slot, 2026-11-06, the
    // maintainer: "make the items in the equipped slots bigger so they fill the equipment
    // slots")
    if slot.has-icon: Image {
        x: parent.width * 0.18;
        y: parent.height * 0.2;
        width: parent.width * 0.62;
        height: parent.height * 0.62;
        source: slot.icon;
        image-fit: contain;
    }
    // Without the game's picture, the slot's name.
    if slot.empty && !slot.has-art: Text {
        x: parent.width * 0.17;
        width: parent.width * 0.66;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: word-wrap;
        text: slot.name;
        font-family: Theme.body-font;
        font-size: max(10px, parent.width * 0.1);
        color: Theme.faint;
    }
    touch := TouchArea {
        x: parent.width * 0.14;
        width: parent.width * 0.72;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component InventoryTab inherits Rectangle {
    // The left side is as wide as the slots, which are as large as the height under the
    // money allows (and never so wide that the list loses its room).
    // KotOR II's three amounts sit side by side, so its slots get nearly KotOR's room
    property <length> equip-y: App.has-crafting ? 32px + 40px + 14px * Theme.ts * 1.3 + 6px + 12px + 36px : 138px;
    property <int> rows: Math.ceil(App.slots.length / 3);
    // KotOR II's weapon set switch under the grid, and the gap above it
    property <length> sets-h: App.has-weapon-sets ? 34px * Theme.ts + 10px : 0px;
    property <length> cell: min(170px, (self.width * 0.55) / (2 * 50 / 64 + 1), (self.height - equip-y - 40px - sets-h) / ((rows - 1) * 50 / 64 + 1));
    property <length> step: cell * 50 / 64;
    // wider with KotOR II's three amounts side by side, where the window has the room (at
    // 1280 by 780 the inventory's buttons ran out of theirs)
    property <length> side: max((App.has-crafting && self.width >= 1100px ? 360px : 300px) * Theme.ts, 2 * step + cell);
    // The grid (and KotOR II's weapon switch under it) centred in the room under its label,
    // across and down (2026-11-06, the maintainer: "center the grid correctly in the space it
    // occupies in both kotor 1 and 2 screens"; it sat against the left)
    property <length> grid-w: 2 * step + cell;
    property <length> grid-h: (rows - 1) * step + cell;
    property <length> grid-x: (side - grid-w) / 2;
    property <length> grid-y: equip-y + 34px + max(0px, (self.height - equip-y - 34px - grid-h - sets-h) / 2);
    Rectangle {
        x: 0;
        width: side;
        Label { x: 0; y: 0; width: parent.width; text: "SHARED BY THE PARTY"; }
        if !App.has-crafting: VerticalLayout {
            x: 0; y: 32px;
            height: self.preferred-height;
            Money { label: "Credits"; value: App.credits; changed: App.credits-changed; set(v) => { App.set-credits(v); } }
        }
        // KotOR II: credits, components (for the workbench) and chemicals (for the lab
        // station) side by side
        if App.has-crafting: HorizontalLayout {
            x: 0; y: 32px;
            width: parent.width;
            height: self.preferred-height;
            spacing: 12px;
            MoneyBox { width: (parent.width - 24px) * 0.36; label: "Credits"; value: App.credits; changed: App.credits-changed; set(v) => { App.set-credits(v); } }
            MoneyBox { width: (parent.width - 24px) * 0.32; label: "Components"; value: App.components; changed: App.components-changed; set(v) => { App.set-components(v); } }
            MoneyBox { width: (parent.width - 24px) * 0.32; label: "Chemicals"; value: App.chemicals; changed: App.chemicals-changed; set(v) => { App.set-chemicals(v); } }
        }
        Note { x: 0; y: equip-y - 36px; width: parent.width; text: "Type a number and press Enter."; }
        Label { x: 0; y: equip-y; width: parent.width; text: "EQUIPPED BY " + (App.members.length > App.who ? App.members[App.who].name : App.name); }
        // The slots, under the label.
        Rectangle {
            x: grid-x;
            y: grid-y;
            width: grid-w;
            height: grid-h;
            for r[i] in App.slots: EquipSlot {
                x: Math.mod(i, 3) * step;
                y: Math.floor(i / 3) * step;
                width: cell;
                height: cell;
                visible: r.slot != 0;
                slot: r;
                shape: Math.floor(i / 3) == 0 ? 0 : Math.floor(i / 3) == rows - 1 ? 2 : 1;
                picked: r.slot != 0 && r.slot == App.equip-slot;
                clicked => { App.open-slot(r.slot); }
            }
        }
        // KotOR II: which weapon set the bottom corners show, as the game's swap button
        if App.has-weapon-sets: Choice {
            // at least as wide as its words (at 1280 by 780 the grid is narrower)
            width: min(side, max(grid-w, 250px * Theme.ts));
            x: (side - self.width) / 2;
            y: grid-y + grid-h + 10px;
            height: 34px * Theme.ts;
            font-size: 13px * Theme.ts;
            options: ["Weapons 1", "Weapons 2"];
            current: App.weapon-set;
            picked(k) => { App.pick-weapon-set(k); }
        }
    }
    Rectangle {
        x: side + 34px;
        width: parent.width - self.x;
        HorizontalLayout {
            x: 0; y: 0;
            height: 24px;
            Label {
                text: App.equip-slot != 0 ? "FITS " + App.equip-slot-name + " · " + App.slot-items.length : "INVENTORY · " + App.items.length;
                horizontal-stretch: 1;
            }
            if App.equip-slot != 0: Link { text: "Show Everything"; vertical-alignment: center; clicked => { App.open-slot(0); } }
        }
        if App.equip-slot == 0: VerticalLayout {
            x: 0;
            y: 32px;
            height: parent.height - 32px - 54px;
            spacing: 14px;
            KindTabs {
                selected: App.inventory-tab;
                chosen(i) => { App.select-inventory-tab(i); }
            }
            Scroller {
            vertical-stretch: 1;
            content-height: App.items.length * 50px;
            VerticalLayout {
                for r[i] in App.items: ItemLine {
                    item: r;
                    stack(v) => { App.set-stack(r.index, v); }
                    remove => { App.remove-item(r.index); }
                }
            }
            }
        }
        // A slot picked: the party's items that fit it, each with Equip.
        if App.equip-slot != 0: HorizontalLayout {
            x: 0; y: 34px;
            height: 38px;
            spacing: 12px;
            Text {
                text: App.equip-slot-item != "" ? "Worn now: " + App.equip-slot-item : "Nothing worn here now.";
                vertical-alignment: center;
                font-family: Theme.body-font;
                font-size: 14px * Theme.ts;
                color: Theme.muted;
                overflow: elide;
                horizontal-stretch: 1;
            }
            if App.equip-slot-item != "": Button { kind: 3; text: "Take It Off"; clicked => { App.unequip-slot(); } }
        }
        if App.equip-slot != 0: Scroller {
            x: 0; y: 82px;
            height: parent.height - self.y - 54px;
            content-height: App.slot-items.length * 50px;
            VerticalLayout {
                for r in App.slot-items: Rectangle {
                    height: 50px;
                    Rectangle { x: 0; y: parent.height - 1px; height: 1px; background: Theme.row-line; }
                    HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 40px;
                                height: 40px;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: Theme.edge;
                                background: Theme.field;
                                clip: true;
                                if r.has-icon: Image { source: r.icon; width: parent.width; height: parent.height; }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text { text: r.name; font-family: Theme.list-font; font-size: 17px * Theme.ts; color: Theme.text; overflow: elide; }
                            Text { text: r.note; font-family: Theme.body-font; font-size: 12px * Theme.ts; color: Theme.faint; overflow: elide; }
                        }
                        VerticalLayout { alignment: center; Button { kind: 3; text: "Equip"; clicked => { App.equip-item(r.id); } } }
                    }
                }
            }
        }
        if App.equip-slot != 0 && App.slot-items.length == 0: Note {
            x: 0; y: 90px;
            width: parent.width;
            text: "Nothing in the party inventory fits here. Add Item finds any item the game has.";
        }
        // Add Item, and Copy from Another Save beside it, under the list.
        HorizontalLayout {
            x: 0;
            y: parent.height - 44px;
            height: 44px;
            spacing: 12px;
            Rectangle {
                horizontal-stretch: 1;
                border-radius: 5px;
                border-width: 1px;
                border-color: fb.has-hover ? Theme.accent : Theme.edge;
                background: fb.has-hover ? Theme.hover : Theme.field;
                HorizontalLayout {
                    alignment: center;
                    spacing: 10px;
                    VerticalLayout { alignment: center; Sign { plus: true; colour: Theme.accent; } }
                    Text { text: "Add Item"; vertical-alignment: center; font-family: Theme.list-font; font-size: 17px * Theme.ts; color: Theme.accent; }
                }
                fb := TouchArea { mouse-cursor: pointer; clicked => { App.open-add-item(); } }
            }
            Button { kind: 3; text: "Copy from Another Save"; clicked => { App.copy-inventory(); } }
        }
    }
}

component PartyTab inherits Rectangle {
    party-head := VerticalLayout {
        x: 0; y: 0;
        height: self.preferred-height;
        spacing: 4px;
        Label { text: "PARTY MEMBERS"; }
        Note { text: "With you: in the active party (two at most).  Recruited: in the party screen.  Can be picked: not held back by the story."; font-size: 12.5px * Theme.ts; }
    }
    Scroller {
        x: 0; y: party-head.height + 8px;
        height: parent.height - self.y - 70px;
        content-height: App.npcs.length * 76px;
        VerticalLayout {
            for n in App.npcs: Rectangle {
                height: 76px;
                Rectangle { x: 0; y: parent.height - 1px; height: 1px; background: Theme.row-line; }
                HorizontalLayout {
                    spacing: 16px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    Rectangle {
                        width: 58px;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: n.in-party ? Theme.gold : Theme.edge;
                        background: Theme.field;
                        clip: true;
                        if n.has-portrait: Image { source: n.portrait; width: parent.width; height: parent.height; }
                    }
                    VerticalLayout {
                        alignment: center;
                        width: 160px;
                        Text { text: n.name; font-family: Theme.list-font; font-size: 19px * Theme.ts; color: n.changed ? Theme.changed : Theme.text; }
                        Text {
                            text: n.in-party ? "In the party" : n.has-creature ? (n.recruited ? "Recruited" : "Not recruited") : "Not met in this save";
                            font-family: Theme.body-font; font-size: 12.5px * Theme.ts; color: Theme.faint;
                        }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        width: 140px;
                        VerticalLayout { alignment: center; Switch { on: n.recruited; enabled: n.has-creature; toggled(v) => { App.set-recruited(n.index, v); } } }
                        Text { text: "Recruited"; vertical-alignment: center; font-family: Theme.body-font; font-size: 14px * Theme.ts; color: n.has-creature ? Theme.muted : Theme.faint; }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        width: 130px;
                        VerticalLayout {
                            alignment: center;
                            Switch {
                                on: n.in-party;
                                enabled: n.has-creature && (n.in-party || App.party-size < 2);
                                toggled(v) => { App.set-in-party(n.index, v); }
                            }
                        }
                        Text { text: "With you"; vertical-alignment: center; font-family: Theme.body-font; font-size: 14px * Theme.ts; color: n.has-creature ? Theme.muted : Theme.faint; }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        width: 160px;
                        VerticalLayout { alignment: center; Switch { on: n.selectable; toggled(v) => { App.set-selectable(n.index, v); } } }
                        Text { text: "Can be picked"; vertical-alignment: center; font-family: Theme.body-font; font-size: 14px * Theme.ts; color: Theme.muted; }
                    }
                    if n.has-influence: HorizontalLayout {
                        spacing: 10px;
                        width: 210px;
                        Text { text: "Influence"; vertical-alignment: center; font-family: Theme.body-font; font-size: 14px * Theme.ts; color: Theme.muted; }
                        VerticalLayout {
                            alignment: center;
                            Stepper { width: 140px; height: 36px; value: n.influence; minimum: 0; maximum: 100; font-size: 17px * Theme.ts; set(v) => { App.set-influence(n.index, v); } }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    VerticalLayout {
                        alignment: center;
                        Button { kind: 3; text: n.has-creature ? "Replace" : "Bring In"; clicked => { App.import-npc(n.index); } }
                    }
                }
            }
        }
    }
    HorizontalLayout {
        x: 0; y: parent.height - 56px;
        height: 56px;
        spacing: 14px;
        VerticalLayout {
            alignment: center;
            Text { text: "Party experience"; font-family: Theme.list-font; font-size: 19px * Theme.ts; color: Theme.text; }
            Note { text: "Members who join later catch up to their share of it."; }
        }
        VerticalLayout {
            alignment: center;
            Field { width: 170px; property <int> epoch: App.pool-epoch; changed epoch => { self.text = App.party-xp; } text: App.party-xp; changed: App.party-xp-changed; accepted(t) => { if t.is-float() { App.set-party-xp(t.to-float()); } else { self.text = App.party-xp; } } }
        }
        Rectangle { horizontal-stretch: 1; }
    }
}

component GlobalsSection inherits Rectangle {
    // the search and the switch show the filter main.rs applies (kept there, so a Compare that
    // turns the switch on, or a visit to another section, never leaves them out of step)
    property <string> query: App.globals-query;
    property <bool> changed-only: App.globals-changed-only;
    // the save's own fields (from the Galaxy Map page, 2026-10-24): its name on the Load
    // screen, the time played, and the console-cheats mark
    property <length> top: 96px;
    HorizontalLayout {
        x: 0; y: 0;
        height: 40px;
        spacing: 12px;
        Text { text: "SAVE NAME"; vertical-alignment: center; font-family: Theme.label-font; font-size: 11px * Theme.ts; letter-spacing: 3px; color: Theme.accent; }
        Field { width: 300px; property <int> epoch: App.pool-epoch; changed epoch => { self.text = App.save-name; } text: App.save-name; changed: App.save-name-changed; accepted(t) => { App.set-save-name(t); } }
        Rectangle { width: 18px; }
        Text { text: "TIME PLAYED"; vertical-alignment: center; font-family: Theme.label-font; font-size: 11px * Theme.ts; letter-spacing: 3px; color: Theme.accent; }
        ph := Field { width: 80px; property <int> epoch: App.pool-epoch; changed epoch => { self.text = App.played-hours; } text: App.played-hours; changed: App.played-changed; accepted(t) => { App.set-played(ph.text, pm.text); } }
        Text { text: "h"; vertical-alignment: center; color: Theme.faint; }
        pm := Field { width: 64px; property <int> epoch: App.pool-epoch; changed epoch => { self.text = App.played-minutes; } text: App.played-minutes; changed: App.played-changed; accepted(t) => { App.set-played(ph.text, pm.text); } }
        Text { text: "min"; vertical-alignment: center; color: Theme.faint; }
        Rectangle { width: 18px; }
        VerticalLayout { alignment: center; Switch { on: App.cheat-used; changed: App.cheat-changed; toggled(v) => { App.set-cheat(v); } } }
        Text { text: "Marked as cheated"; vertical-alignment: center; font-family: Theme.body-font; font-size: 14px * Theme.ts; color: Theme.muted; }
    }
    Note { x: 0; y: 46px; width: parent.width; text: "The save's name on the game's Load screen and its time played (Enter keeps a change); the game marks a save cheated when the console's cheats are used, and turning it off clears the mark."; }
    Rectangle { x: 0; y: 84px; height: 1px; background: Theme.row-line; }
    HorizontalLayout {
        x: 0; y: root.top;
        height: 40px;
        spacing: 14px;
        Field {
            text: App.globals-query;
            placeholder: "Type part of a name, for example tar_ or k_swg";
            font: Theme.body-font;
            font-size: 15px * Theme.ts;
            edited(t) => { App.filter-globals(t, changed-only); }
        }
        HorizontalLayout {
            width: 230px;
            spacing: 10px;
            VerticalLayout { alignment: center; Switch { on: changed-only; toggled(v) => { App.filter-globals(query, v); } } }
            Text { text: App.compare-name != "" ? "Only the differences" : "Only what I changed"; vertical-alignment: center; font-family: Theme.body-font; font-size: 14px * Theme.ts; color: Theme.muted; }
        }
        Button { kind: 3; text: App.compare-name != "" ? "Compare Another" : "Compare with Another Save"; clicked => { App.open-compare(); } }
        if App.compare-name != "": Button { kind: 3; text: "Take All Theirs"; clicked => { App.use-all-other(); } }
    }
    Note { x: 0; y: root.top + 48px; width: parent.width; text: App.globals-note; }
    Scroller {
        x: 0; y: root.top + 76px;
        height: parent.height - root.top - 76px;
        content-height: App.variables.length * 46px;
        VerticalLayout {
            for g in App.variables: Rectangle {
                height: 46px;
                Rectangle { x: 0; y: parent.height - 1px; height: 1px; background: Theme.row-line; }
                HorizontalLayout {
                    spacing: 14px;
                    Text { text: g.name; vertical-alignment: center; font-family: Theme.list-font; font-size: 16px * Theme.ts; color: g.changed ? Theme.changed : Theme.text; overflow: elide; }
                    Text { width: 90px; text: g.kind == 0 ? "switch" : g.kind == 1 ? "number" : "text"; vertical-alignment: center; font-family: Theme.body-font; font-size: 12.5px * Theme.ts; color: Theme.faint; }
                    Rectangle {
                        width: 170px;
                        if g.kind == 0: Switch { x: 0; y: (parent.height - self.height) / 2; on: g.on; changed: g.changed; toggled(v) => { App.set-global-bool(g.index, v); } }
                        if g.kind == 1: Stepper { x: 0; y: 4px; width: 150px; height: 36px; value: g.number; minimum: -128; maximum: 127; changed: g.changed; font-size: 16px * Theme.ts; set(v) => { App.set-global-number(g.index, v); } }
                        if g.kind == 2: Field { y: 4px; height: 36px; text: g.text; changed: g.changed; font-size: 15px * Theme.ts; accepted(t) => { App.set-global-text(g.index, t); } }
                    }
                    if App.compare-name != "": HorizontalLayout {
                        width: 230px;
                        spacing: 8px;
                        Text { text: g.other; vertical-alignment: center; horizontal-alignment: right; font-family: Theme.body-font; font-size: 14px * Theme.ts; color: Theme.gold; overflow: elide; }
                        VerticalLayout { alignment: center; Button { kind: 3; text: "Take"; clicked => { App.use-other(g.index); } } }
                    }
                }
            }
        }
    }
}

component AreaSection inherits Rectangle {
    property <length> half: (self.width - 34px) / 2;
    Rectangle {
        width: half;
        x: 0;
        Label { x: 0; y: 0; text: "DOORS · " + App.doors.length; }
        Note { x: 0; y: 30px; width: parent.width; text: App.area-note; }
        Scroller {
            x: 0; y: 60px;
            height: parent.height - 60px;
            content-height: App.doors.length * 50px;
            VerticalLayout {
                for d in App.doors: Rectangle {
                    height: 50px;
                    Rectangle { x: 0; y: parent.height - 1px; height: 1px; background: Theme.row-line; }
                    HorizontalLayout {
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            Text { text: d.tag; font-family: Theme.list-font; font-size: 16px * Theme.ts; color: d.changed ? Theme.changed : Theme.text; overflow: elide; }
                            Text { text: d.note; font-family: Theme.body-font; font-size: 12px * Theme.ts; color: Theme.faint; overflow: elide; }
                        }
                        VerticalLayout { alignment: center; Switch { on: d.locked; changed: d.changed; toggled(v) => { App.set-door-locked(d.index, v); } } }
                        Text { width: 60px; text: "Locked"; vertical-alignment: center; font-family: Theme.body-font; font-size: 13px * Theme.ts; color: Theme.muted; }
                        VerticalLayout { alignment: center; Switch { on: d.open; changed: d.changed; toggled(v) => { App.set-door-open(d.index, v); } } }
                        Text { width: 46px; text: "Open"; vertical-alignment: center; font-family: Theme.body-font; font-size: 13px * Theme.ts; color: Theme.muted; }
                    }
                }
            }
        }
    }
    Rectangle {
        x: half + 34px;
        width: half;
        Label { x: 0; y: 0; text: "PLAYER POSITION  X  Y  HEIGHT"; }
        HorizontalLayout {
            x: 0; y: 30px;
            height: 40px;
            spacing: 8px;
            px := Field { property <int> epoch: App.pool-epoch; changed epoch => { self.text = App.position-x; } text: App.position-x; changed: App.position-changed; font-size: 15px * Theme.ts; accepted(t) => { App.set-position(px.text, py.text, pz.text); } }
            py := Field { property <int> epoch: App.pool-epoch; changed epoch => { self.text = App.position-y; } text: App.position-y; changed: App.position-changed; font-size: 15px * Theme.ts; accepted(t) => { App.set-position(px.text, py.text, pz.text); } }
            pz := Field { property <int> epoch: App.pool-epoch; changed epoch => { self.text = App.position-z; } text: App.position-z; changed: App.position-changed; font-size: 15px * Theme.ts; accepted(t) => { App.set-position(px.text, py.text, pz.text); } }
        }
        Label { x: 0; y: 92px; text: "CONTAINERS AND STORES"; }
        Scroller {
            x: 0; y: 128px;
            height: (parent.height - 128px) * 0.42;
            content-height: App.boxes.length * 44px;
            VerticalLayout {
                for b[i] in App.boxes: Rectangle {
                    height: 44px;
                    border-radius: 5px;
                    background: i == App.selected-box ? Theme.selected : bt.has-hover ? Theme.hover : transparent;
                    border-width: i == App.selected-box ? 1px : 0px;
                    border-color: Theme.accent;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        Text { text: b.name; vertical-alignment: center; font-family: Theme.list-font; font-size: 16px * Theme.ts; color: Theme.text; overflow: elide; }
                        Text { text: b.note; vertical-alignment: center; horizontal-alignment: right; font-family: Theme.body-font; font-size: 12.5px * Theme.ts; color: Theme.faint; }
                    }
                    bt := TouchArea { mouse-cursor: pointer; clicked => { App.select-box(i); } }
                }
            }
        }
        if App.selected-box >= 0: Rectangle {
            x: 0; y: 128px + (parent.height - 128px) * 0.42 + 12px;
            height: parent.height - self.y;
            HorizontalLayout {
                x: 0; y: 0;
                height: 38px;
                alignment: start;
                Button { kind: 3; text: "Add an Item Here"; clicked => { App.add-box-item(); } }
            }
            Scroller {
                x: 0; y: 48px;
                height: parent.height - 48px;
                content-height: App.box-items.length * 50px;
                VerticalLayout {
                    for r[i] in App.box-items: ItemLine { item: r; editable: true; remove => { App.remove-box-item(i); } stack(v) => { App.set-box-stack(i, v); } }
                }
            }
        }
    }
}

// Galaxy Map and Pazaak (2026-10-24, the maintainer's design): the planets the Ebon Hawk can
// fly to, drawn as the game's own planets on space (a click opens one, green, or closes it,
// grey), and the Pazaak side cards as the game draws them, large, each with how many are
// carried. Only these two: the save's name, time played and cheat mark are in Story Values.
component MoreSection inherits Rectangle {
    // five cards a row where the section is narrow, so the planets keep the room for their
    // whole title (2026-11-06, the maintainer: "in the smaller size make it 5 cards per row and
    // write out the title of both pazaak and planets")
    property <int> columns: self.width < 1250px ? 5 : 6;
    // the planets take what the cards leave, and the cards' columns are never too narrow for
    // their counts (at 1280 by 780 a column of 74 px cut the number between - and +)
    property <length> split: min(self.width * 0.56, self.width - 44px - self.columns * 76px * Theme.ts);
    // a card's column and the card's size
    property <length> cell: (self.width - self.split - 44px) / self.columns;
    property <length> card: min(104px * Theme.ts, self.cell - 16px);
    // the galaxy map
    Rectangle {
        x: 0;
        width: split;
        Label { x: 0; y: 0; width: parent.width; text: "WHERE THE EBON HAWK CAN FLY"; }
        sky-note := Note { x: 0; y: 28px; width: parent.width; text: "Where the Ebon Hawk can fly. Click a planet to open it (green) or close it (grey)."; }
        sky := Rectangle {
            y: 28px + sky-note.preferred-height + 6px;
            height: parent.height - self.y;
            clip: true;
            // space, fading out well inside its edges so no edge of the picture shows
            if Theme.dark: Rectangle {
                property <length> fade: min(self.width, self.height) * 0.32;
                Image { width: parent.width; height: parent.height; source: @image-url("../assets/timeline/stars.png"); image-fit: cover; }
                Rectangle { y: 0; height: parent.fade; background: @linear-gradient(180deg, Theme.panel 0%, Theme.panel.with-alpha(0) 100%); }
                Rectangle { y: parent.height - parent.fade; height: parent.fade; background: @linear-gradient(0deg, Theme.panel 0%, Theme.panel.with-alpha(0) 100%); }
                Rectangle { x: 0; width: parent.fade; background: @linear-gradient(90deg, Theme.panel 0%, Theme.panel.with-alpha(0) 100%); }
                Rectangle { x: parent.width - parent.fade; width: parent.fade; background: @linear-gradient(270deg, Theme.panel 0%, Theme.panel.with-alpha(0) 100%); }
            }
            for p in App.planets: Rectangle {
                property <length> size: min(96px * Theme.ts, min(sky.width / 7.5, sky.height / 5.5));
                width: self.size;
                height: self.size;
                x: 60px + p.x * (sky.width - 120px) - self.width / 2;
                y: 40px + p.y * (sky.height - 100px) - self.height / 2;
                if p.has-globe: Image { width: parent.width; height: parent.height; source: p.on ? p.globe : p.globe-off; }
                // a planet without its texture in this install: a small marker
                if !p.has-globe: Rectangle { width: 14px; height: 14px; border-radius: 7px; background: p.on ? Theme.good : Theme.faint; }
                // open: a green ring; pointed at: a yellow one
                Rectangle {
                    width: parent.width + 8px;
                    height: self.width;
                    border-radius: self.width / 2;
                    border-width: pt.has-hover || p.on ? 3px : 0px;
                    border-color: pt.has-hover ? Theme.hover-edge : Theme.good;
                }
                Text {
                    y: parent.height + 8px;
                    width: 150px;
                    x: (parent.width - self.width) / 2;
                    horizontal-alignment: center;
                    text: p.name;
                    font-family: Theme.list-font;
                    font-size: 13px * Theme.ts;
                    color: p.changed ? Theme.changed : p.on ? Theme.text : Theme.faint;
                    wrap: word-wrap;
                }
                pt := TouchArea { mouse-cursor: pointer; clicked => { App.set-planet(p.index, !p.on); } }
            }
        }
    }
    // the Pazaak side cards
    Rectangle {
        x: split + 44px;
        width: parent.width - self.x;
        Label { x: 0; y: 0; text: "PAZAAK CARDS"; }
        paz-note := Note { x: 0; y: 28px; width: parent.width; text: "Your side deck cards, as the game draws them. Set how many of each you carry."; }
        // under the note however many lines it takes (two at Large text ran under the cards)
        Scroller {
            x: 0;
            y: 28px + paz-note.preferred-height + 10px;
            height: parent.height - self.y - 28px;
            content-height: ceil(App.pazaak.length / root.columns) * (root.card + 60px);
            Rectangle {
                for c[i] in App.pazaak: Rectangle {
                    x: mod(i, root.columns) * root.cell;
                    y: floor(i / root.columns) * (root.card + 60px);
                    width: root.cell;
                    height: root.card + 52px;
                    face := Rectangle {
                        x: (parent.width - self.width) / 2;
                        y: 0;
                        width: root.card;
                        height: self.width;
                        opacity: c.value == 0 ? 0.38 : 1;
                        if c.has-face: Image { width: parent.width; height: parent.height; source: c.face; }
                        // the value, centred in the card's black window
                        Text {
                            y: parent.height * c.label-y - self.height / 2;
                            width: parent.width;
                            horizontal-alignment: center;
                            text: c.label;
                            font-family: Theme.title-font;
                            font-size: 16px * Theme.ts;
                            color: #f2f6fa;
                        }
                    }
                    Stepper {
                        x: (parent.width - self.width) / 2;
                        y: face.height + 8px;
                        width: min(116px, parent.width - 8px);
                        height: 32px;
                        value: c.value;
                        minimum: 0;
                        maximum: 9;
                        changed: c.changed;
                        font-size: 15px * Theme.ts;
                        set(v) => { App.set-pazaak(c.index, v); }
                    }
                }
            }
        }
        Note { x: 0; y: parent.height - 22px; text: App.pazaak-total; }
    }
}

component CreaturesSection inherits Rectangle {
    HorizontalLayout {
        x: 0; y: 0;
        height: 24px;
        Label { text: "CREATURES IN THE AREA · " + App.creatures.length; }
        Note { text: "Taking one out of the area removes it from the save; a creature a quest needs can leave the quest stuck."; horizontal-alignment: right; vertical-alignment: center; }
    }
    Scroller {
        x: 0; y: 36px;
        height: parent.height - 36px;
        content-height: App.creatures.length * 48px;
        VerticalLayout {
            for c in App.creatures: Rectangle {
                height: 48px;
                Rectangle { x: 0; y: parent.height - 1px; height: 1px; background: Theme.row-line; }
                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        alignment: center;
                        Text { text: c.name; font-family: Theme.list-font; font-size: 16px * Theme.ts; color: Theme.text; overflow: elide; }
                        Text { text: c.note; font-family: Theme.body-font; font-size: 12px * Theme.ts; color: Theme.faint; overflow: elide; }
                    }
                    Text { width: 120px; text: "Health " + c.hp + " / " + c.max-hp; vertical-alignment: center; font-family: Theme.body-font; font-size: 13px * Theme.ts; color: Theme.muted; }
                    Rectangle {
                        width: 36px;
                        Cross { colour: cr.has-hover ? Theme.danger : Theme.faint; }
                        cr := TouchArea { mouse-cursor: pointer; clicked => { App.remove-creature(c.index); } }
                    }
                }
            }
        }
    }
}

// The quest tracker: the quests on the left in three tabs (Active first, as a player
// looks for them), the picked quest on the right with its journal entry and every stage
// as a timeline. Finish Quest asks which ending, then puts the quest there.
component JournalSection inherits Rectangle {
    property <length> list-w: min(500px * Theme.ts, self.width * 0.42);
    // The list.
    Choice {
        x: 0; y: 0;
        width: list-w;
        height: 38px;
        // smaller where the list is narrow: at 1280 px "Not Started · 86" was cut
        font-size: min(13px * Theme.ts, list-w / 37);
        options: [
            "Active · " + (App.quest-counts.length > 0 ? App.quest-counts[0] : 0),
            "Completed · " + (App.quest-counts.length > 1 ? App.quest-counts[1] : 0),
            "Not Started · " + (App.quest-counts.length > 2 ? App.quest-counts[2] : 0),
        ];
        current: App.quest-tab;
        picked(i) => { App.select-quest-tab(i); }
    }
    // The quests; the picked one opens into its stages, indented under it on a line, so they
    // read as its list (2026-10-24, the maintainer). A click on a stage shows it on the right.
    Scroller {
        x: 0; y: 52px;
        width: list-w;
        height: parent.height - 52px;
        content-height: App.journal.length * 62px + (App.quest-open ? App.quest-stages.length * 40px + 8px : 0px);
        VerticalLayout {
            spacing: 4px;
            for j[i] in App.journal: VerticalLayout {
                spacing: 0;
                Rectangle {
                    height: 58px;
                    border-radius: 6px;
                    border-width: j.owned ? 1px : jq.has-hover ? 1px : 0px;
                    border-color: j.owned ? Theme.accent : Theme.hover-edge;
                    background: j.owned ? Theme.selected : jq.has-hover ? Theme.hover : transparent;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 10px;
                        // open: pointing down; closed: pointing right
                        VerticalLayout {
                            alignment: center;
                            Path {
                                width: 10px;
                                height: 10px;
                                viewbox-width: 10;
                                viewbox-height: 10;
                                fill: j.owned ? Theme.accent : Theme.soft;
                                commands: j.owned && App.quest-open ? "M 0 2 L 10 2 L 5 8 Z" : "M 2 0 L 8 5 L 2 10 Z";
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            Text { text: j.name; font-family: Theme.list-font; font-size: 16px * Theme.ts; color: j.changed ? Theme.changed : j.owned ? Theme.gold : Theme.text; overflow: elide; }
                            Text { text: j.note; font-family: Theme.body-font; font-size: 12.5px * Theme.ts; color: Theme.faint; overflow: elide; }
                        }
                    }
                    jq := TouchArea { mouse-cursor: pointer; clicked => { App.pick-quest(j.id); } }
                }
                if j.owned && App.quest-open: VerticalLayout {
                    padding-top: 4px;
                    padding-bottom: 4px;
                    for g[k] in App.quest-stages: Rectangle {
                        height: 40px;
                        // the line that holds the list together, and a short branch to each stage
                        Rectangle { x: 22px; y: 0; width: 2px; height: k == App.quest-stages.length - 1 ? parent.height / 2 : parent.height; background: Theme.edge; }
                        Rectangle { x: 22px; y: parent.height / 2 - 1px; width: 14px; height: 2px; background: Theme.edge; }
                        Rectangle {
                            x: 40px;
                            width: parent.width - 40px;
                            height: parent.height - 4px;
                            border-radius: 5px;
                            border-width: k == App.stage-pick ? 2px : sp.has-hover ? 1px : 0px;
                            border-color: Theme.hover-edge;
                            background: k == App.stage-pick ? Theme.hover-edge.with-alpha(0.12) : sp.has-hover ? Theme.hover : transparent;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 10px;
                                // behind: filled; where the quest is: a gold ring; ahead: empty
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: g.place == 1 ? 14px : 10px;
                                        height: self.width;
                                        border-radius: self.width / 2;
                                        border-width: g.place == 1 ? 3px : 1.5px;
                                        border-color: g.place == 1 ? Theme.gold : g.place == 0 ? Theme.accent : Theme.edge;
                                        background: g.place == 0 ? Theme.accent : Theme.field;
                                    }
                                }
                                Text {
                                    text: g.text != "" ? g.text : "Stage " + g.id;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    font-family: Theme.body-font;
                                    font-size: 13.5px * Theme.ts;
                                    color: k == App.stage-pick || g.place == 1 ? Theme.text : g.place == 0 ? Theme.muted : Theme.soft;
                                    overflow: elide;
                                }
                                if g.end: Text { text: "END"; vertical-alignment: center; font-family: Theme.label-font; font-size: 10px * Theme.ts; letter-spacing: 2px; color: Theme.good; }
                            }
                            sp := TouchArea { mouse-cursor: pointer; clicked => { App.pick-stage(g.id); } }
                        }
                    }
                }
            }
        }
    }
    if App.journal.length == 0: Note {
        x: 0; y: 64px;
        width: list-w;
        text: App.quest-tab == 0 ? "No quest is under way in this save." : App.quest-tab == 1 ? "No quest is finished yet." : "Every quest has been started.";
    }

    // The quest.
    if App.quest-shown: Rectangle {
        x: list-w + 34px;
        width: parent.width - self.x;
        VerticalLayout {
            spacing: 12px;
            HorizontalLayout {
                spacing: 14px;
                Text { text: App.quest-title; font-family: Theme.title-font; font-size: 24px * Theme.ts; color: Theme.text; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                // Where it stands, as a small tag.
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        height: 26px;
                        width: tag.preferred-width + 22px;
                        border-radius: 13px;
                        border-width: 1px;
                        border-color: App.quest-state == 0 ? Theme.accent : App.quest-state == 1 ? Theme.good : Theme.edge;
                        tag := Text {
                            text: App.quest-state == 0 ? "ACTIVE" : App.quest-state == 1 ? "COMPLETED" : "NOT STARTED";
                            font-family: Theme.label-font;
                            font-size: 11px * Theme.ts;
                            letter-spacing: 2px;
                            color: App.quest-state == 0 ? Theme.accent : App.quest-state == 1 ? Theme.good : Theme.faint;
                        }
                    }
                }
            }
            // The journal entry where the quest stands, in full.
            Rectangle {
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.edge;
                background: Theme.field;
                height: entry.preferred-height + 28px;
                entry := Text {
                    x: 16px;
                    width: parent.width - 32px;
                    text: App.quest-text;
                    wrap: word-wrap;
                    font-family: Theme.body-font;
                    font-size: 14.5px * Theme.ts;
                    color: Theme.muted;
                }
            }
            // the stage picked in the list, in full, with what it does
            if App.stage-pick >= 0 && App.stage-pick < App.quest-stages.length: Rectangle {
                vertical-stretch: 1;
                property <StageRow> g: App.quest-stages[App.stage-pick];
                VerticalLayout {
                    spacing: 12px;
                    alignment: start;
                    HorizontalLayout {
                        spacing: 12px;
                        Label { text: g.end ? "ENDING" : App.stage-pick == 0 ? "THE BEGINNING" : "STAGE " + (App.stage-pick + 1) + " OF " + App.quest-stages.length; vertical-alignment: center; horizontal-stretch: 1; }
                        if g.xp > 0: Text { text: "+" + g.xp + " XP"; vertical-alignment: center; font-family: Theme.list-font; font-size: 15px * Theme.ts; color: Theme.gold; }
                    }
                    Rectangle {
                        border-radius: 8px;
                        border-width: 2px;
                        border-color: Theme.hover-edge;
                        background: Theme.field;
                        height: stage-entry.preferred-height + 28px;
                        stage-entry := Text {
                            x: 16px;
                            width: parent.width - 32px;
                            text: App.stage-text != "" ? App.stage-text : "Stage " + g.id;
                            wrap: word-wrap;
                            font-family: Theme.body-font;
                            font-size: 14.5px * Theme.ts;
                            color: Theme.text;
                        }
                    }
                    HorizontalLayout {
                        alignment: start;
                        Button {
                            kind: 0;
                            enabled: App.stage-action != 3;
                            text: App.stage-action == 0 ? "Start the Quest"
                                : App.stage-action == 1 ? "Start Quest at This Point"
                                : App.stage-action == 2 ? "Finish the Quest"
                                : "The Quest Is Here";
                            clicked => {
                                if (App.stage-action == 2) {
                                    App.finish-pick = max(0, App.stage-ending);
                                    App.open-finish-quest();
                                } else {
                                    App.set-quest-stage(g.id);
                                }
                            }
                        }
                    }
                    Note { text: App.stage-action == 2 ? "Finishing shows this ending's experience and, if you like, plays the quest's steps on the way to it." : "The quest's experience for reaching this point is given once, as the game gives it."; }
                }
            }
            if App.stage-pick < 0: Note { vertical-stretch: 1; text: "Open the quest on the left and pick one of its stages to see it in full and start or finish the quest there."; }
            // What to do with it.
            HorizontalLayout {
                spacing: 14px;
                alignment: start;
                if App.quest-state != 1 && App.quest-endings.length > 0 && App.stage-pick < 0: Button {
                    width: 240px;
                    kind: 0;
                    text: "Finish Quest";
                    clicked => { App.finish-pick = 0; App.open-finish-quest(); }
                }
                if App.quest-state == 2 && App.quest-stages.length > 0 && App.stage-pick < 0: Button {
                    kind: 1;
                    text: "Start Quest";
                    clicked => { App.set-quest-stage(App.quest-stages[0].id); }
                }
                Rectangle { horizontal-stretch: 1; }
                if App.quest-state != 2: VerticalLayout {
                    alignment: center;
                    Link { text: "Take Out of the Journal"; clicked => { App.remove-quest(); } }
                }
            }
        }
    }
}


// A small arrow on a route stop: moves a free planet one place earlier (left) or later.
component ArrowButton inherits Rectangle {
    in property <bool> left;
    in property <bool> enabled: true;
    callback clicked();
    width: 22px * Theme.ts;
    border-radius: 4px;
    background: at.has-hover && root.enabled ? Theme.accent.with-alpha(0.18) : transparent;
    Path {
        width: 8px * Theme.ts;
        height: 12px * Theme.ts;
        viewbox-width: 8;
        viewbox-height: 12;
        stroke: !root.enabled ? Theme.faint.with-alpha(0.35) : at.has-hover ? Theme.hover-edge : Theme.accent;
        stroke-width: 2px;
        commands: root.left ? "M 7 1 L 1 6 L 7 11" : "M 1 1 L 7 6 L 1 11";
    }
    at := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// The galaxy map (2026-11-06, the maintainer: "the timeline needs to be changed into a
// galaxymap with blue bands of light connecting the planets visited in order a player visited
// them ... in the style of kotor but also intuitive"). The story's main chapters stand where
// the game's own galaxy map puts their planets; bands of blue light join them in the order the
// save played them, and faint lanes run on along the route still ahead. The open save's stop
// has the gold ring, with the Ebon Hawk beside it. Pointing at a stop shows its chapter;
// clicking one opens its pop-up (app.slint, overlay 12) with its quests, to skip to or go back
// to any point in it. Under the map, the route as a row of stops: the free planets there carry
// arrows to choose the order they are played in. The game's other saves wait at the furthest
// stop each has played, a point for one, a larger point with their number for several, which
// opens into a ring of them.
//
// The map is a dark display in light mode too: space is dark, and its lights read only on it.
component GalaxySection inherits Rectangle {
    // the map's own colours, the same in both modes
    property <color> space: #04080f;
    property <color> ink-text: #ecf3f8;
    property <color> ink-soft: #9db1c3;
    property <color> ink-faint: #6d8196;
    property <color> lane-blue: #3d9dff;
    property <color> lane-core: #9fdcff;
    property <color> gold: #e2c35c;
    property <color> hover-gold: #f4d03f;
    property <color> save-green: Theme.k2 ? #60b2ff : #7ee0ab;
    property <int> hover-stop: -1;
    property <int> hover-side: -1;
    property <int> hover-save: -1;
    // A marker of several saves opened: its saves come out from under it into a ring. It stays
    // open while the pointer is inside the ring's circle or on the marker that opened it.
    property <int> open-group: -1;
    property <int> shown-group: -1;
    property <bool> in-ring: area.has-hover && ring.inside(area.mouse-x, area.mouse-y);
    property <int> marker-hover: -1;
    property <bool> keep: open-group >= 0 && (in-ring || marker-hover == open-group);
    changed keep => {
        if (!keep) {
            open-group = -1;
            if (hover-save >= 0 && hover-save < App.tl-saves.length && App.tl-groups[App.tl-saves[hover-save].group].count > 1) {
                hover-save = -1;
            }
        }
    }
    changed open-group => {
        if (open-group >= 0) {
            shown-group = open-group;
        }
    }
    property <float> spread: open-group >= 0 ? 1 : 0;
    animate spread { duration: 220ms; easing: ease-out; }
    function ring(count: int) -> length {
        return max(46px, count * 30px / 6.2832) * Theme.ts;
    }
    // a stop's globe: larger where the save is, smaller ahead
    function size(unit: length, state: int, here: bool) -> length {
        return unit * (here ? 1.0 : state == 0 || state == 4 ? 0.86 : state == 1 || state == 3 ? 0.8 : 0.7);
    }

    VerticalLayout {
        spacing: 8px;
        // Everything that was above the map is in it now (2026-11-06, the maintainer: "Remove the
        // top text, and incorporate it into the map itself, like the buttons below ... like
        // small print, you are here, and the rest of the texts"); only a game with no chapters
        // mapped, which shows no map, says so here.
        if App.gm-stops.length == 0: Note {
            font-size: 13.5px * Theme.ts;
            text: "The editor has no chapters of this game mapped yet.";
        }
        map := Rectangle {
            vertical-stretch: 1;
            min-height: 220px;
            visible: App.gm-stops.length > 0;
            clip: true;
            border-radius: 10px;
            background: root.space;
            border-width: 1px;
            border-color: Theme.dark ? Theme.panel-edge : #2a3d5c;
            // where the stops stand: inside margins that leave room for the names under them,
            // the box (bx, by, bw, bh) the whole map fits at zoom 1
            property <length> base-unit: min(70px * Theme.ts, max(34px, self.height / 6));
            property <length> bx: max(70px * Theme.ts, self.base-unit * 1.2);
            // the planet order's bar along the bottom (its height and the gap under it): the
            // stops' names stand clear of it at zoom 1; the zoom sits in the top right corner,
            // where no stop is
            // the small print along the top (its height and the gap above it)
            property <length> top-h: 10px + head.preferred-height + 4px;
            property <length> bar-h: App.gm-free-note != "" ? 36px * Theme.ts + 8px + 10px : 0px;
            property <length> by: max(self.base-unit * 0.85 + 14px * Theme.ts, self.top-h + self.base-unit * 0.62 + 8px);
            property <length> bb: max(self.base-unit * 0.6 + 34px * Theme.ts, self.bar-h + self.base-unit * 0.5 + 30px * Theme.ts);
            property <length> bw: self.width - 2 * self.bx;
            property <length> bh: self.height - self.by - self.bb;
            // Zoomed with the wheel about the pointer and moved by dragging (2026-11-06, the
            // maintainer: "make the timeline zoomable and movable with mouse"): the box grows
            // by zoom, from 1 (all of it) to 4, and pan moves it, never past its own edges.
            property <float> zoom: 1;
            property <length> pan-x: 0;
            property <length> pan-y: 0;
            property <length> iw: self.bw * self.zoom;
            property <length> ih: self.bh * self.zoom;
            property <length> px: self.bx + max(self.bw - self.iw, min(0px, self.pan-x));
            property <length> pt: self.by + max(self.bh - self.ih, min(0px, self.pan-y));
            // the globes grow more slowly than the distances between them
            property <length> unit: self.base-unit * sqrt(self.zoom);
            // zoom by f, keeping the point under (mx, my) where it is
            function zoom-at(mx: length, my: length, f: float) {
                let ux = (mx - self.px) / self.iw;
                let uy = (my - self.pt) / self.ih;
                let z = max(1, min(4, self.zoom * f));
                self.zoom = z;
                self.pan-x = max(self.bw - self.bw * z, min(0px, mx - ux * self.bw * z - self.bx));
                self.pan-y = max(self.bh - self.bh * z, min(0px, my - uy * self.bh * z - self.by));
            }
            function fit() {
                self.zoom = 1;
                self.pan-x = 0;
                self.pan-y = 0;
            }
            // another save opened (from a tag on this map, the page stays): all of its map
            property <string> opened: App.context-line;
            changed opened => { self.fit(); }
            // the stars, and a faint glow where the galaxy's core is
            Image {
                width: parent.width;
                height: parent.height;
                source: @image-url("../assets/timeline/stars.png");
                image-fit: cover;
                opacity: 0.9;
            }
            Image {
                x: parent.width * 0.12;
                y: -parent.height * 0.1;
                width: parent.width * 0.76;
                height: parent.height * 1.2;
                source: App.gm-glow;
                colorize: #2f6fd8;
                opacity: 0.22;
                image-fit: fill;
            }
            // the display's corners, as the game's own screens frame theirs
            for c in [{ x: 0, y: 0 }, { x: 1, y: 0 }, { x: 0, y: 1 }, { x: 1, y: 1 }]: Rectangle {
                x: c.x == 0 ? 10px : parent.width - 10px - self.width;
                y: c.y == 0 ? 10px : parent.height - 10px - self.height;
                width: 22px;
                height: 22px;
                Rectangle { x: c.x == 0 ? 0 : parent.width - self.width; y: c.y == 0 ? 0 : parent.height - 2px; width: parent.width; height: 2px; background: Theme.accent.with-alpha(0.55); }
                Rectangle { x: c.x == 0 ? 0 : parent.width - 2px; y: c.y == 0 ? 0 : parent.height - self.height; width: 2px; height: parent.height; background: Theme.accent.with-alpha(0.55); }
            }

            // the drag and the wheel, under everything that can be clicked: a press on a planet
            // opens it, a press anywhere else moves the map
            drag := TouchArea {
                property <length> start-x;
                property <length> start-y;
                mouse-cursor: self.pressed && map.zoom > 1.001 ? MouseCursor.grabbing : map.zoom > 1.001 ? MouseCursor.grab : MouseCursor.default;
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down) {
                        self.start-x = map.px - map.bx;
                        self.start-y = map.pt - map.by;
                    }
                }
                moved => {
                    map.pan-x = max(map.bw - map.iw, min(0px, self.start-x + self.mouse-x - self.pressed-x));
                    map.pan-y = max(map.bh - map.ih, min(0px, self.start-y + self.mouse-y - self.pressed-y));
                }
                scroll-event(e) => {
                    if (e.delta-y > 0) {
                        map.zoom-at(self.mouse-x, self.mouse-y, 1.25);
                        return accept;
                    }
                    if (e.delta-y < 0) {
                        map.zoom-at(self.mouse-x, self.mouse-y, 1 / 1.25);
                        return accept;
                    }
                    return reject;
                }
                double-clicked => { map.fit(); }
            }

            // the lanes: faint ahead, bands of light behind; each path in the box of its curve
            // with a margin for the glow (a path is cut at its own bounds), its view that size
            // in pixels (a path keeps its view's shape)
            for l in App.gm-lanes: Rectangle {
                property <length> m: 16px;
                x: map.px + l.x * map.iw - self.m;
                y: map.pt + l.y * map.ih - self.m;
                width: max(1px, l.w * map.iw) + 2 * self.m;
                height: max(1px, l.h * map.ih) + 2 * self.m;
                property <float> vw: self.width / 1px;
                property <float> vh: self.height / 1px;
                property <float> iw: (self.width - 2 * self.m) / 1px;
                property <float> ih: (self.height - 2 * self.m) / 1px;
                property <float> o: self.m / 1px;
                property <string> d: "M " + (self.o + l.ax * self.iw) + " " + (self.o + l.ay * self.ih) + " Q " + (self.o + l.cx * self.iw) + " " + (self.o + l.cy * self.ih) + " " + (self.o + l.bx * self.iw) + " " + (self.o + l.by * self.ih);
                for w[k] in (l.lit ? [24, 11, 4.5, 1.6] : [1.5]): Path {
                    width: parent.width; height: parent.height;
                    viewbox-width: parent.vw; viewbox-height: parent.vh;
                    commands: parent.d;
                    stroke: !l.lit ? #8fb0d8.with-alpha(0.5) : k == 0 ? root.lane-blue.with-alpha(0.13) : k == 1 ? root.lane-blue.with-alpha(0.28) : k == 2 ? root.lane-core.with-alpha(0.85) : #f6fcff;
                    stroke-width: w * 1px;
                }
            }

            // the stops
            for p[i] in App.gm-stops: Rectangle {
                property <length> size: root.size(map.unit, p.state, p.here);
                property <bool> lit: st.has-hover || root.hover-stop == i;
                x: map.px + p.x * map.iw - self.width / 2;
                y: map.pt + p.y * map.ih - self.height / 2;
                width: self.size;
                height: self.size;
                // a halo behind the stop: blue where played, gold where the save is
                if p.state == 0 || p.here: Image {
                    width: parent.width * 1.9;
                    height: self.width;
                    source: App.gm-glow;
                    colorize: p.here ? root.gold : root.lane-blue;
                    opacity: p.here ? 0.55 : 0.45;
                }
                if p.has-globe: Image {
                    width: parent.width;
                    height: parent.height;
                    source: p.globe;
                    opacity: p.state == 2 ? 0.55 : p.state == 3 ? 0.8 : 1.0;
                }
                // without the game's texture: a lit sphere, a ship or a station, drawn
                if !p.has-globe && p.look == 0: Rectangle {
                    width: parent.width * 0.86;
                    height: self.width;
                    border-radius: self.width / 2;
                    opacity: p.state == 2 ? 0.55 : 1.0;
                    background: #35597a;
                    clip: true;
                    Rectangle { x: -parent.width * 0.25; y: -parent.height * 0.25; width: parent.width; height: self.width; border-radius: self.width / 2; background: #6f9cc2; }
                }
                // the ships with a picture (assets/timeline, 2026-11-06, the maintainer's art):
                // the Endar Spire, the Leviathan and the Ravager, larger than the stop's ring as
                // the ships they are, the long ones wider
                property <bool> pictured: p.planet == "Endar Spire" || p.planet == "Leviathan" || p.planet == "Ravager";
                if !p.has-globe && p.look == 1 && self.pictured: Image {
                    width: parent.width * (p.planet == "Endar Spire" ? 1.3 : 1.5);
                    height: parent.height * 1.3;
                    source: p.planet == "Leviathan" ? @image-url("../assets/timeline/leviathan.png")
                        : p.planet == "Ravager" ? @image-url("../assets/timeline/ravager.png")
                        : @image-url("../assets/timeline/endar-spire.png");
                    image-fit: contain;
                    opacity: p.state == 2 ? 0.55 : 1.0;
                }
                if !p.has-globe && p.look == 1 && !self.pictured: Path {
                    width: parent.width * 0.9;
                    height: parent.height * 0.6;
                    viewbox-width: 100;
                    viewbox-height: 60;
                    opacity: p.state == 2 ? 0.55 : 1.0;
                    fill: @linear-gradient(180deg, #d5e3ef 0%, #7f97ad 100%);
                    stroke: #0b1420;
                    stroke-width: 1px;
                    commands: "M 4 30 L 30 18 L 62 14 L 96 26 L 96 34 L 62 46 L 30 42 Z M 40 22 L 58 20 L 58 40 L 40 38 Z";
                }
                if !p.has-globe && p.look == 2: Rectangle {
                    width: parent.width * 0.86;
                    height: self.width;
                    opacity: p.state == 2 ? 0.55 : 1.0;
                    Rectangle {
                        width: parent.width;
                        height: self.width;
                        border-radius: self.width / 2;
                        border-width: 3px;
                        border-color: #c58b3a;
                    }
                    Image { width: parent.width * 1.3; height: self.width; source: App.gm-glow; colorize: #ff9a3c; opacity: 0.8; }
                    Rectangle { width: parent.width * 0.42; height: self.width; border-radius: self.width / 2; background: #ffd27a; }
                    Rectangle { width: parent.width * 0.22; height: self.width; border-radius: self.width / 2; background: #fff6dc; }
                }
                // the ring: gold where the save is, blue where played, yellow when pointed at
                Rectangle {
                    width: parent.width + (p.here ? 12px : 8px);
                    height: self.width;
                    border-radius: self.width / 2;
                    border-width: parent.lit || p.here ? 2px : p.state == 0 || p.state == 3 || p.state == 4 ? 1px : 0px;
                    border-color: parent.lit ? root.hover-gold : p.here ? root.gold : p.state == 0 || p.state == 4 ? root.lane-blue.with-alpha(0.8) : #7d9cc4.with-alpha(0.6);
                }
                // its number on the route
                Rectangle {
                    x: -4px;
                    y: -4px;
                    width: 22px * Theme.ts;
                    height: self.width;
                    border-radius: self.width / 2;
                    background: p.state == 0 ? root.lane-blue : p.here || p.state == 1 ? root.gold : #1b2a3d;
                    border-width: p.state == 4 ? 2px : 1px;
                    border-color: p.state == 0 ? #bfe4ff : p.here || p.state == 1 ? #fff0b8 : p.state == 4 ? root.lane-blue : #4c6582;
                    // centred, then moved up 0.12 and right 0.06 of its size: the title font's digits
                    // sit that far off (measured 2026-11-06: 2 to 2.5 px low, up to 1 px left)
                    Text { x: 0.06 * self.font-size; y: -0.12 * self.font-size; width: parent.width; height: parent.height; horizontal-alignment: center; vertical-alignment: center; text: p.stop; font-family: Theme.title-font; font-size: 12px * Theme.ts; color: p.state == 0 || p.here || p.state == 1 ? #06121e : root.ink-soft; }
                }
                Text {
                    y: parent.height + 6px;
                    x: (parent.width - self.width) / 2;
                    width: 150px * Theme.ts;
                    horizontal-alignment: center;
                    text: p.planet;
                    font-family: Theme.list-font;
                    font-size: 14px * Theme.ts;
                    color: parent.lit ? root.hover-gold : p.here ? root.gold : p.state == 0 || p.state == 4 ? root.ink-text : p.state == 2 ? root.ink-faint : root.ink-soft;
                    wrap: word-wrap;
                }
                st := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { App.open-chapter(p.index); }
                    changed has-hover => {
                        if (self.has-hover) {
                            root.hover-stop = i;
                        } else if (root.hover-stop == i) {
                            root.hover-stop = -1;
                        }
                    }
                }
            }

            // the side chapters: the Ebon Hawk beside the save's stop, Yavin Station at its
            // planet; each opens its pop-up
            for v[i] in App.tl-sides: sv := Rectangle {
                property <bool> hawk: v.look == 1;
                property <length> size: self.hawk ? map.unit * 0.95 : map.unit * 0.7;
                x: map.px + v.x * map.iw - self.width / 2 + (self.hawk ? v.kind * map.unit * 1.3 : 0px);
                y: map.pt + v.y * map.ih - self.height / 2 + (self.hawk ? map.unit * 0.1 : 0px);
                width: self.size;
                height: self.hawk ? self.size * 0.62 : self.size;
                if sv.hawk: Image {
                    width: parent.width;
                    height: parent.height;
                    source: @image-url("../assets/timeline/ebon-hawk.png");
                    image-fit: contain;
                    opacity: sd.has-hover ? 1.0 : 0.9;
                }
                property <bool> station: v.planet == "Yavin Station" && TimelineArt.yavin.width > 0;
                if !sv.hawk && sv.station: Image { width: parent.width * 1.4; height: parent.height * 1.4; source: TimelineArt.yavin; image-fit: contain; opacity: v.state == 0 ? 1.0 : 0.8; }
                if !sv.hawk && !sv.station && v.has-globe: Image { width: parent.width; height: parent.height; source: v.globe; opacity: v.state == 0 ? 1.0 : 0.55; }
                if !sv.hawk && !sv.station && !v.has-globe: Rectangle {
                    width: parent.width * 0.8;
                    height: self.width;
                    border-radius: self.width / 2;
                    background: #a8662e;
                    opacity: v.state == 0 ? 1.0 : 0.55;
                }
                if !sv.hawk || sd.has-hover: Rectangle {
                    width: parent.width + 8px;
                    height: parent.hawk ? parent.height + 8px : self.width;
                    border-radius: parent.hawk ? 6px : self.width / 2;
                    border-width: sd.has-hover || v.here ? 2px : 1px;
                    border-color: sd.has-hover ? root.hover-gold : v.here ? root.gold : #7d9cc4.with-alpha(0.5);
                }
                if !sv.hawk: Text {
                    y: parent.height + 6px;
                    x: (parent.width - self.width) / 2;
                    text: v.planet;
                    font-family: Theme.list-font;
                    font-size: 13px * Theme.ts;
                    color: sd.has-hover ? root.hover-gold : root.ink-soft;
                }
                sd := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { App.open-chapter(v.index); }
                    changed has-hover => {
                        if (self.has-hover) {
                            root.hover-side = i;
                        } else if (root.hover-side == i) {
                            root.hover-side = -1;
                        }
                    }
                }
            }

            // the game's other saves at a stop: a tag low on the right of it, with their number
            for g[gi] in App.tl-groups: Rectangle {
                x: round((map.px + g.x * map.iw + map.unit * 0.42) / 1px) * 1px;
                y: round((map.pt + g.y * map.ih - map.unit * 0.62) / 1px) * 1px;
                opacity: root.open-group >= 0 && root.open-group != gi ? 0 : 1;
                animate opacity { duration: 160ms; }
                width: tag-row.preferred-width + 12px;
                height: 18px * Theme.ts;
                border-radius: self.height / 2;
                border-width: 1px;
                border-color: gt.has-hover ? root.hover-gold : root.save-green;
                background: gt.has-hover ? #10301f : root.space;
                tag-row := HorizontalLayout {
                    x: 6px;
                    width: self.preferred-width;
                    spacing: 4px;
                    // a little save disc
                    Rectangle {
                        width: 9px * Theme.ts;
                        Rectangle { width: parent.width; height: self.width; border-radius: 2px; border-width: 1.5px; border-color: root.save-green; Rectangle { y: 1px; width: parent.width * 0.5; height: parent.height * 0.3; background: root.save-green; } }
                    }
                    Text { text: g.count; font-family: Theme.title-font; font-size: 11px * Theme.ts; color: root.save-green; vertical-alignment: center; }
                }
                gt := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        if (g.count == 1) {
                            App.open-timeline-save(App.tl-saves[g.start].index);
                        }
                    }
                    changed has-hover => {
                        if (self.has-hover) {
                            root.marker-hover = gi;
                            if (g.count == 1) {
                                root.hover-save = g.start;
                            } else {
                                root.open-group = gi;
                            }
                        } else {
                            if (root.marker-hover == gi) {
                                root.marker-hover = -1;
                            }
                            if (g.count == 1 && root.hover-save == g.start) {
                                root.hover-save = -1;
                            }
                        }
                    }
                }
            }

            // a marker of several saves, opened: the ring
            ring := Rectangle {
                property <TimelineGroup> g: root.shown-group >= 0 && root.shown-group < App.tl-groups.length ? App.tl-groups[root.shown-group] : { x: 0, y: 0, count: 0, start: 0 };
                // inside the map whatever stop it opens at, and never taller than the map
                // (2026-11-06: sixteen saves at the Endar Spire ran off the map's top)
                property <length> r: min(root.ring(g.count), (map.height - map.top-h - map.bar-h) / 2 - 30px);
                property <length> reach: self.r + 26px;
                property <length> cx: max(self.reach + 6px, min(map.width - self.reach - 6px, map.px + g.x * map.iw + map.unit * 0.42 + 16px));
                property <length> cy: max(map.top-h + self.reach, min(map.height - map.bar-h - self.reach, map.pt + g.y * map.ih - map.unit * 0.62 + 9px));
                visible: root.spread > 0.01 && g.count > 1;
                x: self.cx - self.reach;
                y: self.cy - self.reach;
                width: 2 * self.reach;
                height: 2 * self.reach;
                Rectangle {
                    width: parent.width * root.spread;
                    height: self.width;
                    border-radius: self.width / 2;
                    background: root.space.with-alpha(0.82);
                    border-width: 1px;
                    border-color: root.save-green.with-alpha(0.35);
                }
                function inside(mx: length, my: length) -> bool {
                    return (mx - self.reach) * (mx - self.reach) / 1px + (my - self.reach) * (my - self.reach) / 1px <= self.reach * self.reach / 1px;
                }
                area := TouchArea {
                    for v[i] in App.tl-saves: Rectangle {
                        visible: v.group == root.shown-group;
                        property <angle> a: (v.slot * 360 / max(1, ring.g.count) - 90) * 1deg;
                        width: rs.has-hover ? 22px : 18px;
                        height: self.width;
                        x: round((ring.reach + cos(self.a) * ring.r * root.spread - self.width / 2) / 1px) * 1px;
                        y: round((ring.reach + sin(self.a) * ring.r * root.spread - self.height / 2) / 1px) * 1px;
                        border-radius: self.width / 2;
                        border-width: rs.has-hover ? 2px : 1px;
                        border-color: rs.has-hover ? root.hover-gold : root.save-green;
                        background: root.space;
                        Rectangle {
                            width: 10px;
                            height: 10px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            border-radius: 5px;
                            background: root.save-green;
                        }
                        rs := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { App.open-timeline-save(v.index); }
                            changed has-hover => {
                                if (self.has-hover) {
                                    root.hover-save = i;
                                } else if (root.hover-save == i) {
                                    root.hover-save = -1;
                                }
                            }
                        }
                    }
                }
                Rectangle {
                    width: 26px;
                    height: 26px;
                    border-radius: 13px;
                    background: root.save-green;
                    Text { x: 0.06 * self.font-size; y: -0.12 * self.font-size; width: parent.width; height: parent.height; horizontal-alignment: center; vertical-alignment: center; text: ring.g.count; font-family: Theme.title-font; font-size: 12px * Theme.ts; color: #06121e; }
                }
            }

            // the zoom: out, in, and back to all of the map; top right, inside the corners
            zoom-box := Rectangle {
                x: map.width - self.width - 36px;
                y: 12px - 4px;
                width: zoom-row.preferred-width + 8px;
                height: 30px * Theme.ts + 8px;
                border-radius: 7px;
                background: root.space.with-alpha(0.8);
            zoom-row := HorizontalLayout {
                x: 4px;
                y: 4px;
                width: self.preferred-width;
                height: 30px * Theme.ts;
                spacing: 6px;
                for b[i] in ["−", "+", "Fit"]: Rectangle {
                    property <bool> on: i == 0 ? map.zoom > 1.001 : i == 1 ? map.zoom < 3.999 : map.zoom > 1.001;
                    width: i == 2 ? zt.preferred-width + 20px : self.height;
                    border-radius: 5px;
                    border-width: 1px;
                    border-color: zb.has-hover && self.on ? root.hover-gold : root.lane-blue.with-alpha(self.on ? 0.6 : 0.25);
                    background: root.space.with-alpha(0.85);
                    zt := Text {
                        text: b;
                        font-family: i == 2 ? Theme.list-font : Theme.body-font;
                        font-size: (i == 2 ? 13px : 18px) * Theme.ts;
                        color: !parent.on ? root.ink-faint : zb.has-hover ? root.hover-gold : root.ink-text;
                    }
                    zb := TouchArea {
                        enabled: parent.on;
                        mouse-cursor: parent.on ? pointer : default;
                        clicked => {
                            if (i == 0) { map.zoom-at(map.width / 2, map.height / 2, 1 / 1.5); }
                            if (i == 1) { map.zoom-at(map.width / 2, map.height / 2, 1.5); }
                            if (i == 2) { map.fit(); }
                        }
                    }
                }
            }
            }

            // The small print along the top, centred, with nothing behind it: where the save is,
            // then what the map shows and how to use it. As wide as the room between the zoom
            // and its mirror on the left allows.
            head := VerticalLayout {
                width: max(200px, map.width - 2 * (zoom-box.width + 52px));
                x: (map.width - self.width) / 2;
                y: 10px;
                height: self.preferred-height;
                spacing: 3px;
                if App.gm-here-text != "": HorizontalLayout {
                    alignment: center;
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle { width: 8px; height: 8px; border-radius: 4px; background: root.gold; }
                    }
                    Text { text: "YOU ARE HERE"; font-family: Theme.label-font; font-size: 10px * Theme.ts; letter-spacing: 2.5px; color: root.gold; vertical-alignment: center; }
                    Text { text: App.gm-here-text; font-family: Theme.list-font; font-size: 13px * Theme.ts; color: root.ink-text; vertical-alignment: center; }
                }
                Text {
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    font-family: Theme.body-font;
                    font-size: 11.5px * Theme.ts;
                    color: root.ink-soft;
                    text: "Bands of light join the planets in the order you played them. Click a planet to see its quests, and to skip ahead or go back."
                        + (App.tl-saves.length > 0 ? " The " + (Theme.k2 ? "blue" : "green") + " tags are your other saves." : "")
                        + " Scroll to zoom, drag to move.";
                }
            }

            // The planet order along the bottom of the map: the free planets in the order the
            // route takes them, each with its stop number and arrows to move it earlier or later;
            // a click opens it, pointing at one lights it on the map. Over the map, so the map
            // keeps its size when it changes. Only as wide as it needs, centred, with nothing
            // behind it but the map: the buttons alone have their backgrounds (2026-11-06, the
            // maintainer: "Make it only as wide as needed and always center the whole bar (make
            // bar transparent but buttons not").
            bar := Rectangle {
                visible: App.gm-free-note != "";
                width: min(map.width - 72px, bar-row.preferred-width);
                x: (map.width - self.width) / 2;
                y: map.height - self.height - 10px;
                height: 36px * Theme.ts + 8px;
                // tighter where the map is narrow (KotOR II's four ran past the map at 1280 px)
                property <bool> tight: map.width < 1300px;
                bar-row := HorizontalLayout {
                    padding: 4px;
                    spacing: bar.tight ? 5px : 8px;
                    // its name, and what the order does under it, where the bar has room (the
                    // sentence beside the chips wrapped to four lines and was cut)
                    if map.width >= 1400px: VerticalLayout {
                        alignment: center;
                        spacing: 1px;
                        Label { text: "PLANET ORDER"; font-size: 12px * Theme.ts; min-width: self.preferred-width; }
                        // under it, what the order does; once it is changed, the way back, in the
                        // same place, so nothing moves when it comes
                        if !App.gm-reordered: Text { text: "Skip Ahead follows it"; font-family: Theme.body-font; font-size: 11px * Theme.ts; color: root.ink-soft; }
                        if App.gm-reordered: Text {
                            text: "Undo order changes";
                            font-family: Theme.body-font;
                            font-size: 11px * Theme.ts;
                            color: undo-link.has-hover ? root.hover-gold : Theme.dark ? Theme.accent : #2ac6ef;
                            undo-link := TouchArea { mouse-cursor: pointer; clicked => { App.route-reset(); } }
                        }
                    }
                    if map.width >= 1400px: Rectangle { width: 4px; }
                    for p[i] in App.gm-stops: HorizontalLayout {
                        visible: p.free;
                        width: p.free ? self.preferred-width : 0px;
                        spacing: 0;
                        if p.free: chip := Rectangle {
                            property <bool> lit: ct.has-hover || root.hover-stop == i;
                            width: chip-row.preferred-width + 10px;
                            border-radius: 5px;
                            border-width: 1px;
                            border-color: self.lit ? Theme.hover-edge : p.here ? Theme.gold : Theme.accent.with-alpha(0.45);
                            background: self.lit ? Theme.hover : p.here ? Theme.gold.with-alpha(0.08) : Theme.field;
                            ct := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { App.open-chapter(p.index); }
                                changed has-hover => {
                                    if (self.has-hover) {
                                        root.hover-stop = i;
                                    } else if (root.hover-stop == i) {
                                        root.hover-stop = -1;
                                    }
                                }
                            }
                            chip-row := HorizontalLayout {
                                x: 5px;
                                width: self.preferred-width;
                                height: parent.height;
                                spacing: bar.tight ? 3px : 6px;
                                ArrowButton { left: true; enabled: p.earlier; clicked => { App.route-move(p.index, -1); } }
                                Rectangle {
                                    width: 20px * Theme.ts;
                                    Rectangle {
                                        width: parent.width;
                                        height: self.width;
                                        border-radius: self.width / 2;
                                        background: p.state == 0 ? Theme.accent : p.here || p.state == 1 ? Theme.gold : transparent;
                                        border-width: p.state == 0 || p.here || p.state == 1 ? 0px : p.state == 4 ? 2px : 1px;
                                        border-color: p.state == 4 ? Theme.accent : Theme.edge;
                                        Text { x: 0.06 * self.font-size; y: -0.12 * self.font-size; width: parent.width; height: parent.height; horizontal-alignment: center; vertical-alignment: center; text: p.stop; font-family: Theme.title-font; font-size: 11px * Theme.ts; color: p.state == 0 || p.here || p.state == 1 ? Theme.ink : p.state == 4 ? Theme.text : Theme.soft; }
                                    }
                                }
                                Text {
                                    text: p.chip;
                                    font-family: Theme.list-font;
                                    font-size: (bar.tight ? 12.5px : 14px) * Theme.ts;
                                    vertical-alignment: center;
                                    color: p.here || p.state == 1 ? Theme.gold : p.state == 0 || p.state == 4 || chip.lit ? Theme.text : Theme.soft;
                                }
                                ArrowButton { left: false; enabled: p.later; clicked => { App.route-move(p.index, 1); } }
                            }
                        }
                    }
                }
            }
            // where the map is too narrow for the order's name, Undo floats centred just above the
            // order, so the order stays centred and does not move when it comes (its room kept in
            // the row pushed the order 37 px off centre at 1280 px)
            if bar.visible && map.width < 1400px && App.gm-reordered: Rectangle {
                x: (map.width - self.width) / 2;
                y: bar.y - self.height;
                height: 26px * Theme.ts;
                width: reset-text.preferred-width + 24px;
                border-radius: self.height / 2;
                border-width: 1px;
                border-color: rt.has-hover ? Theme.hover-edge : Theme.edge;
                background: rt.has-hover ? Theme.hover : Theme.field;
                reset-text := Text { text: "Undo order changes"; font-family: Theme.body-font; font-size: 12.5px * Theme.ts; color: Theme.text; }
                rt := TouchArea { mouse-cursor: pointer; clicked => { App.route-reset(); } }
            }

            // a stop pointed at: its chapter, above it (below it near the top)
            if root.hover-stop >= 0 && root.hover-stop < App.gm-stops.length: Rectangle {
                property <GalaxyStop> p: App.gm-stops[root.hover-stop];
                property <length> cx: map.px + p.x * map.iw;
                property <length> cy: map.pt + p.y * map.ih;
                property <length> half: root.size(map.unit, p.state, p.here) / 2 + 30px;
                Rectangle {
                    width: 300px * Theme.ts;
                    height: tip.preferred-height;
                    x: max(8px, min(parent.cx - self.width / 2, map.width - self.width - 8px));
                    y: parent.cy - parent.half - self.height >= 8px ? parent.cy - parent.half - self.height : parent.cy + parent.half + 24px;
                    background: #0a1424.with-alpha(0.96);
                    border-width: 1px;
                    border-color: root.lane-blue.with-alpha(0.6);
                    border-radius: 6px;
                    tip := VerticalLayout {
                        padding: 12px;
                        padding-left: 14px;
                        spacing: 4px;
                        Text {
                            text: "STOP " + p.stop + "  ·  " + (p.state == 0 ? "PLAYED" : p.state == 1 ? "YOU ARE IN IT" : p.state == 4 ? "BEGUN, NOT FINISHED" : p.state == 3 ? "YOUR NEXT STOP" : "AHEAD");
                            font-family: Theme.label-font;
                            font-size: 10px * Theme.ts;
                            letter-spacing: 2.5px;
                            color: p.state == 0 || p.state == 4 ? root.lane-core : p.state == 1 ? root.gold : root.ink-soft;
                        }
                        Text { text: p.planet; font-family: Theme.list-font; font-size: 18px * Theme.ts; color: root.ink-text; }
                        Text { text: p.title; font-family: Theme.body-font; font-size: 13px * Theme.ts; color: root.ink-soft; wrap: word-wrap; }
                        Text {
                            text: p.state == 0 ? "Click to see its quests and go back to any point in it"
                                : p.state == 1 || p.state == 4 ? "Click to see its quests and go back or skip ahead"
                                : "Click to see its quests and skip ahead to any point in it";
                            font-family: Theme.body-font;
                            font-size: 13px * Theme.ts;
                            color: Theme.dark ? Theme.accent : #2ac6ef;
                            wrap: word-wrap;
                        }
                    }
                }
            }
            // a side chapter pointed at
            if root.hover-side >= 0 && root.hover-side < App.tl-sides.length: Rectangle {
                property <GalaxyStop> v: App.tl-sides[root.hover-side];
                property <bool> hawk: v.look == 1;
                property <length> cx: map.px + v.x * map.iw + (self.hawk ? v.kind * map.unit * 1.3 : 0px);
                property <length> cy: map.pt + v.y * map.ih + (self.hawk ? map.unit * 0.1 : 0px);
                Rectangle {
                    width: 280px * Theme.ts;
                    height: side-tip.preferred-height;
                    x: max(8px, min(parent.cx - self.width / 2, map.width - self.width - 8px));
                    y: parent.cy + map.unit * 0.7 + self.height <= map.height - 8px ? parent.cy + map.unit * 0.7 : parent.cy - map.unit * 0.7 - self.height;
                    background: #0a1424.with-alpha(0.96);
                    border-width: 1px;
                    border-color: root.lane-blue.with-alpha(0.6);
                    border-radius: 6px;
                    side-tip := VerticalLayout {
                        padding: 12px;
                        padding-left: 14px;
                        spacing: 4px;
                        Text { text: "SIDE CHAPTER  ·  " + (v.state == 0 ? "PLAYED" : "NOT PLAYED"); font-family: Theme.label-font; font-size: 10px * Theme.ts; letter-spacing: 2.5px; color: root.ink-soft; }
                        Text { text: v.planet; font-family: Theme.list-font; font-size: 18px * Theme.ts; color: root.ink-text; }
                        Text { text: v.title; font-family: Theme.body-font; font-size: 13px * Theme.ts; color: root.ink-soft; wrap: word-wrap; }
                        Text { text: "Off the main route. Click to see its quests"; font-family: Theme.body-font; font-size: 13px * Theme.ts; color: Theme.dark ? Theme.accent : #2ac6ef; wrap: word-wrap; }
                    }
                }
            }

            // a save pointed at: its card beside its marker (or the ring it is in)
            if root.hover-save >= 0 && root.hover-save < App.tl-saves.length: card := Rectangle {
                property <TimelineSave> v: App.tl-saves[root.hover-save];
                property <TimelineGroup> g: App.tl-groups[v.group];
                property <length> cx: g.count > 1 ? ring.cx : map.px + g.x * map.iw + map.unit * 0.42 + 16px;
                property <length> cy: g.count > 1 ? ring.cy : map.pt + g.y * map.ih - map.unit * 0.62 + 9px;
                property <length> side: g.count > 1 ? ring.r + 34px : 30px;
                Rectangle {
                    width: 430px * Theme.ts;
                    height: 146px * Theme.ts;
                    x: parent.cx + parent.side + self.width <= map.width ? parent.cx + parent.side : max(0px, parent.cx - parent.side - self.width);
                    y: max(0px, min(parent.cy - self.height / 2, map.height - self.height));
                    background: #0a1424.with-alpha(0.97);
                    border-width: 1px;
                    border-color: root.save-green;
                    border-radius: 6px;
                    HorizontalLayout {
                        padding: 12px;
                        spacing: 12px;
                        Rectangle {
                            width: self.height * 1.25;
                            border-radius: 3px;
                            background: #000000;
                            clip: true;
                            if v.has-shot: Image { width: parent.width; height: parent.height; source: v.shot; image-fit: cover; }
                        }
                        VerticalLayout {
                            spacing: 3px;
                            alignment: start;
                            Text { text: "YOUR SAVE"; font-family: Theme.label-font; font-size: 10px * Theme.ts; letter-spacing: 2.5px; color: root.save-green; }
                            Text { text: v.name; font-family: Theme.list-font; font-size: 17px * Theme.ts; color: root.ink-text; overflow: elide; }
                            Text { text: v.area; font-size: 13px * Theme.ts; color: root.ink-soft; wrap: word-wrap; }
                            Text { text: v.story; font-size: 13px * Theme.ts; color: root.ink-text; }
                            Text { text: "Played " + v.time; font-size: 13px * Theme.ts; color: root.ink-soft; }
                            if v.level != "": Text { text: v.level; font-size: 13px * Theme.ts; color: root.ink-soft; }
                        }
                    }
                }
            }
        }

    }
}


// Story and Advanced: their sections as tabs under the main tab bar, a thin line between
// each two (2026-10-24, the maintainer: Story holds the timeline, the quests and the galaxy
// map with Pazaak; Advanced the raw data modders want). The section numbers stay as main.rs
// knows them (0 globals, 1 area, 2 creatures, 3 quests, 4 more, 5 timeline); -1 is a line.
component StoryTab inherits Rectangle {
    in property <[{ name: string, section: int }]> items;
    VerticalLayout {
        spacing: 0;
        HorizontalLayout {
            height: 44px * Theme.ts;
            alignment: start;
            for s in root.items: Rectangle {
                width: s.section < 0 ? 21px : label.preferred-width + 36px;
                if s.section < 0: Rectangle { x: 10px; y: 9px; width: 1px; height: 18px; background: Theme.edge; }
                label := Text {
                    visible: s.section >= 0;
                    text: s.name;
                    y: 6px;
                    font-family: Theme.list-font;
                    font-size: 16px * Theme.ts;
                    color: s.section == App.story-section || st.has-hover ? Theme.text : Theme.soft;
                }
                if s.section == App.story-section: Rectangle { y: parent.height - 3px; height: 2px; background: Theme.accent; }
                st := TouchArea { enabled: s.section >= 0; mouse-cursor: s.section >= 0 ? pointer : default; clicked => { App.select-story(s.section); } }
            }
        }
        Rectangle { height: 1px; background: Theme.row-line; }
        Rectangle { height: 18px; }
        Rectangle {
            vertical-stretch: 1;
            if App.story-section == 0: GlobalsSection { }
            if App.story-section == 1: AreaSection { }
            if App.story-section == 2: CreaturesSection { }
            if App.story-section == 3: JournalSection { }
            if App.story-section == 4: MoreSection { }
        }
    }
}

// The area as the game's own map, with everything that can be clicked: doors, exits,
// containers, things to use, people and map notes. A pick shows what it is and where the
// player can stand next to it; Move Here puts the player there.
component MapTab inherits Rectangle {
    // The map leads: it takes everything but the rail on the right, which holds the
    // area's name and one of three panes (2026-10-22, the maintainer: "make the map the
    // biggest thing ... the rest of the menus on the right side").
    // The map takes everything but the rail: its frame fills the room left of the zoom
    // buttons and above the key, the picture as large as fits inside.
    property <length> rail: 300px * Theme.ts;
    // 0 what is picked, 1 the areas, 2 help when stuck.
    property <int> pane: 0;
    changed pick-title => { pane = 0; }
    property <string> pick-title: App.pick-title;
    // The view: how far in (1 is the whole map) and the map point (0 to 1) at its middle.
    property <float> zoom: 1;
    property <float> cx: 0.5;
    property <float> cy: 0.5;
    property <string> shown: App.map-title;
    changed shown => {
        zoom = 1;
        cx = 0.5;
        cy = 0.5;
    }
    // A middle point that keeps the view on the map.
    function keep(c: float) -> float {
        return max(0.5 / zoom, min(1 - 0.5 / zoom, c));
    }
    // Zooms by `f`, the map point under (fx, fy) of the view staying where it is.
    function zoom-by(f: float, fx: float, fy: float) {
        let px = cx + (fx - 0.5) / zoom;
        let py = cy + (fy - 0.5) / zoom;
        zoom = max(1, min(6, zoom * f));
        cx = keep(px - (fx - 0.5) / zoom);
        cy = keep(py - (fy - 0.5) / zoom);
    }
    // The map.
    Rectangle {
        x: 0;
        width: parent.width - rail - 20px;
        frame := Rectangle {
            // The whole map at zoom 1, as large as fits; at this zoom; and where its corner is.
            property <length> base-w: min(self.width, self.height * App.map-aspect);
            property <length> cw: self.base-w * zoom;
            property <length> ch: self.cw / App.map-aspect;
            property <length> ox: self.width / 2 - cx * self.cw;
            property <length> oy: self.height / 2 - cy * self.ch;
            x: 0;
            y: 0;
            // Room for the key below it; the zoom buttons sit inside, on its right.
            width: parent.width;
            height: parent.height - 50px;
            border-radius: 6px;
            border-width: 1px;
            border-color: Theme.edge;
            background: #05080c;
            clip: true;
            if App.has-map: Image {
                x: frame.ox;
                y: frame.oy;
                width: frame.cw;
                height: frame.ch;
                source: App.map-picture;
                source-clip-x: 0;
                source-clip-y: 0;
                source-clip-width: Math.round(App.map-picture.width * App.map-clip);
                source-clip-height: App.map-picture.height;
                image-fit: fill;
            }
            if !App.has-map: Text { text: "This area has no map picture"; color: Theme.faint; font-family: Theme.body-font; font-size: 14px * Theme.ts; }
            // A click picks a floor spot; zoomed in, a drag moves the view; the wheel zooms.
            aim := TouchArea {
                property <bool> dragged;
                property <float> from-x;
                property <float> from-y;
                // The system crosshair is drawn inverted (see-through on the map); the map
                // draws its own, in the accent colour (below).
                mouse-cursor: self.dragged && self.pressed ? MouseCursor.grabbing : MouseCursor.none;
                pointer-event(e) => {
                    if e.kind == PointerEventKind.down {
                        self.dragged = false;
                        self.from-x = cx;
                        self.from-y = cy;
                    }
                }
                moved => {
                    if zoom > 1 && abs(self.mouse-x - self.pressed-x) + abs(self.mouse-y - self.pressed-y) > 4px {
                        self.dragged = true;
                    }
                    if self.dragged {
                        cx = keep(self.from-x - (self.mouse-x - self.pressed-x) / frame.cw);
                        cy = keep(self.from-y - (self.mouse-y - self.pressed-y) / frame.ch);
                    }
                }
                clicked => {
                    if !self.dragged {
                        App.map-click((self.mouse-x - frame.ox) / frame.cw, (self.mouse-y - frame.oy) / frame.ch);
                    }
                }
                scroll-event(e) => {
                    if e.delta-y != 0 {
                        zoom-by(e.delta-y > 0 ? 1.25 : 0.8, 0.5 + (self.mouse-x - frame.width / 2) / frame.base-w, 0.5 + (self.mouse-y - frame.height / 2) / (frame.base-w / App.map-aspect));
                        return accept;
                    }
                    return reject;
                }
            }
            // The markers stay one size at any zoom.
            Rectangle {
                x: frame.ox;
                y: frame.oy;
                width: frame.cw;
                height: frame.ch;
                for m in App.map-marks: Rectangle {
                    property <length> size: m.kind == 7 ? 14px : m.selected ? 34px : 26px;
                    x: m.x * parent.width - self.size / 2;
                    y: m.y * parent.height - self.size / 2;
                    width: self.size;
                    height: self.size;
                    if m.has-face: Image { width: parent.width; height: parent.height; source: m.face; }
                    // The ring says the kind at a glance; white when picked.
                    Rectangle {
                        border-radius: self.width / 2;
                        border-width: m.selected ? 2.5px : 1.5px;
                        border-color: m.selected ? #ffffff
                            : m.kind == 7 ? #ffffff
                            : m.kind == 0 ? #c9d2dc
                            : m.kind == 1 ? #ff9a3c
                            : m.kind == 2 ? #7ee0ab
                            : m.kind == 3 ? #60b2ff
                            : m.kind == 4 ? #ff6b6b
                            : #ffffff;
                        background: m.has-face ? transparent : m.kind == 7 ? #2ac6ef : #c9d2dc;
                    }
                    mt := TouchArea {
                        enabled: m.kind != 7;
                        mouse-cursor: pointer;
                        clicked => { App.pick-mark(m.index); }
                    }
                    // The name, to the side with room in the view.
                    if mt.has-hover: Rectangle {
                        property <bool> left: frame.ox + m.x * frame.cw > frame.width - self.width - 40px;
                        x: self.left ? -self.width - 6px : parent.width + 6px;
                        y: (parent.height - 24px) / 2;
                        width: tip.preferred-width + 16px;
                        height: 24px;
                        border-radius: 4px;
                        background: #000000d8;
                        tip := Text { text: m.name; color: #ffffff; font-family: Theme.body-font; font-size: 12.5px * Theme.ts; }
                    }
                }
                // You: the game's own map arrow, turned the way the player faces.
                if App.map-you: Rectangle {
                    x: App.map-you-x * parent.width - 24px;
                    y: App.map-you-y * parent.height - 24px;
                    width: 48px;
                    height: 48px;
                    if App.has-arrow: Image {
                        x: 8px;
                        y: 8px;
                        width: 32px;
                        height: 32px;
                        image-fit: contain;
                        source: App.map-arrow;
                        transform-rotation: App.map-you-angle * 1deg;
                    }
                    if !App.has-arrow: Rectangle { border-radius: 9px; width: 18px; height: 18px; background: #e2c35c; }
                }
            }
        }
        // The pointer over the map: a solid crosshair, a dark edge round the accent so it
        // reads on light and dark parts of the picture.
        if aim.has-hover && !(aim.dragged && aim.pressed): Rectangle {
            x: frame.x + aim.mouse-x - 12px;
            y: frame.y + aim.mouse-y - 12px;
            width: 24px;
            height: 24px;
            Rectangle { x: 10px; y: 0; width: 4px; height: 24px; background: #000000a0; }
            Rectangle { x: 0; y: 10px; width: 24px; height: 4px; background: #000000a0; }
            Rectangle { x: 11px; y: 1px; width: 2px; height: 22px; background: Theme.accent; }
            Rectangle { x: 1px; y: 11px; width: 22px; height: 2px; background: Theme.accent; }
        }
        // Zoom: + and - inside the map on its right, in the dark beside the picture.
        Rectangle {
            property <length> half: 40px;
            x: frame.x + frame.width - self.width - 12px;
            y: frame.y + (frame.height - self.height) / 2;
            width: 38px;
            height: self.half * 2;
            border-radius: 6px;
            border-width: 1px;
            border-color: Theme.edge;
            background: Theme.field;
            clip: true;
            zin := TouchArea {
                y: 0;
                height: parent.half;
                enabled: zoom < 6;
                mouse-cursor: self.enabled ? MouseCursor.pointer : MouseCursor.default;
                clicked => { zoom-by(1.5, 0.5, 0.5); }
            }
            zout := TouchArea {
                y: parent.half;
                height: parent.half;
                enabled: zoom > 1;
                mouse-cursor: self.enabled ? MouseCursor.pointer : MouseCursor.default;
                clicked => { zoom-by(1 / 1.5, 0.5, 0.5); }
            }
            if zin.has-hover && zin.enabled: Rectangle { y: 0; height: parent.half; background: Theme.hover; }
            if zout.has-hover && zout.enabled: Rectangle { y: parent.half; height: parent.half; background: Theme.hover; }
            Rectangle { x: 7px; y: parent.half; width: parent.width - 14px; height: 1px; background: Theme.edge; }
            // + and - drawn as bars: crisp at every scale, no glyph needed.
            Rectangle {
                x: (parent.width - 14px) / 2;
                y: parent.half / 2 - 1px;
                width: 14px;
                height: 2px;
                background: !zin.enabled ? Theme.faint : zin.has-hover ? Theme.accent : Theme.text;
            }
            Rectangle {
                x: (parent.width - 2px) / 2;
                y: parent.half / 2 - 7px;
                width: 2px;
                height: 14px;
                background: !zin.enabled ? Theme.faint : zin.has-hover ? Theme.accent : Theme.text;
            }
            Rectangle {
                x: (parent.width - 14px) / 2;
                y: parent.half * 1.5 - 1px;
                width: 14px;
                height: 2px;
                background: !zout.enabled ? Theme.faint : zout.has-hover ? Theme.accent : Theme.text;
            }
        }
        // The key, with the same round game icons.
        // larger and centred under the map (2026-10-24, the maintainer)
        key := HorizontalLayout {
            property <bool> tight: frame.width < 900px * Theme.ts;
            x: max(0px, frame.x + (frame.width - self.width) / 2);
            y: frame.y + frame.height + 10px;
            width: self.preferred-width;
            height: 32px;
            spacing: self.tight ? 12px : 26px;
            HorizontalLayout {
                spacing: key.tight ? 5px : 8px;
                Image { width: key.tight ? 22px : 28px; height: self.width; source: App.map-arrow; image-fit: contain; }
                Text { text: "You"; vertical-alignment: center; font-family: Theme.list-font; font-size: (key.tight ? 13px : 16px) * Theme.ts; color: Theme.muted; }
            }
            for k[i] in ["Door", "Way out", "Container", "To use", "Person", "Map note"]: HorizontalLayout {
                spacing: key.tight ? 5px : 8px;
                Image { width: key.tight ? 22px : 28px; height: self.width; source: App.map-icons[i]; }
                Text { text: k; vertical-alignment: center; font-family: Theme.list-font; font-size: (key.tight ? 13px : 16px) * Theme.ts; color: Theme.muted; }
            }
        }
    }
    // The rail: the area's name, a switch, and the pane it picks.
    VerticalLayout {
        x: parent.width - rail;
        width: rail;
        spacing: 8px;
        Text { text: App.map-title; font-family: Theme.title-font; font-size: 19px * Theme.ts; color: Theme.text; overflow: elide; }
        Note { text: App.map-note; font-size: 12.5px * Theme.ts; }
        Choice {
            height: 34px;
            font-size: 14px * Theme.ts;
            options: ["Picked", "Areas", "Stuck?"];
            current: pane;
            picked(i) => { pane = i; }
        }
        Rectangle { height: 6px; }
        if pane == 0: VerticalLayout {
            vertical-stretch: 1;
            spacing: 10px;
            alignment: start;
            Text { text: App.pick-title; font-family: Theme.title-font; font-size: 16px * Theme.ts; color: Theme.text; wrap: word-wrap; }
            Note { text: App.pick-note; font-size: 12.5px * Theme.ts; }
            Rectangle { height: 2px; }
            if App.pick-can-move: Button { kind: 0; compact: true; text: App.pick-move-label; font-size: 15px * Theme.ts; clicked => { App.move-here(0); } }
            if App.pick-has-second: Button { kind: 1; compact: true; text: App.pick-second-label; font-size: 15px * Theme.ts; clicked => { App.move-here(1); } }
            if App.map-here: Button { kind: 1; compact: true; enabled: App.pick-can-spawn; text: "Spawn a Creature"; font-size: 15px * Theme.ts; clicked => { App.spawn-here(); } }
            if App.map-here && !App.pick-can-spawn: Note { font-size: 12.5px * Theme.ts; text: "Click a spot on the floor of the map to choose where a creature appears."; }
            if App.pick-can-remove: Button { kind: 4; compact: true; text: "Remove " + App.pick-title; font-size: 15px * Theme.ts; clicked => { App.remove-pick(); } }
            if App.pick-can-remove: Note { font-size: 12.5px * Theme.ts; text: "Added with this editor, so it can be taken out again. The area's own creatures stay."; }
            if App.pick-is-exit: Button { kind: 3; text: "Show Where It Leads"; clicked => { App.follow-exit(); } }
            // Another area: go there the way the game does, arriving at one of its ways in.
            if !App.map-here && App.travel-ways.length > 0: Rectangle { height: 6px; }
            if !App.map-here && App.travel-ways.length > 0: Label { text: "TRAVEL HERE"; }
            if !App.map-here && App.travel-ways.length > 0: Note { font-size: 12.5px * Theme.ts; text: "The game takes you there right after the save loads, as if you walked in."; }
            for w[i] in (App.map-here ? [] : App.travel-ways): Button { kind: 3; text: w.name; clicked => { App.travel(w.id); } }
            if App.pick-can-unlock: Button { kind: 3; text: "Unlock"; clicked => { App.unlock-pick(); } }
        }
        if pane == 1: Scroller {
            vertical-stretch: 1;
            content-height: App.map-areas.length * 52px;
            VerticalLayout {
                for a in App.map-areas: Rectangle {
                    height: a.header ? 46px : 50px;
                    border-radius: 5px;
                    border-width: a.viewing ? 1px : 0px;
                    border-color: Theme.accent;
                    background: a.viewing ? Theme.selected : at.has-hover ? Theme.hover : transparent;
                    // A planet: a chevron, its name, how many areas; a click opens or closes it.
                    if a.header: HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        spacing: 8px;
                        Path {
                            width: 12px;
                            height: 12px;
                            y: (parent.height - self.height) / 2;
                            viewbox-width: 12;
                            viewbox-height: 12;
                            stroke: Theme.accent;
                            stroke-width: 2px;
                            commands: a.open ? "M 2 4 L 6 8 L 10 4" : "M 4 2 L 8 6 L 4 10";
                        }
                        VerticalLayout {
                            alignment: center;
                            Text { text: a.name; font-family: Theme.label-font; font-size: 13px * Theme.ts; letter-spacing: 2px; color: a.current ? Theme.gold : Theme.text; overflow: elide; }
                            Text { text: a.note; font-family: Theme.body-font; font-size: 11px * Theme.ts; color: Theme.faint; overflow: elide; }
                        }
                    }
                    if !a.header: VerticalLayout {
                        padding-left: 28px;
                        padding-right: 6px;
                        alignment: center;
                        Text { text: a.name; font-family: Theme.list-font; font-size: 15px * Theme.ts; color: a.current ? Theme.gold : a.visited ? Theme.text : Theme.soft; overflow: elide; }
                        Text { text: a.note; font-family: Theme.body-font; font-size: 11.5px * Theme.ts; color: Theme.faint; overflow: elide; }
                    }
                    at := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            if (a.header) { App.toggle-planet(a.planet); } else { App.view-area(a.module); }
                        }
                    }
                }
            }
        }
        if pane == 2: VerticalLayout {
            vertical-stretch: 1;
            spacing: 10px;
            alignment: start;
            Note { font-size: 12.5px * Theme.ts; text: "Move to any marked place, or click the floor. Every spot is checked to be walkable floor with room around it, out of the walls."; }
            Button { kind: 3; text: "Open Every Door Here"; clicked => { App.open-all-doors(); } }
            Note { font-size: 12.5px * Theme.ts; text: "A quest that will not move on: Quests, pick it and choose its ending."; }
        }
    }
}

export component EditorPage inherits Rectangle {
    // Save Changes' menu, open under its arrow
    property <bool> save-menu;
    // Below 1500 px the party list shows portraits only and the tabs sit closer, so the tab's
    // columns keep their room (2026-11-06: at 1280 by 780 the Name box showed three letters
    // and "Advanced" ran off the window).
    property <bool> slim: self.width < 1500px;
    // Back to the saves, top left before the crest.
    BackArrow {
        x: 50px;
        y: 67px;
        clicked => { App.back(); }
    }
    // Tabs
    tabs := Rectangle {
        x: 60px;
        y: 170px;
        width: parent.width - 120px;
        height: 48px;
        Rectangle { x: 0; y: parent.height - 1px; height: 1px; background: Theme.edge; }
        // the tabs' words and the room after each
        property <length> tab-font: (root.slim ? 17px : 18px) * Theme.ts;
        property <length> tab-pad: 24px;
        // The tabs as they would be with the new tab's whole name, measured unseen: the whole
        // name only where it fits, else "Pazaak" (at 1600 by 900 with Large text it fits; at 1280
        // by 780 it does not)
        full-row := HorizontalLayout {
            visible: false;
            spacing: tabs.tab-pad;
            for n in ["Character", "Abilities", "Inventory", "Party", "Timeline", "Quests", "Pazaak & Destinations", "Map", "Advanced"]: Text {
                text: n;
                font-family: Theme.list-font;
                font-size: tabs.tab-font;
            }
        }
        property <bool> roomy: full-row.preferred-width + self.tab-pad <= self.width;
        HorizontalLayout {
            alignment: start;
            // Timeline (the galaxy map) is its own tab (2026-11-06, the maintainer), and so are
            // the planets and Pazaak, beside Quests, which was Story (the same day: "put Pazaak &
            // Destinations as a seperate menu tab / make Story called Quests"). They keep the
            // numbers 7 and 8 so the other tabs keep theirs.
            for t in [
                { name: "Character", i: 0 }, { name: "Abilities", i: 1 }, { name: "Inventory", i: 2 },
                { name: "Party", i: 3 }, { name: "Timeline", i: 7 }, { name: "Quests", i: 4 },
                { name: tabs.roomy ? "Pazaak & Destinations" : "Pazaak", i: 8 },
                { name: "Map", i: 5 }, { name: "Advanced", i: 6 },
            ]: Rectangle {
                property <int> i: t.i;
                width: tt.preferred-width + tabs.tab-pad;
                tt := Text { y: 10px; text: t.name; font-family: Theme.list-font; font-size: tabs.tab-font; color: i == App.tab ? Theme.text : ta.has-hover ? Theme.muted : Theme.soft; }
                if App.tab-changed[i]: Rectangle {
                    x: tt.x + tt.width + 6px;
                    y: 12px;
                    width: 7px;
                    height: 7px;
                    border-radius: 3.5px;
                    background: Theme.changed;
                }
                if i == App.tab: Rectangle { x: 0; y: parent.height - 3px; height: 3px; background: Theme.accent; }
                ta := TouchArea { mouse-cursor: pointer; clicked => { App.select-tab(i); } }
            }
        }
    }
    // The open save, its area and the game: in the strip under the panel, not beside the
    // tabs (2026-10-24, the maintainer).
    Text {
        x: 62px;
        y: parent.height - 36px + (36px - self.height) / 2;
        width: parent.width - 124px;
        text: App.context-line;
        font-family: Theme.body-font;
        font-size: 13px * Theme.ts;
        color: Theme.faint;
        overflow: elide;
    }
    // The party (not on the map or the story, which take its room)
    if App.tab < 4: Scroller {
        x: 60px;
        y: 240px;
        width: root.slim ? 84px : 262px;
        height: parent.height - 240px - 36px;
        content-height: App.members.length * 72px;
        VerticalLayout {
            spacing: 6px;
            for m[i] in App.members: Rectangle {
                height: 66px;
                border-radius: 6px;
                border-width: 1px;
                border-color: i == App.who ? Theme.accent : transparent;
                background: i == App.who ? Theme.selected : mt.has-hover ? Theme.hover : transparent;
                HorizontalLayout {
                    padding: 7px;
                    spacing: 12px;
                    Rectangle {
                        width: 52px;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: Theme.edge;
                        background: Theme.field;
                        clip: true;
                        if m.has-portrait: Image { source: m.portrait; width: parent.width; height: parent.height; }
                        // without the name, its orange mark for changes
                        if root.slim && m.changed: Rectangle { x: parent.width - 13px; y: 3px; width: 10px; height: 10px; border-radius: 5px; background: Theme.changed; }
                    }
                    if !root.slim: VerticalLayout {
                        alignment: center;
                        Text { text: m.name; font-family: Theme.list-font; font-size: 18px * Theme.ts; color: m.changed ? Theme.changed : i == App.who ? Theme.gold : Theme.muted; overflow: elide; }
                        Text { text: m.sub; font-family: Theme.body-font; font-size: 12.5px * Theme.ts; color: Theme.faint; overflow: elide; }
                    }
                }
                mt := TouchArea { mouse-cursor: pointer; clicked => { App.select-who(i); } }
            }
        }
    }
    // The tab
    Rectangle {
        x: App.tab >= 4 ? 60px : root.slim ? 164px : 342px;
        y: 240px;
        width: parent.width - self.x - 60px;
        height: parent.height - 240px - 36px;
        // on the Timeline the map is the page: no panel around it, only the map's own frame
        // (2026-11-06, the maintainer: "Remove the outer border and make the map the main piece
        // on this timeline page")
        background: App.tab == 7 ? transparent : Theme.panel;
        border-width: App.tab == 7 ? 0px : 1px;
        border-color: Theme.panel-edge;
        border-radius: 10px;
        // The Timeline: the galaxy map filling the panel's place. Made once with the page and only hidden on the other tabs, so
        // opening the tab does not build it again (2026-11-06, the maintainer: "make the tab
        // less slow ... preload it").
        GalaxySection {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            visible: App.tab == 7;
        }
        Rectangle {
            x: 26px;
            y: 22px;
            width: parent.width - 52px;
            height: parent.height - 44px;
            if App.tab == 0: CharacterTab { }
            if App.tab == 1: AbilitiesTab { }
            if App.tab == 2: InventoryTab { }
            if App.tab == 3: PartyTab { }
            // Quests and Pazaak & Destinations: each one section, so no tabs of their own
            if App.tab == 4: JournalSection { }
            if App.tab == 8: MoreSection { }
            if App.tab == 6: StoryTab {
                items: [
                    { name: "Story Values", section: 0 },
                    { name: "", section: -1 },
                    { name: "Area Objects", section: 1 },
                    { name: "", section: -1 },
                    { name: "Creatures", section: 2 },
                ];
            }
            if App.tab == 5: MapTab { }
        }
    }
    // Copy, between Settings and the save buttons (2026-10-24, the maintainer): a copy of the
    // save as it is on disk, the changes not in it.
    CopyButton {
        x: parent.width - 60px - 50px - 14px - self.width;
        y: 52px;
        clicked => { App.copy-save(); }
    }
    // Revert and Save Changes, top right beside the settings button (2026-10-22, the
    // maintainer: the bottom bar's place goes to the tabs; the backup moved to Settings).
    HorizontalLayout {
        x: parent.width - 60px - 2 * (50px + 14px) - self.width;
        y: 52px;
        width: 150px + 12px + 318px;
        height: 50px;
        spacing: 12px;
        Button { width: 150px; text: "Revert"; kind: 2; enabled: App.change-count > 0; clicked => { App.revert(); } }
        // Save Changes with its arrow (2026-10-24, the maintainer): the arrow, part of the
        // button on its right, opens Save as a New Save; the same colour as Save Changes, lit or
        // greyed out with it, a line between the two.
        HorizontalLayout {
            width: 318px;
            spacing: 0;
            Button { width: 270px; text: "Save Changes"; kind: 0; enabled: App.change-count > 0; clicked => { App.save-changes(); } }
            Rectangle {
                property <bool> on: App.change-count > 0;
                width: 48px;
                border-radius: 5px;
                border-width: on && arrow.has-hover ? 2px : on ? 0px : 1px;
                border-color: on ? Theme.hover-edge : Theme.edge;
                background: !on ? Theme.selected : @linear-gradient(180deg, arrow.has-hover ? Theme.fill-hover : Theme.fill-top 0%, Theme.fill-bottom 100%);
                // the line between the two halves
                Rectangle { x: 0; width: 2px; height: parent.height - 14px; background: parent.on ? Theme.ink.with-alpha(0.45) : Theme.edge; }
                Path {
                    width: 14px;
                    height: 14px;
                    viewbox-width: 10;
                    viewbox-height: 10;
                    fill: parent.on ? Theme.ink : Theme.faint;
                    commands: "M 0 3 L 10 3 L 5 8 Z";
                }
                arrow := TouchArea {
                    enabled: parent.on;
                    mouse-cursor: parent.on ? pointer : default;
                    clicked => { root.save-menu = !root.save-menu; }
                }
            }
        }
    }
    // What is changed, or what the last save did, under the buttons.
    Text {
        x: parent.width - 60px - self.width;
        y: 112px;
        width: min(self.preferred-width, 640px);
        horizontal-alignment: right;
        overflow: elide;
        text: App.status != "" ? App.status
            : App.change-count == 0 ? "No changes"
            : App.change-count == 1 ? "1 change, not saved yet" : App.change-count + " changes, not saved yet";
        font-family: Theme.body-font;
        font-size: 14px * Theme.ts;
        color: App.status != "" ? (App.status-bad ? Theme.danger : Theme.good) : App.change-count > 0 ? Theme.changed : Theme.faint;
    }
    if save-menu: TouchArea {
        // a click anywhere else closes it
        clicked => { root.save-menu = false; }
    }
    // wide enough for its whole line, its right edge under the arrow's
    if save-menu && App.change-count > 0: Rectangle {
        x: parent.width - 60px - 2 * (50px + 14px) - self.width;
        y: 52px + 50px + 6px;
        width: max(260px, menu-text.preferred-width + 32px);
        height: 48px;
        border-radius: 6px;
        border-width: menu-item.has-hover ? 2px : 1px;
        border-color: menu-item.has-hover ? Theme.hover-edge : Theme.edge;
        background: menu-item.has-hover ? Theme.hover : Theme.field;
        menu-text := Text {
            x: 16px;
            height: parent.height;
            vertical-alignment: center;
            text: "Save as a New Save\u{2026}";
            font-family: Theme.list-font;
            font-size: 16px * Theme.ts;
            color: Theme.text;
        }
        menu-item := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.save-menu = false;
                App.ask-save-as();
            }
        }
    }
}
