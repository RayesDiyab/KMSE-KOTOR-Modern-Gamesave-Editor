// KOTOR Modern Gamesave Editor
//
// THESIS: a save editor that looks and reads like KotOR itself: the Load screen to pick
// a save, the in-game menu's tabs to change it, every value edited where it is shown.
// It refuses the usual grid of dialogs and the tile dashboard.
// OWN-WORLD: the KMRP Font Converter's navy, cyan and gold (KotOR) or teal-green
// (KotOR II), dark or light; KMRP's own Original HD Font; hairline panels, 5 px corners,
// orange for anything changed and not yet saved.
// STORY: the player finds their save without setup, changes it, sees what changed, saves
// with a backup made first, and goes back to the game.
// FIRST VIEWPORT: the KMRP crest and "Save Editor" top left, the game switch top right,
// the saves list on the left, the picked save's picture, party and Open on the right.
// FORM: in-game menu (tabs). A surface roll assigned a tile dashboard (structure 4 of 7);
// the maintainer turned it down and chose the tabs, 2026-10-22. seed: none (unavailable)
// FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review,
// the verdict, and DESIGN.md

import { Theme } from "theme.slint";
import { App, SaveRow, Member, Stat, Named, ItemRow, NpcRow, GlobalRow, DoorRow, BoxRow, PortraitRow, Toggle, StoryValue, StoryItem, BackupRow } from "state.slint";
import { Button, Field, Note, Scroller, Brand, Link, Sign, Stepper, Label, Choice, SettingsButton, Switch, AlignmentChoice, RoundFill, ChangeIcon } from "widgets.slint";
import { SavesPage } from "saves.slint";
import { EditorPage } from "editor.slint";

export { Theme, App, SaveRow, Member, Stat, Named, ItemRow, NpcRow, GlobalRow, DoorRow, BoxRow, PortraitRow, Toggle, StoryValue, StoryItem, BackupRow }

component Overlay inherits Rectangle {
    in property <length> panel-width: 760px;
    in property <length> panel-height: 620px;
    // Escape does what the pop-up's Cancel or Close does (2026-11-06: no pop-up answered it)
    callback escape;
    escape => { App.close-overlay(); }
    background: Theme.scrim;
    // around everything, so Escape typed in a box inside reaches it too
    keys := FocusScope {
        init => { self.focus(); }
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                root.escape();
                return accept;
            }
            return reject;
        }
        TouchArea { }
        panel := Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(root.panel-width, parent.width - 80px);
            height: min(root.panel-height, parent.height - 80px);
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.edge;
            border-radius: 12px;
            Rectangle {
                x: 32px;
                y: 28px;
                width: parent.width - 64px;
                height: parent.height - 56px;
                @children
            }
        }
    }
}

// A pop-up's message: it scrolls when it is longer than the pop-up has room for, so the buttons
// under it stay in view (2026-11-07 audit, U-10: a long list of what a story move could not do,
// or the half-written save's text, pushed OK off the pop-up's fixed height).
component MessageText inherits Scroller {
    vertical-stretch: 1;
    min-height: 40px;
    content-height: body.preferred-height;
    body := Note {
        x: 0px; y: 0px;
        width: parent.width - 16px;
        text: App.message-body; font-size: 15px * Theme.ts; color: Theme.muted;
    }
}

// The story pop-ups (Finish Quest, and travelling on the timeline) drawn as a screen of the
// game's own menus (2026-11-07, the maintainer approved the mock-up: "this looks amazing"): a
// framed dialog with a double line and a soft light around it, a notched rail along its top, a
// gold title over a line that fades out, framed panels with lit section headings, a change table
// with the games' notification icons. The buttons are the program's own.
component GameDialog inherits Rectangle {
    in property <length> panel-width: 1300px;
    in property <length> panel-height: 860px;
    in property <string> title;
    // small print on the title's line, right (the timeline's stop and where it stands)
    in property <string> status;
    in property <string> note;
    callback escape;
    escape => { App.close-overlay(); }
    background: Theme.scrim;
    keys := FocusScope {
        init => { self.focus(); }
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                root.escape();
                return accept;
            }
            return reject;
        }
        TouchArea { }
        panel := Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            // the sizes are for a window of 1600 by 900; a larger window makes the pop-up larger
            // in step (2026-11-07, the maintainer: at 1600 by 1290 it sat small in the middle)
            width: min(root.panel-width * max(1, parent.width / 1600px), parent.width - 60px);
            height: min(root.panel-height * max(1, parent.height / 900px), parent.height - 50px);
            // the soft light around the frame
            Rectangle {
                x: -4px; y: -4px;
                width: parent.width + 8px; height: parent.height + 8px;
                border-radius: 22px;
                border-width: 3px;
                border-color: Theme.frame-line.with-alpha(0.25);
            }
            Rectangle {
                border-radius: 18px;
                background: Theme.frame-deep;
                border-width: 2px;
                border-color: Theme.frame-line;
            }
            // the frame's inner line
            Rectangle {
                x: 7px; y: 7px;
                width: parent.width - 14px; height: parent.height - 14px;
                border-radius: 12px;
                border-width: 1px;
                border-color: Theme.frame-dim;
            }
            // a notched rail along the top edge, as the game's screens have
            Path {
                x: parent.width * 0.3; y: 7px;
                width: parent.width * 0.4; height: 14px;
                viewbox-width: self.width / 1px;
                viewbox-height: 14;
                stroke: Theme.frame-dim;
                stroke-width: 2px;
                commands: "M 0 0 L 30 13 L " + (self.width / 1px - 30) + " 13 L " + (self.width / 1px) + " 0";
            }
            VerticalLayout {
                x: 32px; y: 28px;
                width: parent.width - 64px;
                height: parent.height - 52px;
                spacing: 0px;
                HorizontalLayout {
                    spacing: 16px;
                    Text {
                        text: root.title;
                        font-family: Theme.title-font;
                        font-size: 28px * Theme.ts;
                        color: Theme.gold;
                        wrap: word-wrap;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    if root.status != "": Text {
                        text: root.status;
                        font-family: Theme.label-font;
                        font-size: 11px * Theme.ts;
                        letter-spacing: 2px;
                        color: Theme.soft;
                        vertical-alignment: center;
                    }
                }
                Rectangle { height: 10px; }
                // the title's line, fading out to the right
                Rectangle { height: 2px; background: @linear-gradient(90deg, Theme.accent 0%, Theme.accent.with-alpha(0) 100%); }
                Rectangle { height: 12px; }
                if root.note != "": Note { text: root.note; font-size: 13.5px * Theme.ts; color: Theme.muted; }
                if root.note != "": Rectangle { height: 16px; }
                Rectangle {
                    vertical-stretch: 1;
                    @children
                }
            }
        }
    }
}

// A framed panel inside a GameDialog.
component Frame inherits Rectangle {
    border-radius: 14px;
    border-width: 2px;
    border-color: Theme.frame-line;
    background: Theme.frame-panel;
}

// A section's heading: a light band that fades out to the right, with rounded corners, a bright
// mark at its start and a hairline under it that fades too, as the game lights a highlighted row.
component Section inherits Rectangle {
    in property <string> text;
    height: max(30px, name.preferred-height + 14px);
    RoundFill { r: 6px; across: true; from: Theme.accent.with-alpha(0.17); to: Theme.accent.with-alpha(0); }
    Rectangle { x: 0px; y: 4px; width: 3px; height: parent.height - 8px; border-radius: 1.5px; background: Theme.accent; }
    Rectangle {
        x: 6px; y: parent.height - 1px;
        width: parent.width - 6px; height: 1px;
        background: @linear-gradient(90deg, Theme.accent.with-alpha(0.8) 0%, Theme.accent.with-alpha(0) 100%);
    }
    name := Label {
        x: 16px;
        width: parent.width - 24px;
        height: parent.height;
        text: root.text;
        font-size: 13px * Theme.ts;
        letter-spacing: 3px;
        vertical-alignment: center;
    }
}

// What a story change does to the save, measured on a copy: the values before and after, and
// what is gained and lost (companions, feats, powers, quests). Shared by Skip Ahead, Go Back and
// Finish Quest (2026-11-06), a table with the games' icons since 2026-11-07.

component StoryValues inherits VerticalLayout {
    in property <bool> compact;
    spacing: 10px;
    // the columns: the icon's, the change's, current, the arrow's, after, difference
    property <length> lead: 44px;
    property <length> rest: self.width - self.lead - 40px;
    property <length> at-current: self.lead + self.rest * 0.4;
    property <length> at-after: self.at-current + self.rest * 0.2 + 40px;
    property <length> at-difference: self.at-after + self.rest * 0.2;
    Section { text: "CHANGES TO YOUR SAVE"; }
    if !App.story-preview-ready: Note { text: App.story-preview-status; font-size: 14px * Theme.ts; }
    if App.story-preview-ready: VerticalLayout {
        spacing: 0px;
        alignment: start;
        // the column heads on a band of their own
        Rectangle {
            height: 30px * Theme.ts;
            border-radius: 6px;
            background: Theme.frame-head;
            border-width: 1px;
            border-color: Theme.frame-dim;
            for h[k] in ["CHANGE", "CURRENT", "AFTER", "DIFFERENCE"]: Text {
                x: k == 0 ? root.lead : k == 1 ? root.at-current : k == 2 ? root.at-after : root.at-difference;
                height: parent.height;
                text: h;
                font-family: Theme.label-font;
                font-size: 9.5px * Theme.ts;
                letter-spacing: 2px;
                color: Theme.soft;
                vertical-alignment: center;
            }
        }
        Rectangle { height: 4px; }
        // One colour language everywhere (2026-11-06, the maintainer): what goes up is green,
        // what goes down red, the value after the change gold, what stays the same plain.
        for r in App.story-values: Rectangle {
            height: root.compact ? 34px * Theme.ts : 36px * Theme.ts;
            // the game's own icon where it has one for the row (Health, Force, influence, class, skills,
            // components), else the notification icon drawn by the program
            if r.has-picture: Image { x: 6px; source: r.picture; width: min(32px, parent.height - 4px); height: self.width; image-fit: contain; }
            if !r.has-picture && r.kind != "": ChangeIcon { x: 6px; kind: r.kind; width: min(32px, parent.height - 4px); }
            Text {
                x: root.lead; width: root.at-current - root.lead - 10px; height: parent.height;
                text: r.label; font-size: 13.5px * Theme.ts; color: Theme.text; vertical-alignment: center; overflow: elide;
            }
            Text {
                x: root.at-current; width: root.rest * 0.2; height: parent.height;
                text: r.before; font-size: 13.5px * Theme.ts; color: r.changed ? Theme.muted : Theme.text; vertical-alignment: center; overflow: elide;
            }
            if r.changed: Path {
                x: root.at-after - 36px; y: (parent.height - self.height) / 2;
                width: 22px; height: 10px;
                viewbox-width: 22; viewbox-height: 10;
                stroke: Theme.faint; stroke-width: 2px;
                commands: "M 0 5 L 21 5 M 15 0 L 21 5 L 15 10";
            }
            if r.changed: Text {
                x: root.at-after; width: root.at-difference - root.at-after - 8px; height: parent.height;
                text: r.after; font-size: 13.5px * Theme.ts; color: Theme.gold; vertical-alignment: center; overflow: elide;
            }
            Text {
                x: root.at-difference; width: parent.width - root.at-difference; height: parent.height;
                text: r.difference; font-size: 13.5px * Theme.ts; color: r.change > 0 ? Theme.gain : r.change < 0 ? Theme.danger : Theme.muted; vertical-alignment: center;
            }
            Rectangle { x: root.lead - 6px; y: parent.height - 1px; width: parent.width - self.x; height: 1px; background: Theme.row-line; }
        }
        // what is gained and lost, each in a framed row: a quest's journal, a companion, a feat
        for r in App.story-grants: Rectangle {
            height: 38px * Theme.ts + 8px;
            Rectangle {
                y: 8px; height: parent.height - 8px;
                border-radius: 6px;
                background: Theme.field;
                border-width: 1px;
                border-color: Theme.frame-dim;
                ChangeIcon {
                    x: 8px;
                    width: min(28px, parent.height - 8px);
                    kind: r.note == "Quest finished" || r.note == "Quest moves on" || r.note == "Quest begins" ? "quest"
                        : r.note == "Companion" ? "party" : r.id > 0 ? "gain" : "loss";
                }
                Text {
                    x: root.lead; width: parent.width - root.lead - note.preferred-width - 28px; height: parent.height;
                    text: r.name; font-size: 13.5px * Theme.ts; color: Theme.text; vertical-alignment: center; overflow: elide;
                }
                note := Text {
                    x: parent.width - self.preferred-width - 14px; height: parent.height;
                    text: r.id > 0 ? r.note : r.note + " lost";
                    font-size: 12.5px * Theme.ts; color: r.id > 0 ? Theme.gain : Theme.danger; vertical-alignment: center;
                }
            }
        }
    }
}

// One item a story change adds or takes, framed, with its icon.
component ItemCard inherits Rectangle {
    in property <StoryItem> entry;
    height: 62px;
    border-radius: 8px;
    background: Theme.field;
    border-width: 1px;
    border-color: Theme.frame-line;
    Rectangle {
        x: 8px; y: 7px; width: 48px; height: 48px;
        border-radius: 5px;
        background: Theme.frame-deep;
        border-width: 1px;
        border-color: Theme.frame-line;
        if root.entry.has-icon: Image { x: 2px; y: 2px; width: 44px; height: 44px; source: root.entry.icon; image-fit: contain; }
    }
    VerticalLayout {
        x: 70px; width: parent.width - 150px;
        alignment: center;
        spacing: 4px;
        Text { text: root.entry.name; font-family: Theme.list-font; font-size: 15px * Theme.ts; color: Theme.text; overflow: elide; }
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            ChangeIcon { kind: root.entry.gained ? "gain" : "loss"; width: 18px * Theme.ts; }
            Text { text: root.entry.gained ? "Added" : "Removed"; font-size: 12px * Theme.ts; color: root.entry.gained ? Theme.gain : Theme.danger; vertical-alignment: center; }
        }
    }
    Text {
        x: parent.width - 80px; width: 64px; height: parent.height;
        text: root.entry.difference; font-size: 13.5px * Theme.ts;
        color: root.entry.gained ? Theme.gain : Theme.danger;
        vertical-alignment: center; horizontal-alignment: right;
    }
}

// The inventory changes of a story change, one framed card each: all of them in the scroll they
// sit in (rows 0), or in a box `rows` cards high that scrolls on its own.
component StoryItems inherits VerticalLayout {
    in property <int> rows: 0;
    // Go Back's choice to keep the items and credits, under the heading (2026-11-07, the
    // maintainer): off, the changes below; on, none. Shown while the preview is worked out
    // again too, so it does not jump away under the pointer.
    in property <bool> keep-option: false;
    spacing: 10px;
    // the heading on its box, whatever room the pop-up gives
    alignment: start;
    if App.story-preview-ready || root.keep-option: Section { text: "INVENTORY CHANGES"; }
    if root.keep-option: HorizontalLayout {
        spacing: 12px;
        alignment: start;
        VerticalLayout {
            alignment: center;
            Switch {
                on: App.back-keep-items;
                toggled(v) => { App.back-keep-items = v; App.refresh-story-preview(); }
            }
        }
        Text { text: "Keep my items and credits"; vertical-alignment: center; font-family: Theme.body-font; font-size: 14px * Theme.ts; color: Theme.muted; }
    }
    if App.story-preview-ready && App.story-items.length == 0: Note { text: "No inventory changes."; font-size: 13px * Theme.ts; }
    if App.story-preview-ready && App.story-items.length > 0 && root.rows == 0: VerticalLayout {
        spacing: 8px;
        for r in App.story-items: ItemCard { entry: r; }
    }
    if App.story-preview-ready && App.story-items.length > 0 && root.rows > 0: Scroller {
        height: min(root.rows, App.story-items.length) * 70px;
        content-height: App.story-items.length * 70px - 8px;
        VerticalLayout {
            x: 0px; y: 0px;
            width: parent.width - 16px;
            spacing: 8px;
            for r in App.story-items: ItemCard { entry: r; }
        }
    }
}

component StoryPreviewDetails inherits Rectangle {
    property <bool> back: App.overlay == 11 || (App.overlay == 12 && App.pop-action == 2);
    VerticalLayout {
        spacing: 12px;
        Scroller {
            vertical-stretch: 1;
            min-height: 120px;
            content-height: details.preferred-height;
            details := VerticalLayout {
                x: 0px; y: 0px;
                width: parent.width - 16px;
                // its own height: as tall as the scroll it squeezed the change table to a line
                height: self.preferred-height;
                spacing: 10px;
                Text {
                    text: App.pop-action == 0 && App.overlay == 12 ? "Choose a subchapter" : App.pop-detail;
                    font-family: Theme.title-font; font-size: 25px * Theme.ts;
                    color: Theme.text; wrap: word-wrap;
                }
                if App.pop-action != 0 || App.overlay != 12: Scroller {
                    height: min(summary.preferred-height + 4px, 110px);
                    content-height: summary.preferred-height;
                    summary := Note {
                        x: 0px; y: 0px;
                        width: parent.width - 12px;
                        text: root.back ? App.back-summary : App.skip-summary;
                        font-size: 13px * Theme.ts;
                    }
                }
                if !root.back && App.pop-action != 0: VerticalLayout {
                    spacing: 8px;
                    if App.skip-jedi: Label { text: "YOUR JEDI CLASS"; font-size: 11px * Theme.ts; }
                    if App.skip-jedi: Choice {
                        height: 40px; font-size: 14px * Theme.ts;
                        options: ["Jedi Guardian", "Jedi Sentinel", "Jedi Consular"];
                        current: App.skip-class;
                        picked(k) => { App.skip-class = k; App.refresh-story-preview(); }
                    }
                    if App.skip-side: Label { text: "YOUR PATH"; font-size: 11px * Theme.ts; }
                    if App.skip-side: Choice {
                        height: 40px; font-size: 14px * Theme.ts;
                        options: ["Light side", "Dark side"]; current: App.skip-dark;
                        picked(k) => { App.skip-dark = k; App.refresh-story-preview(); }
                    }
                    if App.skip-prestige: Label { text: "YOUR PRESTIGE CLASS"; font-size: 11px * Theme.ts; }
                    if App.skip-prestige: Choice {
                        height: 40px; font-size: 14px * Theme.ts;
                        options: App.skip-dark == 1 ? ["Sith Marauder", "Sith Assassin", "Sith Lord", "Not now"] : ["Jedi Weapon Master", "Jedi Watchman", "Jedi Master", "Not now"];
                        current: App.skip-prestige-pick;
                        picked(k) => { App.skip-prestige-pick = k; App.refresh-story-preview(); }
                    }
                    if App.skip-train: Label { text: "COMPANIONS AS JEDI"; font-size: 11px * Theme.ts; }
                    if App.skip-train: Choice {
                        height: 40px; font-size: 14px * Theme.ts;
                        options: ["Trained, no conversations", "I'll talk to them"]; current: App.skip-train-pick;
                        picked(k) => { App.skip-train-pick = k; App.refresh-story-preview(); }
                    }
                }
                if root.back: AlignmentChoice {
                    value: App.back-alignment;
                    set(v) => { App.back-alignment = v; }
                    committed => { App.refresh-story-preview(); }
                }
                StoryValues { compact: root.back; }
                // what the move cannot do, before it is applied (S-9: it was told only after)
                if App.story-preview-ready && App.story-problems != "": VerticalLayout {
                    spacing: 6px;
                    Label { text: "NOT DONE"; font-size: 11px * Theme.ts; }
                    Note { text: App.story-problems; font-size: 13px * Theme.ts; color: Theme.muted; }
                }
                // in the same scroll, right under the changes, as in Finish Quest (2026-11-07):
                // in a box of its own at the column's foot, a tall window left a gap between them
                StoryItems { keep-option: root.back; }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "KOTOR Modern Gamesave Editor";
    icon: @image-url("../assets/save-editor-icon.png");
    preferred-width: 1600px;
    preferred-height: 900px;
    // The layout is drawn for 1280 x 780 or more. A smaller window is not crowded: main.rs
    // (fit_to_window) shrinks everything evenly so that size fits (U-6). These only stop the
    // window going smaller than half of it.
    min-width: 640px;
    min-height: 390px;
    background: Theme.window;
    default-font-family: Theme.body-font;

    // After an edit the whole window is drawn again. Slint's software renderer draws only what
    // it finds changed, and it missed a change: on KotOR II's Abilities tab, adding a feat and
    // a power and removing both left "FORCE POWERS · 9" on screen with 8 in the save until the
    // window was resized (2026-11-06; reproduced every time with those four clicks). This
    // covers the window and its colour changes with every edit, so all of it counts as
    // changed. It is black at 1/255 at most, under everything, and takes no clicks. (Only
    // hiding and showing it, with no colour, was not enough: the count stayed wrong.)
    Rectangle { width: 100%; height: 100%; background: App.repaint ? #00000001 : #00000000; }

    // Where the focus goes when the mouse is pressed anywhere (main.rs): a text box being
    // typed in then takes what was typed, as if Enter were pressed.
    sink := FocusScope {
        width: 0;
        height: 0;
        // a click in a pop-up brings the focus here: Escape still closes it
        key-pressed(e) => {
            if (e.text == Key.Escape && App.overlay != 0) {
                if (App.overlay == 13) { App.pool-cancel(); } else { App.close-overlay(); }
                return accept;
            }
            return reject;
        }
    }
    public function drop-focus() {
        // Rename is explicit: outside presses cancel, while the field and save icon
        // keep their focus and draft until Enter or the icon is pressed.
        if App.renaming-save {
            if !App.rename-hovered {
                App.renaming-save = false;
                sink.focus();
            }
            return;
        }
        sink.focus();
    }

    // The header's glow, behind everything.
    Rectangle {
        y: 0;
        height: 220px;
        background: @radial-gradient(circle, Theme.glow 0%, Theme.window 70%);
        width: parent.width * 1.6;
        x: -parent.width * 0.55;
    }
    Rectangle { y: 140px; height: 80px; background: @linear-gradient(180deg, transparent 0%, Theme.window 100%); }

    // The name gives way below the width where it would run under the buttons on the right
    // (measured 2026-11-06 at 1280 by 780: the editor's Revert covered "Editor").
    Brand { x: App.page == 1 ? 140px : 60px; y: 44px; height: 110px; short: App.page == 1; named: App.page == 1 ? root.width >= 1400px : root.width >= 1460px; }

    if App.page == 0: SavesPage { }
    if App.page == 1: EditorPage { }

    // Footer, on the list of saves only. The folders moved into Settings on 2026-10-22, and
    // in the editor the backups did too, so the tabs reach the bottom.
    if App.page == 0: HorizontalLayout {
        x: 60px;
        y: parent.height - 46px;
        width: parent.width - 120px - 220px;
        height: 30px;
        spacing: 14px;
        alignment: start;
        Text { text: "v1.0"; vertical-alignment: center; font-size: 15px * Theme.ts; color: Theme.faint; }
        Text { text: "·"; vertical-alignment: center; font-size: 15px * Theme.ts; color: Theme.faint; }
        if App.page == 0: Link { text: "Open Saves Folder"; vertical-alignment: center; clicked => { App.open-saves-folder(); } }
        if App.page == 0: Text { text: "·"; vertical-alignment: center; font-size: 15px * Theme.ts; color: Theme.faint; }
        if App.page == 0: Link { text: "Refresh"; vertical-alignment: center; clicked => { App.refresh-saves(); } }
    }
    if App.page == 0: Text {
        x: parent.width - 60px - self.width;
        y: parent.height - 46px;
        height: 30px;
        vertical-alignment: center;
        text: "Created by RaymanGT";
        font-size: 15px * Theme.ts;
        color: Theme.faint;
    }

    // Settings, top right on both pages.
    SettingsButton {
        x: parent.width - 60px - self.width;
        y: 52px;
        clicked => { App.open-settings(); }
    }

    // ---- pop-ups ----
    if App.overlay == 1 || App.overlay == 5: Overlay {
        panel-width: 900px;
        panel-height: 720px;
        property <string> query;
        VerticalLayout {
            spacing: 10px;
            Text { text: App.overlay-title; font-family: Theme.title-font; font-size: 30px * Theme.ts; color: Theme.text; }
            Note { text: App.overlay-note; font-size: 15px * Theme.ts; }
            // the categories share the row (at 1280 by 780 the last ran out of the pop-up)
            if App.overlay == 1 && App.picker-tabs.length > 0: HorizontalLayout {
                spacing: 6px;
                for t[i] in App.picker-tabs: Rectangle {
                    height: 34px;
                    min-width: tt.preferred-width + 12px;
                    horizontal-stretch: 1;
                    border-radius: 5px;
                    border-width: 1px;
                    border-color: i == App.picker-tab ? Theme.accent : Theme.edge;
                    background: i == App.picker-tab ? Theme.selected : pt2.has-hover ? Theme.hover : Theme.field;
                    tt := Text { text: t; font-family: Theme.list-font; font-size: 14px * Theme.ts; color: i == App.picker-tab ? Theme.text : Theme.soft; }
                    pt2 := TouchArea { mouse-cursor: pointer; clicked => { App.select-picker-tab(i); } }
                }
            }
            if App.overlay == 1: Field {
                text <=> query;
                placeholder: App.picker-placeholder;
                font: Theme.body-font;
                font-size: 15px * Theme.ts;
                edited(t) => { App.search-picker(t); }
            }
            Scroller {
                vertical-stretch: 1;
                content-height: App.picker.length * 50px;
                VerticalLayout {
                    for r in App.picker: Rectangle {
                        height: 50px;
                        background: pt.has-hover ? Theme.hover : transparent;
                        border-radius: 5px;
                        Rectangle { y: parent.height - 1px; height: 1px; background: Theme.row-line; }
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 10px;
                            if r.has-icon: VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 40px;
                                    height: 40px;
                                    border-radius: 4px;
                                    border-width: 1px;
                                    border-color: Theme.edge;
                                    background: Theme.field;
                                    clip: true;
                                    Image { source: r.icon; width: parent.width; height: parent.height; }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Text { text: r.name; font-family: Theme.list-font; font-size: 17px * Theme.ts; color: Theme.text; overflow: elide; }
                                Text { text: r.note; font-family: Theme.body-font; font-size: 12px * Theme.ts; color: Theme.faint; overflow: elide; }
                            }
                            Rectangle { width: 30px; Sign { plus: true; colour: Theme.accent; } }
                        }
                        pt := TouchArea { mouse-cursor: pointer; clicked => { App.pick(r.id); } }
                    }
                }
            }
            HorizontalLayout {
                alignment: end;
                Button { width: 170px; text: "Close"; clicked => { App.close-overlay(); } }
            }
        }
    }
    if App.overlay == 2: Overlay {
        panel-width: 980px;
        panel-height: 700px;
        VerticalLayout {
            spacing: 10px;
            Text { text: App.overlay-title; font-family: Theme.title-font; font-size: 30px * Theme.ts; color: Theme.text; }
            Note { text: App.overlay-note; font-size: 15px * Theme.ts; }
            Scroller {
                vertical-stretch: 1;
                property <int> per-row: 10;
                content-height: Math.ceil(App.looks.length / per-row) * 92px;
                Rectangle {
                    height: Math.ceil(App.looks.length / per-row) * 92px;
                    for p[i] in App.looks: Rectangle {
                        x: Math.mod(i, per-row) * 90px;
                        y: Math.floor(i / per-row) * 92px;
                        width: 82px;
                        height: 82px;
                        border-radius: 5px;
                        border-width: p.current ? 3px : lt.has-hover ? 2px : 1px;
                        border-color: p.current ? Theme.gold : lt.has-hover ? Theme.accent : Theme.edge;
                        background: Theme.field;
                        clip: true;
                        Image { source: p.image; width: parent.width - 6px; height: parent.height - 6px; }
                        lt := TouchArea { mouse-cursor: pointer; clicked => { App.pick-look(p.id); } }
                    }
                }
            }
            HorizontalLayout {
                alignment: end;
                Button { width: 170px; text: "Close"; clicked => { App.close-overlay(); } }
            }
        }
    }
    if App.overlay == 3: Overlay {
        panel-height: 700px;
        VerticalLayout {
            spacing: 10px;
            Text { text: App.overlay-title; font-family: Theme.title-font; font-size: 30px * Theme.ts; color: Theme.text; }
            Note { text: App.overlay-note; font-size: 15px * Theme.ts; }
            Scroller {
                vertical-stretch: 1;
                content-height: App.other-saves.length * 78px;
                VerticalLayout {
                    spacing: 4px;
                    for s[i] in App.other-saves: Rectangle {
                        height: 74px;
                        border-radius: 6px;
                        background: ot.has-hover ? Theme.hover : transparent;
                        HorizontalLayout {
                            padding: 6px;
                            spacing: 14px;
                            Rectangle {
                                width: 82px;
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: Theme.edge;
                                background: Theme.field;
                                clip: true;
                                if s.has-shot: Image { source: s.shot; width: parent.width; height: parent.height; image-fit: fill; }
                            }
                            VerticalLayout {
                                alignment: center;
                                Text { text: s.name; font-family: Theme.list-font; font-size: 18px * Theme.ts; color: Theme.text; overflow: elide; }
                                Text { text: s.area + "  ·  " + s.date; font-family: Theme.body-font; font-size: 13px * Theme.ts; color: Theme.faint; overflow: elide; }
                            }
                        }
                        ot := TouchArea { mouse-cursor: pointer; clicked => { App.pick-save(i); } }
                    }
                }
            }
            HorizontalLayout {
                alignment: end;
                Button { width: 170px; text: "Cancel"; clicked => { App.close-overlay(); } }
            }
        }
    }
    if App.overlay == 6: Overlay {
        panel-width: 760px;
        panel-height: 250px + App.class-rows.length * 72px;
        VerticalLayout {
            spacing: 12px;
            Text { text: "Classes"; font-family: Theme.title-font; font-size: 30px * Theme.ts; color: Theme.text; }
            Note {
                font-size: 15px * Theme.ts;
                text: "Level up adds the class's Health and Force. Level down removes what that level gave. XP follows the level. Two classes at most.";
            }
            for c in App.class-rows: Rectangle {
                height: 60px;
                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.row-line; }
                HorizontalLayout {
                    spacing: 14px;
                    Text { text: c.name; vertical-alignment: center; font-family: Theme.list-font; font-size: 20px * Theme.ts; color: Theme.text; overflow: elide; }
                    VerticalLayout {
                        alignment: center;
                        Stepper { width: 150px; value: c.level; minimum: 1; maximum: c.maximum; set(v) => { App.set-class-level(c.index, v); } }
                    }
                    VerticalLayout { alignment: center; Button { kind: 3; text: "Change"; clicked => { App.change-class(c.index); } } }
                    if c.can-remove: VerticalLayout { alignment: center; Button { kind: 3; text: "Remove"; clicked => { App.remove-class(c.index); } } }
                }
            }
            if App.can-add-class: HorizontalLayout {
                alignment: start;
                Button { kind: 3; text: "Add a Second Class"; clicked => { App.open-add-class(); } }
            }
            Rectangle { vertical-stretch: 1; }
            HorizontalLayout {
                alignment: end;
                Button { width: 170px; kind: 0; text: "Done"; clicked => { App.close-overlay(); } }
            }
        }
    }
    if App.overlay == 4: Overlay {
        panel-width: 640px;
        panel-height: 300px;
        VerticalLayout {
            spacing: 14px;
            Text { text: App.message-title; font-family: Theme.title-font; font-size: 28px * Theme.ts; color: Theme.text; wrap: word-wrap; }
            MessageText { }
            HorizontalLayout {
                alignment: end;
                Button { width: 200px; kind: 0; text: "OK"; clicked => { App.close-overlay(); } }
            }
        }
    }

    // A copy whose saves macOS keeps closed (the Mac App Store's KotOR keeps them in its own
    // container), shown with every copy found so the player sees what works: a green check
    // (its saves read), a grey question mark (no saves yet, nothing checked) or a red cross.
    // Not Now stops the question for those folders, Choose the Folder opens the system's panel
    // there, Open Settings opens Full Disk Access (2026-11-08, the maintainer approved the
    // mock-ups).
    if App.overlay == 20: Overlay {
        panel-width: 820px;
        panel-height: 270px + App.copy-rows.length * 40px;
        VerticalLayout {
            spacing: 14px;
            Text { text: App.message-title; font-family: Theme.title-font; font-size: 28px * Theme.ts; color: Theme.text; wrap: word-wrap; }
            VerticalLayout {
                for row[i] in App.copy-rows: VerticalLayout {
                    HorizontalLayout {
                        height: 38px;
                        spacing: 12px;
                        Rectangle {
                            width: 24px;
                            height: 24px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 12px;
                            background: row.state == 0 ? Theme.good : row.state == 2 ? Theme.danger : Theme.faint;
                            if row.state == 0: Path {
                                width: 24px; height: 24px;
                                viewbox-width: 24; viewbox-height: 24;
                                commands: "M 6.5 12.5 L 10.5 16.5 L 17.5 8";
                                stroke: Theme.panel; stroke-width: 3px;
                            }
                            if row.state == 2: Path {
                                width: 24px; height: 24px;
                                viewbox-width: 24; viewbox-height: 24;
                                commands: "M 8 8 L 16 16 M 16 8 L 8 16";
                                stroke: Theme.panel; stroke-width: 3px;
                            }
                            if row.state == 1: Text {
                                text: "?";
                                font-family: Theme.title-font; font-size: 17px; font-weight: 700;
                                color: Theme.panel;
                                horizontal-alignment: center; vertical-alignment: center;
                            }
                        }
                        Text {
                            text: row.name;
                            font-family: Theme.list-font; font-size: 19px * Theme.ts;
                            color: Theme.text;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: row.note;
                            font-family: Theme.body-font; font-size: 15px * Theme.ts;
                            color: row.state == 2 ? Theme.danger : Theme.muted;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                        }
                    }
                    if i < App.copy-rows.length - 1: Rectangle { height: 1px; background: Theme.row-line; }
                }
            }
            MessageText { }
            HorizontalLayout {
                spacing: 14px;
                alignment: end;
                Button { width: 170px; text: "Not Now"; clicked => { App.blocked-not-now(); } }
                Button { width: 300px; text: "Choose the Folder"; clicked => { App.blocked-choose-folder(); } }
                Button { width: 220px; kind: 0; text: "Open Settings"; clicked => { App.open-privacy-settings(); } }
            }
        }
    }

    // History (2026-11-07, the maintainer): every backup of the open save, oldest first.
    if App.overlay == 16: GameDialog {
        panel-width: 860px;
        panel-height: 680px;
        title: "Backups of This Save";
        status: App.backup-rows.length == 1 ? "1 BACKUP" : App.backup-rows.length + " BACKUPS";
        note: "A backup is made when you open the save. Pick one and press Revert to go back to it. Your current save is backed up first, so you can undo it.";
        VerticalLayout {
            spacing: 18px;
            Frame {
                vertical-stretch: 1;
                VerticalLayout {
                    padding: 14px;
                    padding-right: 8px;
                    spacing: 12px;
                    Section { text: "OLDEST FIRST"; }
                    if App.backup-rows.length == 0: Note { text: "This save has no backups yet."; font-size: 14px * Theme.ts; color: Theme.muted; }
                    Scroller {
                        vertical-stretch: 1;
                        content-height: list.preferred-height;
                        list := VerticalLayout {
                            x: 0px; y: 0px;
                            width: parent.width - 16px;
                            height: self.preferred-height;
                            spacing: 8px;
                            for b[i] in App.backup-rows: brow := Rectangle {
                                property <bool> picked: i == App.backup-picked;
                                height: 58px * Theme.ts;
                                border-radius: 8px;
                                background: self.picked ? Theme.selected : pick.has-hover ? Theme.hover : Theme.field;
                                border-width: self.picked || pick.has-hover ? 2px : 1px;
                                border-color: self.picked ? Theme.accent : pick.has-hover ? Theme.hover-edge : Theme.frame-dim;
                                // picked for Revert to This Backup by a click anywhere on it
                                pick := TouchArea { mouse-cursor: pointer; clicked => { App.backup-picked = i; } }
                                Rectangle {
                                    x: 14px;
                                    width: 28px * Theme.ts; height: self.width;
                                    border-radius: self.width / 2;
                                    border-width: 1.5px;
                                    border-color: brow.picked ? Theme.accent : Theme.frame-line;
                                    background: brow.picked ? Theme.accent : transparent;
                                    Text { text: i + 1; font-family: Theme.label-font; font-size: 11px * Theme.ts; color: brow.picked ? Theme.ink : Theme.soft; }
                                }
                                VerticalLayout {
                                    x: 14px + 28px * Theme.ts + 14px;
                                    width: parent.width - self.x - show.preferred-width - 32px - (b.current ? tag.preferred-width + 24px : 0px);
                                    alignment: center;
                                    spacing: 3px;
                                    Text { text: b.when; font-family: Theme.list-font; font-size: 16px * Theme.ts; color: brow.picked ? Theme.gold : Theme.text; overflow: elide; }
                                    Text { text: b.detail; font-size: 12.5px * Theme.ts; color: Theme.muted; overflow: elide; }
                                }
                                tag := Text {
                                    visible: b.current;
                                    x: show.x - self.preferred-width - 24px;
                                    height: parent.height;
                                    vertical-alignment: center;
                                    text: "CURRENT BACKUP";
                                    font-family: Theme.label-font;
                                    font-size: 9.5px * Theme.ts;
                                    letter-spacing: 1.5px;
                                    color: Theme.accent;
                                }
                                show := Link {
                                    x: parent.width - self.preferred-width - 16px;
                                    height: parent.height;
                                    vertical-alignment: center;
                                    font-size: 13.5px * Theme.ts;
                                    text: "Show in Folder";
                                    clicked => { App.show-backup(i); }
                                }
                            }
                        }
                    }
                }
            }
            // Close, and beside it the lit Revert to This Backup once a backup is picked
            // (2026-11-07, the maintainer)
            HorizontalLayout {
                spacing: 14px;
                alignment: end;
                Button { width: 170px; text: "Close"; clicked => { App.close-overlay(); } }
                Button {
                    width: 400px;
                    kind: 0;
                    text: "Revert to This Backup";
                    enabled: App.backup-picked >= 0 && App.backup-picked < App.backup-rows.length;
                    clicked => { App.revert-to-backup(App.backup-picked); }
                }
            }
        }
    }

    // Revert to This Backup, asked once more: when the backup was made, what happens, Cancel.
    if App.overlay == 17: Overlay {
        panel-width: 680px;
        panel-height: 330px;
        VerticalLayout {
            spacing: 14px;
            Text { text: App.message-title; font-family: Theme.title-font; font-size: 28px * Theme.ts; color: Theme.text; wrap: word-wrap; }
            MessageText { }
            HorizontalLayout {
                spacing: 14px;
                alignment: end;
                // Cancel goes back to the list
                Button { width: 170px; text: "Cancel"; clicked => { App.show-history(); } }
                Button { width: 200px; kind: 0; text: "Revert"; clicked => { App.confirm-revert(); } }
            }
        }
    }

    // Revert, asked once (U-8): how many changes go, that the save on disk stays, Cancel.
    if App.overlay == 19: Overlay {
        panel-width: 600px;
        panel-height: 280px;
        VerticalLayout {
            spacing: 14px;
            Text { text: App.message-title; font-family: Theme.title-font; font-size: 28px * Theme.ts; color: Theme.text; wrap: word-wrap; }
            MessageText { }
            HorizontalLayout {
                spacing: 14px;
                alignment: end;
                Button { width: 170px; text: "Cancel"; clicked => { App.close-overlay(); } }
                Button { width: 200px; kind: 0; text: "Revert"; clicked => { App.confirm-revert-changes(); } }
            }
        }
    }

    // Advanced, Creatures: removing a creature, asked once (W-2): its name, what removing does, Cancel.
    if App.overlay == 18: Overlay {
        panel-width: 640px;
        panel-height: 300px;
        VerticalLayout {
            spacing: 14px;
            Text { text: App.message-title; font-family: Theme.title-font; font-size: 28px * Theme.ts; color: Theme.text; wrap: word-wrap; }
            MessageText { }
            HorizontalLayout {
                spacing: 14px;
                alignment: end;
                Button { width: 170px; text: "Cancel"; clicked => { App.close-overlay(); } }
                Button { width: 200px; kind: 0; text: "Remove"; clicked => { App.confirm-remove-creature(); } }
            }
        }
    }

    // A save clicked on the timeline: which one opens, and that this one closes, with Cancel.
    if App.overlay == 15: Overlay {
        panel-width: 640px;
        panel-height: 340px;
        VerticalLayout {
            spacing: 14px;
            Text { text: App.message-title; font-family: Theme.title-font; font-size: 28px * Theme.ts; color: Theme.text; wrap: word-wrap; }
            MessageText { }
            HorizontalLayout {
                spacing: 14px;
                alignment: end;
                Button { width: 170px; text: "Cancel"; clicked => { App.close-overlay(); } }
                Button { width: 290px; kind: 0; text: "Open This Save"; clicked => { App.confirm-open-save(); } }
            }
        }
    }

    // Skip Ahead: what will change, then confirm.
    if App.overlay == 10: Overlay {
        panel-width: 760px;
        panel-height: 460px + (App.skip-jedi ? 100px : 0px) + (App.skip-side ? 100px : 0px) + (App.skip-prestige ? 100px : 0px) + (App.skip-train ? 120px : 0px);
        VerticalLayout {
            spacing: 14px;
            Text { text: App.skip-title; font-family: Theme.title-font; font-size: 28px * Theme.ts; color: Theme.text; wrap: word-wrap; }
            Note { text: App.skip-summary; font-size: 14px * Theme.ts; color: Theme.muted; vertical-stretch: 1; }
            if App.skip-jedi: Label { text: "YOUR JEDI CLASS"; }
            if App.skip-jedi: Choice {
                height: 42px;
                font-size: 15px * Theme.ts;
                options: ["Jedi Guardian", "Jedi Sentinel", "Jedi Consular"];
                current: App.skip-class;
                picked(k) => { App.skip-class = k; App.refresh-story-preview(); }
            }
            if App.skip-side: Label { text: "YOUR PATH"; }
            if App.skip-side: Choice {
                height: 42px;
                font-size: 15px * Theme.ts;
                options: ["Light side", "Dark side"];
                current: App.skip-dark;
                picked(k) => { App.skip-dark = k; App.refresh-story-preview(); }
            }
            if App.skip-prestige: Label { text: "YOUR PRESTIGE CLASS"; }
            if App.skip-prestige: Choice {
                height: 42px;
                font-size: 15px * Theme.ts;
                options: App.skip-dark == 1 ? ["Sith Marauder", "Sith Assassin", "Sith Lord", "Not now"] : ["Jedi Weapon Master", "Jedi Watchman", "Jedi Master", "Not now"];
                current: App.skip-prestige-pick;
                picked(k) => { App.skip-prestige-pick = k; App.refresh-story-preview(); }
            }
            if App.skip-train: Label { text: "COMPANIONS TRAINED AS JEDI"; }
            if App.skip-train: Choice {
                height: 42px;
                font-size: 15px * Theme.ts;
                options: ["Yes, without their conversations", "No, I'll talk to them in the game"];
                current: App.skip-train-pick;
                picked(k) => { App.skip-train-pick = k; App.refresh-story-preview(); }
            }
            Note { font-size: 13px * Theme.ts; text: "Nothing is written until Save Changes. Your save was backed up when you opened it."; }
            HorizontalLayout {
                spacing: 14px;
                alignment: end;
                Button { width: 170px; text: "Cancel"; clicked => { App.close-overlay(); } }
                Button { width: 240px; kind: 0; enabled: App.story-preview-ready; text: "Skip Ahead"; clicked => { App.do-skip(); } }
            }
        }
    }
    // Save as a New Save, or Copy: the new save's name; the original stays as it is.
    if App.overlay == 14: Overlay {
        panel-width: 640px;
        panel-height: 300px;
        VerticalLayout {
            spacing: 12px;
            Text { text: App.save-as-copy ? "Copy This Save" : "Save as a New Save"; font-family: Theme.title-font; font-size: 28px * Theme.ts; color: Theme.text; }
            Note {
                font-size: 14px * Theme.ts;
                color: Theme.muted;
                text: App.save-as-copy
                    ? "Copies the save into a new slot with this name. Unsaved changes are not included."
                    : "Saves your changes as a new save with this name. The original stays as it is.";
            }
            save-as-field := Field {
                // Pressing Cancel takes the focus; that must not count as Enter.
                accept-on-blur: false;
                text <=> App.save-as-name;
                font-size: 17px * Theme.ts;
                accepted(t) => { if App.save-as-copy { App.do-copy-save(t); } else { App.do-save-as(t); } }
            }
            Rectangle { vertical-stretch: 1; }
            HorizontalLayout {
                spacing: 14px;
                alignment: end;
                Button { width: 150px; text: "Cancel"; clicked => { App.close-overlay(); } }
                Button {
                    width: 260px;
                    kind: 0;
                    text: App.save-as-copy ? "Copy" : "Save as New";
                    enabled: App.save-as-name != "";
                    clicked => { if App.save-as-copy { App.do-copy-save(App.save-as-name); } else { App.do-save-as(App.save-as-name); } }
                }
            }
        }
    }
    // A most Health or Force out of reach at the level: two short lines and a chart (a bar
    // of what the level now allows, one of what the new level allows, a gold mark where the
    // typed value falls), then the nearest it can be or the level that reaches it.
    if App.overlay == 13: Overlay {
        escape => { App.pool-cancel(); }
        panel-width: 760px;
        panel-height: App.pool-chart ? 470px : 300px;
        VerticalLayout {
            spacing: 10px;
            Text { text: App.pool-title; font-family: Theme.title-font; font-size: 28px * Theme.ts; color: Theme.text; }
            Text { text: App.pool-line; font-family: Theme.list-font; font-size: 19px * Theme.ts; color: Theme.text; wrap: word-wrap; }
            Text { text: App.pool-line2; font-family: Theme.body-font; font-size: 15px * Theme.ts; color: Theme.muted; wrap: word-wrap; }
            if App.pool-chart: Rectangle {
                height: 190px;
                // the scale: 0 to a little past the largest number shown
                property <float> top: max(App.pool-want, max(App.pool-high, App.pool-new-high)) * 1.12;
                property <length> left: 110px * Theme.ts;
                property <length> span: self.width - self.left - 10px;
                property <length> row1: 44px;
                property <length> row2: 112px;
                // a value's place on the scale
                function at(v: int) -> length { return self.left + self.span * max(0, v) / max(1, self.top); }
                Text { x: 0; y: parent.row1 - 8px; text: "LEVEL " + App.pool-level-now; font-family: Theme.label-font; font-size: 12px * Theme.ts; letter-spacing: 3px; color: Theme.soft; }
                Rectangle { x: parent.left; y: parent.row1 - 1px; width: parent.span; height: 2px; background: Theme.row-line; }
                Rectangle { x: at(App.pool-low); y: parent.row1 - 7px; width: max(4px, at(App.pool-high) - at(App.pool-low)); height: 14px; border-radius: 4px; background: Theme.accent; }
                Text { x: at(App.pool-low); y: parent.row1 + 12px; text: App.pool-low; font-size: 13px * Theme.ts; color: Theme.muted; }
                Text { x: at(App.pool-high) - self.width; y: parent.row1 + 12px; text: App.pool-high; font-size: 13px * Theme.ts; color: Theme.text; }
                if App.pool-new-level > 0: Text { x: 0; y: parent.row2 - 8px; text: "LEVEL " + App.pool-new-level; font-family: Theme.label-font; font-size: 12px * Theme.ts; letter-spacing: 3px; color: Theme.soft; }
                if App.pool-new-level > 0: Rectangle { x: parent.left; y: parent.row2 - 1px; width: parent.span; height: 2px; background: Theme.row-line; }
                if App.pool-new-level > 0: Rectangle {
                    x: at(App.pool-new-low);
                    y: parent.row2 - 7px;
                    width: max(4px, at(App.pool-new-high) - at(App.pool-new-low));
                    height: 14px;
                    border-radius: 4px;
                    border-width: 2px;
                    border-color: Theme.accent;
                    background: Theme.accent.with-alpha(0.25);
                }
                if App.pool-new-level > 0: Text { x: at(App.pool-new-low); y: parent.row2 + 12px; text: App.pool-new-low; font-size: 13px * Theme.ts; color: Theme.muted; }
                if App.pool-new-level > 0: Text { x: at(App.pool-new-high) - self.width; y: parent.row2 + 12px; text: App.pool-new-high; font-size: 13px * Theme.ts; color: Theme.text; }
                // the value typed
                Rectangle { x: at(App.pool-want) - 1px; y: 10px; width: 2px; height: parent.row2 + 24px - 10px; background: Theme.gold; }
                Rectangle { x: at(App.pool-want) - 6px; y: parent.row1 - 6px; width: 12px; height: 12px; border-radius: 6px; background: Theme.gold; }
                Text {
                    x: min(parent.width - self.width, max(0px, at(App.pool-want) - self.width / 2));
                    y: 0;
                    text: App.pool-what + " " + App.pool-want;
                    font-family: Theme.label-font;
                    font-size: 11px * Theme.ts;
                    letter-spacing: 2px;
                    color: Theme.gold;
                }
            }
            Rectangle { vertical-stretch: 1; }
            HorizontalLayout {
                spacing: 14px;
                alignment: end;
                Button { width: 150px; text: "Cancel"; clicked => { App.pool-cancel(); } }
                if App.pool-set-label != "": Button { text: App.pool-set-label; kind: App.pool-level-label == "" ? 0 : 1; clicked => { App.pool-set(); } }
                if App.pool-level-label != "": Button { text: App.pool-level-label; kind: 0; clicked => { App.pool-level(); } }
            }
        }
    }
    // Chapter navigation stays on the left. Selection details and the prepared save's
    // measured changes stay on the right, with a separate two-column inventory scroller.
    // Travelling on the timeline, in the story pop-ups' look (2026-11-07): the chapter's points
    // in a framed panel on the left, what the one picked does to the save on the right.
    if App.overlay == 12: GameDialog {
        panel-width: 1440px;
        panel-height: 900px;
        title: App.pop-title;
        status: App.pop-kicker;
        note: App.pop-note;
        VerticalLayout {
            spacing: 18px;
            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 20px;
                Frame {
                    width: min(480px, parent.width * 0.37);
                    VerticalLayout {
                        padding: 14px;
                        padding-right: 8px;
                        spacing: 12px;
                        Section { text: "WHERE TO"; }
                Scroller {
                    vertical-stretch: 1;
                    content-height: App.skip-height;
                    VerticalLayout {
                        for r[ri] in App.skip-rows: row := Rectangle {
                            property <bool> pickable: (r.depth == 2 || r.depth >= 5) && r.state != 3;
                            property <bool> picked: ri == App.pop-picked;
                            height: r.depth == 2 ? 64px : r.note != "" ? 56px : 44px;
                            border-radius: 5px;
                            border-width: self.picked ? 1px : row-touch.has-hover && (self.pickable || r.depth == 1) ? 1px : 0px;
                            border-color: Theme.hover-edge;
                            background: self.picked ? Theme.hover-edge.with-alpha(0.12) : row-touch.has-hover && (self.pickable || r.depth == 1) ? Theme.hover : transparent;
                            row-touch := TouchArea {
                                mouse-cursor: parent.pickable || r.depth == 1 ? pointer : default;
                                clicked => {
                                    if r.depth == 1 { App.toggle-skip(r.key); }
                                    else if parent.pickable { App.pick-row(ri); }
                                }
                            }
                            HorizontalLayout {
                                padding-left: r.depth == 2 ? 28px : 6px;
                                padding-right: 12px;
                                spacing: 10px;
                                if r.depth == 1: VerticalLayout {
                                    alignment: center;
                                    Path {
                                        width: 10px; height: 10px;
                                        viewbox-width: 10; viewbox-height: 10;
                                        fill: Theme.soft;
                                        commands: r.open ? "M 0 2 L 10 2 L 5 8 Z" : "M 2 0 L 8 5 L 2 10 Z";
                                    }
                                }
                                if r.depth == 2: VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 12px; height: 12px; border-radius: 6px;
                                        border-width: 1.5px;
                                        border-color: row.picked ? Theme.gold : r.state == 0 ? Theme.accent : Theme.edge;
                                        background: row.picked ? Theme.gold : transparent;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    Text {
                                        text: r.title;
                                        font-family: r.depth == 2 ? Theme.body-font : Theme.list-font;
                                        font-size: (r.depth == 2 ? 14px : 16px) * Theme.ts;
                                        color: row.picked ? Theme.gold : r.depth >= 5 ? Theme.accent : r.depth == 2 ? Theme.muted : Theme.text;
                                        wrap: word-wrap;
                                        overflow: elide;
                                    }
                                    if r.depth == 1 && r.note != "": Text {
                                        text: "MAIN STORY"; font-family: Theme.label-font;
                                        font-size: 9px * Theme.ts; letter-spacing: 2px; color: Theme.faint;
                                    }
                                }
                            }
                            if !row.picked && !row-touch.has-hover: Rectangle {
                                y: parent.height - 1px; height: 1px; background: Theme.row-line;
                            }
                        }
                    }
                }
                    }
                }
                Frame {
                    horizontal-stretch: 1;
                    StoryPreviewDetails { x: 16px; y: 14px; width: parent.width - 24px; height: parent.height - 28px; }
                }
            }
            HorizontalLayout {
                spacing: 14px;
                Note { horizontal-stretch: 1; height: 50px; vertical-alignment: center; font-size: 12.5px * Theme.ts; text: "Nothing is written until Save Changes. Your save was backed up when you opened it."; }
                Button { width: 150px; text: "Cancel"; clicked => { App.close-overlay(); } }
                Button {
                    kind: 0;
                    enabled: App.pop-action != 0 && App.story-preview-ready;
                    text: (App.pop-action == 2 ? "Go Back to " : "Skip to ") + App.pop-place;
                    clicked => { if App.pop-action == 2 { App.do-back(); } else { App.do-skip(); } }
                }
            }
        }
    }
    // Going back on the timeline: the story's inventory and credits, without a policy choice.
    if App.overlay == 11: GameDialog {
        panel-width: 820px;
        panel-height: 600px;
        title: App.back-title;
        VerticalLayout {
            spacing: 14px;
            Frame {
                vertical-stretch: 1;
                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;
                    Section { text: "WHAT GOING BACK DOES"; }
                    Scroller {
                        vertical-stretch: 1;
                        content-height: back-text.preferred-height;
                        back-text := Note { x: 0px; y: 0px; width: parent.width; text: App.back-summary; font-size: 14px * Theme.ts; color: Theme.muted; }
                    }
                }
            }
            Note { font-size: 13px * Theme.ts; text: "Nothing is written until Save Changes. Your save was backed up when you opened it."; }
            HorizontalLayout {
                spacing: 14px;
                alignment: end;
                Button { width: 170px; text: "Cancel"; clicked => { App.close-overlay(); } }
                Button { width: 240px; kind: 0; enabled: App.story-preview-ready; text: "Go Back"; clicked => { App.do-back(); } }
            }
        }
    }
    // Finish Quest: which ending, with its experience, then confirm.
    // Finish Quest (2026-11-06, the maintainer): always as if played from where the save
    // stands. The ending (and, where it changes anything, the side) on the left; on the right
    // what the save receives, measured on a copy, and what only the game does. Finish takes
    // exactly what is shown.
    if App.overlay == 8: GameDialog {
        panel-width: 1320px;
        panel-height: 860px;
        property <int> chosen: App.finish-pick;
        title: "Finish " + App.quest-title;
        note: "Plays the quest to the ending you pick, as the game would, with its XP. Nothing is written until Save Changes. Your save was backed up when you opened it.";
        VerticalLayout {
            spacing: 18px;
            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 20px;
                // the ending, and the side where it matters
                Frame {
                    width: min(470px, parent.width * 0.37);
                VerticalLayout {
                    padding: 14px;
                    padding-right: 8px;
                    spacing: 12px;
                    Section { text: App.quest-endings.length > 1 ? "HOW IT ENDS" : "HOW IT ENDS (ONE ENDING)"; }
                    Scroller {
                        vertical-stretch: 1;
                        content-height: ends.preferred-height;
                        ends := VerticalLayout {
                            x: 0px; y: 0px;
                            // inside the scroll's own width, left of its bar
                            width: parent.width - 16px;
                            spacing: 10px;
                            for x[i] in App.quest-endings: card := Rectangle {
                                // as tall as its words: a long ending was cut and began
                                // mid-sentence in a box of 88 px
                                height: max(58px, et.preferred-height + 28px);
                                border-radius: 10px;
                                border-width: 2px;
                                border-color: i == chosen ? Theme.accent : xt.has-hover ? Theme.hover-edge : Theme.frame-dim;
                                background: i == chosen ? Theme.selected : Theme.field;
                                Rectangle {
                                    x: 14px; y: (parent.height - self.height) / 2;
                                    width: 18px; height: 18px;
                                    border-radius: 9px;
                                    border-width: 2px;
                                    border-color: i == chosen ? Theme.accent : Theme.frame-line;
                                    if i == chosen: Rectangle { width: 8px; height: 8px; border-radius: 4px; background: Theme.accent; }
                                }
                                // light or dark, where the ending is one (2026-11-06, the maintainer)
                                property <int> side: i < App.quest-ending-sides.length ? App.quest-ending-sides[i] : 0;
                                if self.side != 0: Rectangle {
                                    x: parent.width - self.width - 12px;
                                    y: 12px;
                                    height: 20px * Theme.ts;
                                    width: side-tag.preferred-width + 16px;
                                    border-radius: self.height / 2;
                                    border-width: 1px;
                                    border-color: card.side > 0 ? Theme.light-side : Theme.dark-side;
                                    side-tag := Text {
                                        text: card.side > 0 ? "LIGHT SIDE" : "DARK SIDE";
                                        font-family: Theme.label-font;
                                        font-size: 9.5px * Theme.ts;
                                        letter-spacing: 1.5px;
                                        color: card.side > 0 ? Theme.light-side : Theme.dark-side;
                                    }
                                }
                                et := Text {
                                    x: 46px; y: 14px;
                                    width: parent.width - 46px - 14px - (card.side != 0 ? 110px * Theme.ts : 0px);
                                    // the words alone: the XP the ending gives in all is on the right (the
                                    // journal's own XP here read 1,000 where finishing gives 1,050)
                                    text: x.text != "" ? x.text : "Ending " + x.id;
                                    wrap: word-wrap;
                                    font-family: Theme.body-font;
                                    font-size: 13.5px * Theme.ts;
                                    color: i == chosen ? Theme.text : Theme.muted;
                                }
                                xt := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        if (App.finish-pick != i) {
                                            App.finish-pick = i;
                                            App.refresh-quest-preview();
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if App.quest-side-matters: Section { text: "YOUR PATH"; }
                    if App.quest-side-matters: Choice {
                        height: 40px;
                        font-size: 14px * Theme.ts;
                        options: ["Light side", "Dark side"];
                        current: App.quest-dark;
                        picked(k) => { App.quest-dark = k; App.refresh-quest-preview(); }
                    }
                }
                }
                // what the save receives
                Frame {
                    horizontal-stretch: 1;
                    Scroller {
                        x: 14px; y: 14px;
                        width: parent.width - 22px;
                        height: parent.height - 28px;
                        content-height: receive.preferred-height;
                        receive := VerticalLayout {
                            x: 0px; y: 0px;
                            // inside the scroll's own width, left of its bar
                            width: parent.width - 16px;
                            // its own height: as tall as the scroller it spread its rows apart
                            height: self.preferred-height;
                            spacing: 18px;
                            StoryValues { }
                            // what else the editor does (a member let go, areas stored)
                            if App.story-preview-ready && App.story-notes != "": VerticalLayout {
                                spacing: 10px;
                                Section { text: "ALSO DONE"; }
                                Note { text: App.story-notes; font-size: 13px * Theme.ts; color: Theme.muted; }
                            }
                            // the steps only the game can run. "Happens in the game" until
                            // 2026-11-07 (audit, S-7): the game may never run a step the
                            // journal is past, and the editor's own notes were listed there too
                            if App.story-preview-ready && App.story-game-notes != "": VerticalLayout {
                                spacing: 10px;
                                Section { text: "LEFT TO THE GAME"; }
                                Note { text: "The editor can't do these. The game may skip them now that the quest is further on."; font-size: 13px * Theme.ts; color: Theme.faint; }
                                Note { text: App.story-game-notes; font-size: 13px * Theme.ts; color: Theme.muted; }
                            }
                            // in the same scroll as the rest: beside it, a reward's items took
                            // the room and hid the last rows of the changes
                            StoryItems { }
                        }
                    }
                }
            }
            HorizontalLayout {
                spacing: 14px;
                alignment: end;
                Button { width: 170px; text: "Cancel"; clicked => { App.close-overlay(); } }
                Button {
                    width: 240px;
                    kind: 0;
                    text: "Finish Quest";
                    enabled: App.story-preview-ready;
                    clicked => { if (App.quest-endings.length > chosen) { App.finish-quest(App.quest-endings[chosen].id); } }
                }
            }
        }
    }
    if App.overlay == 7: Overlay {
        panel-width: 860px;
        panel-height: 860px;
        VerticalLayout {
            spacing: 12px;
            Text { text: "Settings"; font-family: Theme.title-font; font-size: 30px * Theme.ts; color: Theme.text; }
            // the options scroll when the window is too short for them (U-10: with Large text
            // at the smallest window Done was pushed off the pop-up); Done stays in view
            settings-scroll := Scroller {
                vertical-stretch: 1;
                content-height: settings-options.preferred-height;
                settings-options := VerticalLayout {
                    x: 0px; y: 0px;
                    width: parent.width - 16px;
                    height: self.preferred-height;
                    spacing: 12px;
                    Rectangle { height: 4px; }
                    Label { text: "TEXT SIZE"; }
                    Choice {
                        options: ["Small", "Medium", "Large"];
                        current: Theme.text-size;
                        picked(i) => { Theme.text-size = i; App.settings-changed(); }
                    }
                    Rectangle { height: 6px; }
                    Label { text: "APPEARANCE"; }
                    Choice {
                        options: ["Dark", "Light"];
                        icons: 1;
                        current: Theme.dark ? 0 : 1;
                        picked(i) => { Theme.dark = i == 0; App.settings-changed(); }
                    }
                    Rectangle { height: 6px; }
                    Label { text: "GAME FOLDERS"; }
                    for g[i] in [{ name: "KotOR", path: App.k1-folder }, { name: "KotOR II", path: App.k2-folder }]: Rectangle {
                        height: 52px;
                        Rectangle { y: parent.height - 1px; height: 1px; background: Theme.row-line; }
                        HorizontalLayout {
                            spacing: 14px;
                            Text { width: 130px; text: g.name; vertical-alignment: center; font-family: Theme.list-font; font-size: 18px * Theme.ts; color: Theme.text; }
                            Text { text: g.path != "" ? g.path : "Not found"; vertical-alignment: center; font-family: Theme.body-font; font-size: 14px * Theme.ts; color: g.path != "" ? Theme.muted : Theme.faint; overflow: elide; horizontal-stretch: 1; }
                            VerticalLayout { alignment: center; Button { kind: 3; text: "Change"; enabled: App.page == 0; clicked => { App.choose-game-folder(); } } }
                        }
                    }
                    Rectangle { height: 6px; }
                    Label { text: "SAVE FOLDERS"; }
                    Note {
                        font-size: 14px * Theme.ts;
                        // Folders change only from the list of saves: a new folder can switch the game
                        // under an open save.
                        text: App.page == 0
                            ? "Steam, GOG and disc saves are found automatically. Add saves from anywhere else here, like a phone, a Switch or another PC."
                            : "Folders can be changed from the list of saves (the arrow, top left).";
                    }
                    if App.added-folders.length == 0: Text {
                        text: "No folders added.";
                        font-family: Theme.body-font;
                        font-size: 14px * Theme.ts;
                        color: Theme.faint;
                    }
                    VerticalLayout {
                        for f[i] in App.added-folders: Rectangle {
                            height: 48px;
                            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.row-line; }
                            HorizontalLayout {
                                spacing: 14px;
                                Text { text: f; vertical-alignment: center; font-family: Theme.body-font; font-size: 14px * Theme.ts; color: Theme.muted; overflow: elide; horizontal-stretch: 1; }
                                VerticalLayout { alignment: center; Button { kind: 3; text: "Remove"; enabled: App.page == 0; clicked => { App.remove-save-folder(i); } } }
                            }
                        }
                    }
                    HorizontalLayout {
                        alignment: start;
                        Button { kind: 3; text: "Add a Save Folder"; enabled: App.page == 0; clicked => { App.add-save-folder(); } }
                    }
                    if App.page == 1: Rectangle { height: 6px; }
                    if App.page == 1: Label { text: "BACKUPS"; }
                    if App.page == 1: Note {
                        font-size: 14px * Theme.ts;
                        text: "Your save is backed up here when you open it: " + App.backup-path;
                    }
                    if App.page == 1: HorizontalLayout {
                        alignment: start;
                        Button { kind: 3; text: "Open Backups Folder"; clicked => { App.open-backups(); } }
                    }
                }
            }
            HorizontalLayout {
                spacing: 14px;
                Text { text: "KOTOR Modern Gamesave Editor v1.0 · Created by RaymanGT"; vertical-alignment: center; font-family: Theme.body-font; font-size: 13px * Theme.ts; color: Theme.faint; horizontal-stretch: 1; }
                Button { width: 170px; kind: 0; text: "Done"; clicked => { App.close-overlay(); } }
            }
        }
    }
}
