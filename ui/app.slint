// KOTOR Modern Gamesave Editor
//
// THESIS: a save editor that looks and reads like KotOR itself: the Load screen to pick
// a save, the in-game menu's tabs to change it, every value edited where it is shown.
// It refuses the usual grid of dialogs and the tile dashboard.
// OWN-WORLD: the KMRP Font Converter's navy, cyan and gold (KotOR) or teal-green
// (KotOR II), dark or light; KMRP's own Original HD Font; hairline panels, 5 px corners,
// orange for anything changed and not yet saved.
// STORY: the player finds their save without setup, changes it, sees what changed, saves
// with a backup made first, and goes back to the game.
// FIRST VIEWPORT: the KMRP crest and "Save Editor" top left, the game switch top right,
// the saves list on the left, the picked save's picture, party and Open on the right.
// FORM: in-game menu (tabs). A surface roll assigned a tile dashboard (structure 4 of 7);
// the maintainer turned it down and chose the tabs, 2026-10-22. seed: none (unavailable)
// FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review,
// the verdict, and DESIGN.md

import { Theme } from "theme.slint";
import { App, SaveRow, Member, Stat, Named, ItemRow, NpcRow, GlobalRow, DoorRow, BoxRow, PortraitRow, Toggle, StoryValue, StoryItem } from "state.slint";
import { Button, Field, Note, Scroller, Brand, Link, Sign, Stepper, Label, Choice, SettingsButton, Switch, AlignmentChoice } from "widgets.slint";
import { SavesPage } from "saves.slint";
import { EditorPage } from "editor.slint";

export { Theme, App, SaveRow, Member, Stat, Named, ItemRow, NpcRow, GlobalRow, DoorRow, BoxRow, PortraitRow, Toggle, StoryValue, StoryItem }

component Overlay inherits Rectangle {
    in property <length> panel-width: 760px;
    in property <length> panel-height: 620px;
    // Escape does what the pop-up's Cancel or Close does (2026-11-06: no pop-up answered it)
    callback escape;
    escape => { App.close-overlay(); }
    background: Theme.scrim;
    // around everything, so Escape typed in a box inside reaches it too
    keys := FocusScope {
        init => { self.focus(); }
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                root.escape();
                return accept;
            }
            return reject;
        }
        TouchArea { }
        panel := Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(root.panel-width, parent.width - 80px);
            height: min(root.panel-height, parent.height - 80px);
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.edge;
            border-radius: 12px;
            Rectangle {
                x: 32px;
                y: 28px;
                width: parent.width - 64px;
                height: parent.height - 56px;
                @children
            }
        }
    }
}

// What a story change does to the save, measured on a copy: the values before and after, and
// what is gained and lost (companions, feats, powers). Shared by Skip Ahead, Go Back and
// Finish Quest (2026-11-06).
component StoryValues inherits VerticalLayout {
    in property <bool> compact;
    spacing: 10px;
    if !App.story-preview-ready: Note { text: App.story-preview-status; font-size: 14px * Theme.ts; }
    if App.story-preview-ready: VerticalLayout {
        spacing: 4px;
        alignment: start;
        Label { text: "CHANGES TO YOUR SAVE"; font-size: 11px * Theme.ts; letter-spacing: 2px; }
        HorizontalLayout {
            height: 26px;
            Text { width: parent.width * 0.34; text: "CHANGE"; font-family: Theme.label-font; font-size: 9px * Theme.ts; color: Theme.soft; }
            Text { width: parent.width * 0.43; text: "CURRENT  →  AFTER"; font-family: Theme.label-font; font-size: 9px * Theme.ts; color: Theme.soft; }
            Text { text: "DIFFERENCE"; font-family: Theme.label-font; font-size: 9px * Theme.ts; color: Theme.soft; }
        }
        // One colour language everywhere (2026-11-06, the maintainer): what goes up is green,
        // what goes down red, the value after the change gold, what stays the same plain.
        for r in App.story-values: Rectangle {
            height: root.compact ? 34px : 40px;
            HorizontalLayout {
                spacing: 0px;
                Text { width: parent.width * 0.34; text: r.label; font-size: 13.5px * Theme.ts; color: Theme.text; vertical-alignment: center; overflow: elide; }
                HorizontalLayout {
                    width: parent.width * 0.43;
                    spacing: 8px;
                    alignment: start;
                    Text { text: r.before; font-size: 13.5px * Theme.ts; color: r.changed ? Theme.muted : Theme.text; vertical-alignment: center; overflow: elide; }
                    if r.changed: Text { text: "→"; font-size: 13.5px * Theme.ts; color: Theme.faint; vertical-alignment: center; }
                    if r.changed: Text { text: r.after; font-size: 13.5px * Theme.ts; color: Theme.gold; vertical-alignment: center; overflow: elide; }
                }
                Text { text: r.difference; font-size: 13.5px * Theme.ts; color: r.change > 0 ? Theme.gain : r.change < 0 ? Theme.danger : Theme.muted; vertical-alignment: center; }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.row-line; }
        }
        for r in App.story-grants: Rectangle {
            height: 38px;
            HorizontalLayout {
                spacing: 10px;
                Text { width: 16px; text: r.id > 0 ? "+" : "-"; font-size: 14px * Theme.ts; color: r.id > 0 ? Theme.gain : Theme.danger; vertical-alignment: center; }
                Text { text: r.name; font-size: 13.5px * Theme.ts; color: Theme.text; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                Text { text: r.note; font-size: 11px * Theme.ts; color: r.id > 0 ? Theme.gain : Theme.danger; vertical-alignment: center; }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.row-line; }
        }
    }
}

// The inventory changes of a story change, in a box that scrolls: `rows` rows of items high.
component StoryItems inherits VerticalLayout {
    in property <int> rows: 2;
    spacing: 10px;
    // the heading on its box, whatever room the pop-up gives
    alignment: start;
    if App.story-preview-ready: Label { text: "INVENTORY CHANGES"; font-size: 11px * Theme.ts; letter-spacing: 2px; }
    if App.story-preview-ready && App.story-items.length == 0: Note { text: "No inventory changes."; font-size: 13px * Theme.ts; }
    if App.story-preview-ready && App.story-items.length > 0: Rectangle {
        height: root.rows * 76px + 10px;
        border-width: 1px; border-color: Theme.edge; border-radius: 5px;
        Scroller {
            x: 5px; y: 5px; width: parent.width - 10px; height: parent.height - 10px;
            content-height: Math.ceil(App.story-items.length / 2) * 76px;
            Rectangle {
                x: 0px; y: 0px;
                width: parent.width - 12px;
                height: Math.ceil(App.story-items.length / 2) * 76px;
                for r[i] in App.story-items: Rectangle {
                    x: Math.mod(i, 2) * self.width;
                    y: Math.floor(i / 2) * 76px;
                    width: parent.width / 2;
                    height: 76px;
                    Rectangle {
                        x: 8px; y: 14px; width: 48px; height: 48px;
                        background: Theme.field; border-width: 1px; border-color: Theme.edge; border-radius: 3px;
                        if r.has-icon: Image { source: r.icon; image-fit: contain; }
                    }
                    VerticalLayout {
                        x: 66px; width: parent.width - 154px;
                        alignment: center;
                        spacing: 2px;
                        Text { text: r.name; font-size: 13px * Theme.ts; color: Theme.text; wrap: word-wrap; overflow: elide; max-height: 2.6 * 13px * Theme.ts; }
                        Text { text: r.gained ? "Added" : "Removed"; font-size: 11px * Theme.ts; color: r.gained ? Theme.gain : Theme.danger; }
                    }
                    Text {
                        x: parent.width - 80px; width: 72px; height: parent.height;
                        text: r.difference; font-size: 13px * Theme.ts;
                        color: r.gained ? Theme.gain : Theme.danger;
                        vertical-alignment: center; horizontal-alignment: right;
                    }
                    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.row-line; }
                    if Math.mod(i, 2) == 1: Rectangle { x: 0px; y: 0px; width: 1px; height: parent.height; background: Theme.row-line; }
                }
            }
        }
    }
}

component StoryPreviewDetails inherits Rectangle {
    property <bool> back: App.overlay == 11 || (App.overlay == 12 && App.pop-action == 2);
    VerticalLayout {
        spacing: 12px;
        Scroller {
            vertical-stretch: 1;
            min-height: 120px;
            content-height: details.preferred-height;
            details := VerticalLayout {
                x: 0px; y: 0px;
                width: parent.width - 12px;
                spacing: 10px;
                Text {
                    text: App.pop-action == 0 && App.overlay == 12 ? "Choose a subchapter" : App.pop-detail;
                    font-family: Theme.title-font; font-size: 25px * Theme.ts;
                    color: Theme.text; wrap: word-wrap;
                }
                if App.pop-action != 0 || App.overlay != 12: Scroller {
                    height: min(summary.preferred-height + 4px, 110px);
                    content-height: summary.preferred-height;
                    summary := Note {
                        x: 0px; y: 0px;
                        width: parent.width - 12px;
                        text: root.back ? App.back-summary : App.skip-summary;
                        font-size: 13px * Theme.ts;
                    }
                }
                if !root.back && App.pop-action != 0: VerticalLayout {
                    spacing: 8px;
                    if App.skip-jedi: Label { text: "YOUR JEDI CLASS"; font-size: 11px * Theme.ts; }
                    if App.skip-jedi: Choice {
                        height: 40px; font-size: 14px * Theme.ts;
                        options: ["Jedi Guardian", "Jedi Sentinel", "Jedi Consular"];
                        current: App.skip-class;
                        picked(k) => { App.skip-class = k; App.refresh-story-preview(); }
                    }
                    if App.skip-side: Label { text: "YOUR PATH"; font-size: 11px * Theme.ts; }
                    if App.skip-side: Choice {
                        height: 40px; font-size: 14px * Theme.ts;
                        options: ["Light side", "Dark side"]; current: App.skip-dark;
                        picked(k) => { App.skip-dark = k; App.refresh-story-preview(); }
                    }
                    if App.skip-prestige: Label { text: "YOUR PRESTIGE CLASS"; font-size: 11px * Theme.ts; }
                    if App.skip-prestige: Choice {
                        height: 40px; font-size: 14px * Theme.ts;
                        options: App.skip-dark == 1 ? ["Sith Marauder", "Sith Assassin", "Sith Lord", "Not now"] : ["Jedi Weapon Master", "Jedi Watchman", "Jedi Master", "Not now"];
                        current: App.skip-prestige-pick;
                        picked(k) => { App.skip-prestige-pick = k; App.refresh-story-preview(); }
                    }
                    if App.skip-train: Label { text: "COMPANIONS AS JEDI"; font-size: 11px * Theme.ts; }
                    if App.skip-train: Choice {
                        height: 40px; font-size: 14px * Theme.ts;
                        options: ["Trained, no conversations", "I'll talk to them"]; current: App.skip-train-pick;
                        picked(k) => { App.skip-train-pick = k; App.refresh-story-preview(); }
                    }
                }
                if root.back: AlignmentChoice {
                    value: App.back-alignment;
                    set(v) => { App.back-alignment = v; }
                    committed => { App.refresh-story-preview(); }
                }
                StoryValues { compact: root.back; }
            }
        }
        StoryItems {
            // two rows, one where the skip asks two questions or more, so the totals above
            // keep their room (at 1600 by 900 with Large text the skip's choices and a taller
            // box left the totals out of view); it scrolls
            rows: root.back ? 2 : ((App.skip-jedi ? 1 : 0) + (App.skip-side ? 1 : 0) + (App.skip-prestige ? 1 : 0) + (App.skip-train ? 1 : 0)) >= 2 ? 1 : 2;
        }
    }
}

export component AppWindow inherits Window {
    title: "KOTOR Modern Gamesave Editor";
    icon: @image-url("../assets/save-editor-icon.png");
    preferred-width: 1600px;
    preferred-height: 900px;
    min-width: 1280px;
    min-height: 780px;
    background: Theme.window;
    default-font-family: Theme.body-font;

    // After an edit the whole window is drawn again. Slint's software renderer draws only what
    // it finds changed, and it missed a change: on KotOR II's Abilities tab, adding a feat and
    // a power and removing both left "FORCE POWERS · 9" on screen with 8 in the save until the
    // window was resized (2026-11-06; reproduced every time with those four clicks). This
    // covers the window and its colour changes with every edit, so all of it counts as
    // changed. It is black at 1/255 at most, under everything, and takes no clicks. (Only
    // hiding and showing it, with no colour, was not enough: the count stayed wrong.)
    Rectangle { width: 100%; height: 100%; background: App.repaint ? #00000001 : #00000000; }

    // Where the focus goes when the mouse is pressed anywhere (main.rs): a text box being
    // typed in then takes what was typed, as if Enter were pressed.
    sink := FocusScope {
        width: 0;
        height: 0;
        // a click in a pop-up brings the focus here: Escape still closes it
        key-pressed(e) => {
            if (e.text == Key.Escape && App.overlay != 0) {
                if (App.overlay == 13) { App.pool-cancel(); } else { App.close-overlay(); }
                return accept;
            }
            return reject;
        }
    }
    public function drop-focus() {
        // Rename is explicit: outside presses cancel, while the field and save icon
        // keep their focus and draft until Enter or the icon is pressed.
        if App.renaming-save {
            if !App.rename-hovered {
                App.renaming-save = false;
                sink.focus();
            }
            return;
        }
        sink.focus();
    }

    // The header's glow, behind everything.
    Rectangle {
        y: 0;
        height: 220px;
        background: @radial-gradient(circle, Theme.glow 0%, Theme.window 70%);
        width: parent.width * 1.6;
        x: -parent.width * 0.55;
    }
    Rectangle { y: 140px; height: 80px; background: @linear-gradient(180deg, transparent 0%, Theme.window 100%); }

    // The name gives way below the width where it would run under the buttons on the right
    // (measured 2026-11-06 at 1280 by 780: the editor's Revert covered "Editor").
    Brand { x: App.page == 1 ? 140px : 60px; y: 44px; height: 110px; short: App.page == 1; named: App.page == 1 ? root.width >= 1400px : root.width >= 1460px; }

    if App.page == 0: SavesPage { }
    if App.page == 1: EditorPage { }

    // Footer, on the list of saves only. The folders moved into Settings on 2026-10-22, and
    // in the editor the backups did too, so the tabs reach the bottom.
    if App.page == 0: HorizontalLayout {
        x: 60px;
        y: parent.height - 46px;
        width: parent.width - 120px - 220px;
        height: 30px;
        spacing: 14px;
        alignment: start;
        Text { text: "v1.0"; vertical-alignment: center; font-size: 15px * Theme.ts; color: Theme.faint; }
        Text { text: "·"; vertical-alignment: center; font-size: 15px * Theme.ts; color: Theme.faint; }
        if App.page == 0: Link { text: "Open Saves Folder"; vertical-alignment: center; clicked => { App.open-saves-folder(); } }
        if App.page == 0: Text { text: "·"; vertical-alignment: center; font-size: 15px * Theme.ts; color: Theme.faint; }
        if App.page == 0: Link { text: "Refresh"; vertical-alignment: center; clicked => { App.refresh-saves(); } }
    }
    if App.page == 0: Text {
        x: parent.width - 60px - self.width;
        y: parent.height - 46px;
        height: 30px;
        vertical-alignment: center;
        text: "Created by RaymanGT";
        font-size: 15px * Theme.ts;
        color: Theme.faint;
    }

    // Settings, top right on both pages.
    SettingsButton {
        x: parent.width - 60px - self.width;
        y: 52px;
        clicked => { App.open-settings(); }
    }

    // ---- pop-ups ----
    if App.overlay == 1 || App.overlay == 5: Overlay {
        panel-width: 900px;
        panel-height: 720px;
        property <string> query;
        VerticalLayout {
            spacing: 10px;
            Text { text: App.overlay-title; font-family: Theme.title-font; font-size: 30px * Theme.ts; color: Theme.text; }
            Note { text: App.overlay-note; font-size: 15px * Theme.ts; }
            // the categories share the row (at 1280 by 780 the last ran out of the pop-up)
            if App.overlay == 1 && App.picker-tabs.length > 0: HorizontalLayout {
                spacing: 6px;
                for t[i] in App.picker-tabs: Rectangle {
                    height: 34px;
                    min-width: tt.preferred-width + 12px;
                    horizontal-stretch: 1;
                    border-radius: 5px;
                    border-width: 1px;
                    border-color: i == App.picker-tab ? Theme.accent : Theme.edge;
                    background: i == App.picker-tab ? Theme.selected : pt2.has-hover ? Theme.hover : Theme.field;
                    tt := Text { text: t; font-family: Theme.list-font; font-size: 14px * Theme.ts; color: i == App.picker-tab ? Theme.text : Theme.soft; }
                    pt2 := TouchArea { mouse-cursor: pointer; clicked => { App.select-picker-tab(i); } }
                }
            }
            if App.overlay == 1: Field {
                text <=> query;
                placeholder: App.picker-placeholder;
                font: Theme.body-font;
                font-size: 15px * Theme.ts;
                edited(t) => { App.search-picker(t); }
            }
            Scroller {
                vertical-stretch: 1;
                content-height: App.picker.length * 50px;
                VerticalLayout {
                    for r in App.picker: Rectangle {
                        height: 50px;
                        background: pt.has-hover ? Theme.hover : transparent;
                        border-radius: 5px;
                        Rectangle { y: parent.height - 1px; height: 1px; background: Theme.row-line; }
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 10px;
                            if r.has-icon: VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 40px;
                                    height: 40px;
                                    border-radius: 4px;
                                    border-width: 1px;
                                    border-color: Theme.edge;
                                    background: Theme.field;
                                    clip: true;
                                    Image { source: r.icon; width: parent.width; height: parent.height; }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Text { text: r.name; font-family: Theme.list-font; font-size: 17px * Theme.ts; color: Theme.text; overflow: elide; }
                                Text { text: r.note; font-family: Theme.body-font; font-size: 12px * Theme.ts; color: Theme.faint; overflow: elide; }
                            }
                            Rectangle { width: 30px; Sign { plus: true; colour: Theme.accent; } }
                        }
                        pt := TouchArea { mouse-cursor: pointer; clicked => { App.pick(r.id); } }
                    }
                }
            }
            HorizontalLayout {
                alignment: end;
                Button { width: 170px; text: "Close"; clicked => { App.close-overlay(); } }
            }
        }
    }
    if App.overlay == 2: Overlay {
        panel-width: 980px;
        panel-height: 700px;
        VerticalLayout {
            spacing: 10px;
            Text { text: App.overlay-title; font-family: Theme.title-font; font-size: 30px * Theme.ts; color: Theme.text; }
            Note { text: App.overlay-note; font-size: 15px * Theme.ts; }
            Scroller {
                vertical-stretch: 1;
                property <int> per-row: 10;
                content-height: Math.ceil(App.looks.length / per-row) * 92px;
                Rectangle {
                    height: Math.ceil(App.looks.length / per-row) * 92px;
                    for p[i] in App.looks: Rectangle {
                        x: Math.mod(i, per-row) * 90px;
                        y: Math.floor(i / per-row) * 92px;
                        width: 82px;
                        height: 82px;
                        border-radius: 5px;
                        border-width: p.current ? 3px : lt.has-hover ? 2px : 1px;
                        border-color: p.current ? Theme.gold : lt.has-hover ? Theme.accent : Theme.edge;
                        background: Theme.field;
                        clip: true;
                        Image { source: p.image; width: parent.width - 6px; height: parent.height - 6px; }
                        lt := TouchArea { mouse-cursor: pointer; clicked => { App.pick-look(p.id); } }
                    }
                }
            }
            HorizontalLayout {
                alignment: end;
                Button { width: 170px; text: "Close"; clicked => { App.close-overlay(); } }
            }
        }
    }
    if App.overlay == 3: Overlay {
        panel-height: 700px;
        VerticalLayout {
            spacing: 10px;
            Text { text: App.overlay-title; font-family: Theme.title-font; font-size: 30px * Theme.ts; color: Theme.text; }
            Note { text: App.overlay-note; font-size: 15px * Theme.ts; }
            Scroller {
                vertical-stretch: 1;
                content-height: App.other-saves.length * 78px;
                VerticalLayout {
                    spacing: 4px;
                    for s[i] in App.other-saves: Rectangle {
                        height: 74px;
                        border-radius: 6px;
                        background: ot.has-hover ? Theme.hover : transparent;
                        HorizontalLayout {
                            padding: 6px;
                            spacing: 14px;
                            Rectangle {
                                width: 82px;
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: Theme.edge;
                                background: Theme.field;
                                clip: true;
                                if s.has-shot: Image { source: s.shot; width: parent.width; height: parent.height; image-fit: fill; }
                            }
                            VerticalLayout {
                                alignment: center;
                                Text { text: s.name; font-family: Theme.list-font; font-size: 18px * Theme.ts; color: Theme.text; overflow: elide; }
                                Text { text: s.area + "  ·  " + s.date; font-family: Theme.body-font; font-size: 13px * Theme.ts; color: Theme.faint; overflow: elide; }
                            }
                        }
                        ot := TouchArea { mouse-cursor: pointer; clicked => { App.pick-save(i); } }
                    }
                }
            }
            HorizontalLayout {
                alignment: end;
                Button { width: 170px; text: "Cancel"; clicked => { App.close-overlay(); } }
            }
        }
    }
    if App.overlay == 6: Overlay {
        panel-width: 760px;
        panel-height: 250px + App.class-rows.length * 72px;
        VerticalLayout {
            spacing: 12px;
            Text { text: "Classes"; font-family: Theme.title-font; font-size: 30px * Theme.ts; color: Theme.text; }
            Note {
                font-size: 15px * Theme.ts;
                text: "A level up adds the class's Health and Force; a level down takes back what that level gave (feats, powers, skill ranks). Experience follows the new level. The game knows two classes at most.";
            }
            for c in App.class-rows: Rectangle {
                height: 60px;
                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.row-line; }
                HorizontalLayout {
                    spacing: 14px;
                    Text { text: c.name; vertical-alignment: center; font-family: Theme.list-font; font-size: 20px * Theme.ts; color: Theme.text; overflow: elide; }
                    VerticalLayout {
                        alignment: center;
                        Stepper { width: 150px; value: c.level; minimum: 1; maximum: c.maximum; set(v) => { App.set-class-level(c.index, v); } }
                    }
                    VerticalLayout { alignment: center; Button { kind: 3; text: "Change"; clicked => { App.change-class(c.index); } } }
                    if c.can-remove: VerticalLayout { alignment: center; Button { kind: 3; text: "Remove"; clicked => { App.remove-class(c.index); } } }
                }
            }
            if App.can-add-class: HorizontalLayout {
                alignment: start;
                Button { kind: 3; text: "Add a Second Class"; clicked => { App.open-add-class(); } }
            }
            Rectangle { vertical-stretch: 1; }
            HorizontalLayout {
                alignment: end;
                Button { width: 170px; kind: 0; text: "Done"; clicked => { App.close-overlay(); } }
            }
        }
    }
    if App.overlay == 4: Overlay {
        panel-width: 640px;
        panel-height: 300px;
        VerticalLayout {
            spacing: 14px;
            Text { text: App.message-title; font-family: Theme.title-font; font-size: 28px * Theme.ts; color: Theme.text; wrap: word-wrap; }
            Note { text: App.message-body; font-size: 15px * Theme.ts; color: Theme.muted; vertical-stretch: 1; }
            HorizontalLayout {
                alignment: end;
                Button { width: 200px; kind: 0; text: "OK"; clicked => { App.close-overlay(); } }
            }
        }
    }

    // A save clicked on the timeline: which one opens, and that this one closes, with Cancel.
    if App.overlay == 15: Overlay {
        panel-width: 640px;
        panel-height: 340px;
        VerticalLayout {
            spacing: 14px;
            Text { text: App.message-title; font-family: Theme.title-font; font-size: 28px * Theme.ts; color: Theme.text; wrap: word-wrap; }
            Note { text: App.message-body; font-size: 15px * Theme.ts; color: Theme.muted; vertical-stretch: 1; }
            HorizontalLayout {
                spacing: 14px;
                alignment: end;
                Button { width: 170px; text: "Cancel"; clicked => { App.close-overlay(); } }
                Button { width: 290px; kind: 0; text: "Open This Save"; clicked => { App.confirm-open-save(); } }
            }
        }
    }

    // Skip Ahead: what will change, then confirm.
    if App.overlay == 10: Overlay {
        panel-width: 760px;
        panel-height: 460px + (App.skip-jedi ? 100px : 0px) + (App.skip-side ? 100px : 0px) + (App.skip-prestige ? 100px : 0px) + (App.skip-train ? 120px : 0px);
        VerticalLayout {
            spacing: 14px;
            Text { text: App.skip-title; font-family: Theme.title-font; font-size: 28px * Theme.ts; color: Theme.text; wrap: word-wrap; }
            Note { text: App.skip-summary; font-size: 14px * Theme.ts; color: Theme.muted; vertical-stretch: 1; }
            if App.skip-jedi: Label { text: "YOUR JEDI CLASS"; }
            if App.skip-jedi: Choice {
                height: 42px;
                font-size: 15px * Theme.ts;
                options: ["Jedi Guardian", "Jedi Sentinel", "Jedi Consular"];
                current: App.skip-class;
                picked(k) => { App.skip-class = k; App.refresh-story-preview(); }
            }
            if App.skip-side: Label { text: "YOUR PATH"; }
            if App.skip-side: Choice {
                height: 42px;
                font-size: 15px * Theme.ts;
                options: ["Light side", "Dark side"];
                current: App.skip-dark;
                picked(k) => { App.skip-dark = k; App.refresh-story-preview(); }
            }
            if App.skip-prestige: Label { text: "YOUR PRESTIGE CLASS"; }
            if App.skip-prestige: Choice {
                height: 42px;
                font-size: 15px * Theme.ts;
                options: App.skip-dark == 1 ? ["Sith Marauder", "Sith Assassin", "Sith Lord", "Not now"] : ["Jedi Weapon Master", "Jedi Watchman", "Jedi Master", "Not now"];
                current: App.skip-prestige-pick;
                picked(k) => { App.skip-prestige-pick = k; App.refresh-story-preview(); }
            }
            if App.skip-train: Label { text: "COMPANIONS TRAINED AS JEDI"; }
            if App.skip-train: Choice {
                height: 42px;
                font-size: 15px * Theme.ts;
                options: ["Yes, without their conversations", "No, I'll talk to them in the game"];
                current: App.skip-train-pick;
                picked(k) => { App.skip-train-pick = k; App.refresh-story-preview(); }
            }
            Note { font-size: 13px * Theme.ts; text: "Nothing is written until Save Changes, and a backup of the save is made first."; }
            HorizontalLayout {
                spacing: 14px;
                alignment: end;
                Button { width: 170px; text: "Cancel"; clicked => { App.close-overlay(); } }
                Button { width: 240px; kind: 0; enabled: App.story-preview-ready; text: "Skip Ahead"; clicked => { App.do-skip(); } }
            }
        }
    }
    // Save as a New Save, or Copy: the new save's name; the original stays as it is.
    if App.overlay == 14: Overlay {
        panel-width: 640px;
        panel-height: 300px;
        VerticalLayout {
            spacing: 12px;
            Text { text: App.save-as-copy ? "Copy This Save" : "Save as a New Save"; font-family: Theme.title-font; font-size: 28px * Theme.ts; color: Theme.text; }
            Note {
                font-size: 14px * Theme.ts;
                color: Theme.muted;
                text: App.save-as-copy
                    ? "A copy of the save as it is on disk goes into the next free slot, under this name on the game's Load screen. Changes not saved yet are not in it, and they stay open here."
                    : "Your changes go into a new save in the next free slot, under this name on the game's Load screen. The save you opened stays exactly as it was.";
            }
            save-as-field := Field {
                // Pressing Cancel takes the focus; that must not count as Enter.
                accept-on-blur: false;
                text <=> App.save-as-name;
                font-size: 17px * Theme.ts;
                accepted(t) => { if App.save-as-copy { App.do-copy-save(t); } else { App.do-save-as(t); } }
            }
            Rectangle { vertical-stretch: 1; }
            HorizontalLayout {
                spacing: 14px;
                alignment: end;
                Button { width: 150px; text: "Cancel"; clicked => { App.close-overlay(); } }
                Button {
                    width: 260px;
                    kind: 0;
                    text: App.save-as-copy ? "Copy" : "Save as New";
                    enabled: App.save-as-name != "";
                    clicked => { if App.save-as-copy { App.do-copy-save(App.save-as-name); } else { App.do-save-as(App.save-as-name); } }
                }
            }
        }
    }
    // A most Health or Force out of reach at the level: two short lines and a chart (a bar
    // of what the level now allows, one of what the new level allows, a gold mark where the
    // typed value falls), then the nearest it can be or the level that reaches it.
    if App.overlay == 13: Overlay {
        escape => { App.pool-cancel(); }
        panel-width: 760px;
        panel-height: App.pool-chart ? 470px : 300px;
        VerticalLayout {
            spacing: 10px;
            Text { text: App.pool-title; font-family: Theme.title-font; font-size: 28px * Theme.ts; color: Theme.text; }
            Text { text: App.pool-line; font-family: Theme.list-font; font-size: 19px * Theme.ts; color: Theme.text; wrap: word-wrap; }
            Text { text: App.pool-line2; font-family: Theme.body-font; font-size: 15px * Theme.ts; color: Theme.muted; wrap: word-wrap; }
            if App.pool-chart: Rectangle {
                height: 190px;
                // the scale: 0 to a little past the largest number shown
                property <float> top: max(App.pool-want, max(App.pool-high, App.pool-new-high)) * 1.12;
                property <length> left: 110px * Theme.ts;
                property <length> span: self.width - self.left - 10px;
                property <length> row1: 44px;
                property <length> row2: 112px;
                // a value's place on the scale
                function at(v: int) -> length { return self.left + self.span * max(0, v) / max(1, self.top); }
                Text { x: 0; y: parent.row1 - 8px; text: "LEVEL " + App.pool-level-now; font-family: Theme.label-font; font-size: 12px * Theme.ts; letter-spacing: 3px; color: Theme.soft; }
                Rectangle { x: parent.left; y: parent.row1 - 1px; width: parent.span; height: 2px; background: Theme.row-line; }
                Rectangle { x: at(App.pool-low); y: parent.row1 - 7px; width: max(4px, at(App.pool-high) - at(App.pool-low)); height: 14px; border-radius: 4px; background: Theme.accent; }
                Text { x: at(App.pool-low); y: parent.row1 + 12px; text: App.pool-low; font-size: 13px * Theme.ts; color: Theme.muted; }
                Text { x: at(App.pool-high) - self.width; y: parent.row1 + 12px; text: App.pool-high; font-size: 13px * Theme.ts; color: Theme.text; }
                if App.pool-new-level > 0: Text { x: 0; y: parent.row2 - 8px; text: "LEVEL " + App.pool-new-level; font-family: Theme.label-font; font-size: 12px * Theme.ts; letter-spacing: 3px; color: Theme.soft; }
                if App.pool-new-level > 0: Rectangle { x: parent.left; y: parent.row2 - 1px; width: parent.span; height: 2px; background: Theme.row-line; }
                if App.pool-new-level > 0: Rectangle {
                    x: at(App.pool-new-low);
                    y: parent.row2 - 7px;
                    width: max(4px, at(App.pool-new-high) - at(App.pool-new-low));
                    height: 14px;
                    border-radius: 4px;
                    border-width: 2px;
                    border-color: Theme.accent;
                    background: Theme.accent.with-alpha(0.25);
                }
                if App.pool-new-level > 0: Text { x: at(App.pool-new-low); y: parent.row2 + 12px; text: App.pool-new-low; font-size: 13px * Theme.ts; color: Theme.muted; }
                if App.pool-new-level > 0: Text { x: at(App.pool-new-high) - self.width; y: parent.row2 + 12px; text: App.pool-new-high; font-size: 13px * Theme.ts; color: Theme.text; }
                // the value typed
                Rectangle { x: at(App.pool-want) - 1px; y: 10px; width: 2px; height: parent.row2 + 24px - 10px; background: Theme.gold; }
                Rectangle { x: at(App.pool-want) - 6px; y: parent.row1 - 6px; width: 12px; height: 12px; border-radius: 6px; background: Theme.gold; }
                Text {
                    x: min(parent.width - self.width, max(0px, at(App.pool-want) - self.width / 2));
                    y: 0;
                    text: App.pool-what + " " + App.pool-want;
                    font-family: Theme.label-font;
                    font-size: 11px * Theme.ts;
                    letter-spacing: 2px;
                    color: Theme.gold;
                }
            }
            Rectangle { vertical-stretch: 1; }
            HorizontalLayout {
                spacing: 14px;
                alignment: end;
                Button { width: 150px; text: "Cancel"; clicked => { App.pool-cancel(); } }
                if App.pool-set-label != "": Button { text: App.pool-set-label; kind: App.pool-level-label == "" ? 0 : 1; clicked => { App.pool-set(); } }
                if App.pool-level-label != "": Button { text: App.pool-level-label; kind: 0; clicked => { App.pool-level(); } }
            }
        }
    }
    // Chapter navigation stays on the left. Selection details and the prepared save's
    // measured changes stay on the right, with a separate two-column inventory scroller.
    if App.overlay == 12: Overlay {
        panel-width: 1440px;
        panel-height: 900px;
        VerticalLayout {
            spacing: 10px;
            Label { text: App.pop-kicker; font-size: 13px * Theme.ts; }
            Text { text: App.pop-title; font-family: Theme.title-font; font-size: 30px * Theme.ts; color: Theme.text; }
            Note { text: App.pop-note; }
            Rectangle { height: 1px; background: Theme.row-line; }
            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 24px;
                Scroller {
                    width: min(480px, parent.width * 0.37);
                    content-height: App.skip-height;
                    VerticalLayout {
                        for r[ri] in App.skip-rows: row := Rectangle {
                            property <bool> pickable: (r.depth == 2 || r.depth >= 5) && r.state != 3;
                            property <bool> picked: ri == App.pop-picked;
                            height: r.depth == 2 ? 64px : r.note != "" ? 56px : 44px;
                            border-radius: 5px;
                            border-width: self.picked ? 1px : row-touch.has-hover && (self.pickable || r.depth == 1) ? 1px : 0px;
                            border-color: Theme.hover-edge;
                            background: self.picked ? Theme.hover-edge.with-alpha(0.12) : row-touch.has-hover && (self.pickable || r.depth == 1) ? Theme.hover : transparent;
                            row-touch := TouchArea {
                                mouse-cursor: parent.pickable || r.depth == 1 ? pointer : default;
                                clicked => {
                                    if r.depth == 1 { App.toggle-skip(r.key); }
                                    else if parent.pickable { App.pick-row(ri); }
                                }
                            }
                            HorizontalLayout {
                                padding-left: r.depth == 2 ? 28px : 6px;
                                padding-right: 12px;
                                spacing: 10px;
                                if r.depth == 1: VerticalLayout {
                                    alignment: center;
                                    Path {
                                        width: 10px; height: 10px;
                                        viewbox-width: 10; viewbox-height: 10;
                                        fill: Theme.soft;
                                        commands: r.open ? "M 0 2 L 10 2 L 5 8 Z" : "M 2 0 L 8 5 L 2 10 Z";
                                    }
                                }
                                if r.depth == 2: VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 12px; height: 12px; border-radius: 6px;
                                        border-width: 1.5px;
                                        border-color: row.picked ? Theme.gold : r.state == 0 ? Theme.accent : Theme.edge;
                                        background: row.picked ? Theme.gold : transparent;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    Text {
                                        text: r.title;
                                        font-family: r.depth == 2 ? Theme.body-font : Theme.list-font;
                                        font-size: (r.depth == 2 ? 14px : 16px) * Theme.ts;
                                        color: row.picked ? Theme.gold : r.depth >= 5 ? Theme.accent : r.depth == 2 ? Theme.muted : Theme.text;
                                        wrap: word-wrap;
                                        overflow: elide;
                                    }
                                    if r.depth == 1 && r.note != "": Text {
                                        text: "MAIN STORY"; font-family: Theme.label-font;
                                        font-size: 9px * Theme.ts; letter-spacing: 2px; color: Theme.faint;
                                    }
                                }
                            }
                            if !row.picked && !row-touch.has-hover: Rectangle {
                                y: parent.height - 1px; height: 1px; background: Theme.row-line;
                            }
                        }
                    }
                }
                Rectangle { width: 1px; background: Theme.edge; }
                StoryPreviewDetails { horizontal-stretch: 1; }
            }
            Rectangle { height: 1px; background: Theme.row-line; }
            HorizontalLayout {
                spacing: 14px;
                padding-top: 4px;
                Note { horizontal-stretch: 1; height: 50px; vertical-alignment: center; font-size: 12.5px * Theme.ts; text: "Nothing is written until Save Changes, and a backup is made first."; }
                Button { width: 150px; text: "Cancel"; clicked => { App.close-overlay(); } }
                Button {
                    kind: 0;
                    enabled: App.pop-action != 0 && App.story-preview-ready;
                    text: (App.pop-action == 2 ? "Go Back to " : "Skip to ") + App.pop-place;
                    clicked => { if App.pop-action == 2 { App.do-back(); } else { App.do-skip(); } }
                }
            }
        }
    }
    // Going back on the timeline: the story's inventory and credits, without a policy choice.
    if App.overlay == 11: Overlay {
        panel-width: 760px;
        panel-height: 560px;
        VerticalLayout {
            spacing: 14px;
            Text { text: App.back-title; font-family: Theme.title-font; font-size: 28px * Theme.ts; color: Theme.text; wrap: word-wrap; }
            Note { text: App.back-summary; font-size: 14px * Theme.ts; color: Theme.muted; vertical-stretch: 1; }
            Note { font-size: 13px * Theme.ts; text: "Nothing is written until Save Changes, and a backup of the save is made first."; }
            HorizontalLayout {
                spacing: 14px;
                alignment: end;
                Button { width: 170px; text: "Cancel"; clicked => { App.close-overlay(); } }
                Button { width: 240px; kind: 0; enabled: App.story-preview-ready; text: "Go Back"; clicked => { App.do-back(); } }
            }
        }
    }
    // Finish Quest: which ending, with its experience, then confirm.
    // Finish Quest (2026-11-06, the maintainer): always as if played from where the save
    // stands. The ending (and, where it changes anything, the side) on the left; on the right
    // what the save receives, measured on a copy, and what only the game does. Finish takes
    // exactly what is shown.
    if App.overlay == 8: Overlay {
        panel-width: 1300px;
        panel-height: 860px;
        property <int> chosen: App.finish-pick;
        VerticalLayout {
            spacing: 10px;
            Text { text: "Finish " + App.quest-title; font-family: Theme.title-font; font-size: 28px * Theme.ts; color: Theme.text; wrap: word-wrap; }
            Note {
                font-size: 14px * Theme.ts;
                text: "As if you played it from where the save stands: everything the game does on the way to the ending you pick, and the experience it gives. Nothing is written until Save Changes, and a backup is made first.";
            }
            Rectangle { height: 1px; background: Theme.row-line; }
            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 24px;
                // the ending, and the side where it matters
                VerticalLayout {
                    width: min(460px, parent.width * 0.38);
                    spacing: 10px;
                    Label { text: App.quest-endings.length > 1 ? "HOW IT ENDS" : "HOW IT ENDS (ONE ENDING)"; font-size: 11px * Theme.ts; letter-spacing: 2px; }
                    Scroller {
                        vertical-stretch: 1;
                        content-height: ends.preferred-height;
                        ends := VerticalLayout {
                            x: 0px; y: 0px;
                            width: parent.width - 12px;
                            spacing: 8px;
                            for x[i] in App.quest-endings: card := Rectangle {
                                // as tall as its words: a long ending was cut and began
                                // mid-sentence in a box of 88 px
                                height: max(64px, et.preferred-height + 28px);
                                border-radius: 8px;
                                border-width: i == chosen ? 2px : 1px;
                                border-color: i == chosen ? Theme.accent : xt.has-hover ? Theme.soft : Theme.edge;
                                background: i == chosen ? Theme.selected : Theme.field;
                                Rectangle {
                                    x: 14px; y: (parent.height - self.height) / 2;
                                    width: 18px; height: 18px;
                                    border-radius: 9px;
                                    border-width: 2px;
                                    border-color: i == chosen ? Theme.accent : Theme.edge;
                                    if i == chosen: Rectangle { width: 8px; height: 8px; border-radius: 4px; background: Theme.accent; }
                                }
                                // light or dark, where the ending is one (2026-11-06, the maintainer)
                                property <int> side: i < App.quest-ending-sides.length ? App.quest-ending-sides[i] : 0;
                                if self.side != 0: Rectangle {
                                    x: parent.width - self.width - 12px;
                                    y: 12px;
                                    height: 20px * Theme.ts;
                                    width: side-tag.preferred-width + 16px;
                                    border-radius: self.height / 2;
                                    border-width: 1px;
                                    border-color: card.side > 0 ? Theme.light-side : Theme.dark-side;
                                    side-tag := Text {
                                        text: card.side > 0 ? "LIGHT SIDE" : "DARK SIDE";
                                        font-family: Theme.label-font;
                                        font-size: 9.5px * Theme.ts;
                                        letter-spacing: 1.5px;
                                        color: card.side > 0 ? Theme.light-side : Theme.dark-side;
                                    }
                                }
                                et := Text {
                                    x: 46px; y: 14px;
                                    width: parent.width - 46px - 14px - (card.side != 0 ? 110px * Theme.ts : 0px);
                                    // the words alone: the XP the ending gives in all is on the right (the
                                    // journal's own XP here read 1,000 where finishing gives 1,050)
                                    text: x.text != "" ? x.text : "Ending " + x.id;
                                    wrap: word-wrap;
                                    font-family: Theme.body-font;
                                    font-size: 13.5px * Theme.ts;
                                    color: i == chosen ? Theme.text : Theme.muted;
                                }
                                xt := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        if (App.finish-pick != i) {
                                            App.finish-pick = i;
                                            App.refresh-quest-preview();
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if App.quest-side-matters: Label { text: "YOUR PATH"; font-size: 11px * Theme.ts; letter-spacing: 2px; }
                    if App.quest-side-matters: Choice {
                        height: 40px;
                        font-size: 14px * Theme.ts;
                        options: ["Light side", "Dark side"];
                        current: App.quest-dark;
                        picked(k) => { App.quest-dark = k; App.refresh-quest-preview(); }
                    }
                }
                Rectangle { width: 1px; background: Theme.edge; }
                // what the save receives
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 12px;
                    Scroller {
                        vertical-stretch: 1;
                        min-height: 120px;
                        content-height: receive.preferred-height;
                        receive := VerticalLayout {
                            x: 0px; y: 0px;
                            width: parent.width - 12px;
                            // its own height: as tall as the scroller it spread its rows apart
                            height: self.preferred-height;
                            spacing: 14px;
                            StoryValues { }
                            if App.story-preview-ready && App.story-notes != "": VerticalLayout {
                                spacing: 6px;
                                Label { text: "WHAT ONLY THE GAME DOES"; font-size: 11px * Theme.ts; letter-spacing: 2px; }
                                Note { text: App.story-notes; font-size: 13px * Theme.ts; }
                            }
                            // in the same scroll as the rest: beside it, a reward's items took
                            // the room and hid the last rows of the changes
                            StoryItems { rows: 2; }
                        }
                    }
                }
            }
            Rectangle { height: 1px; background: Theme.row-line; }
            HorizontalLayout {
                spacing: 14px;
                alignment: end;
                Button { width: 170px; text: "Cancel"; clicked => { App.close-overlay(); } }
                Button {
                    width: 240px;
                    kind: 0;
                    text: "Finish Quest";
                    enabled: App.story-preview-ready;
                    clicked => { if (App.quest-endings.length > chosen) { App.finish-quest(App.quest-endings[chosen].id); } }
                }
            }
        }
    }
    if App.overlay == 7: Overlay {
        panel-width: 860px;
        panel-height: 860px;
        VerticalLayout {
            spacing: 12px;
            Text { text: "Settings"; font-family: Theme.title-font; font-size: 30px * Theme.ts; color: Theme.text; }
            Rectangle { height: 4px; }
            Label { text: "TEXT SIZE"; }
            Choice {
                options: ["Small", "Medium", "Large"];
                current: Theme.text-size;
                picked(i) => { Theme.text-size = i; App.settings-changed(); }
            }
            Rectangle { height: 6px; }
            Label { text: "APPEARANCE"; }
            Choice {
                options: ["Dark", "Light"];
                icons: 1;
                current: Theme.dark ? 0 : 1;
                picked(i) => { Theme.dark = i == 0; App.settings-changed(); }
            }
            Rectangle { height: 6px; }
            Label { text: "GAME FOLDERS"; }
            for g[i] in [{ name: "KotOR", path: App.k1-folder }, { name: "KotOR II", path: App.k2-folder }]: Rectangle {
                height: 52px;
                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.row-line; }
                HorizontalLayout {
                    spacing: 14px;
                    Text { width: 130px; text: g.name; vertical-alignment: center; font-family: Theme.list-font; font-size: 18px * Theme.ts; color: Theme.text; }
                    Text { text: g.path != "" ? g.path : "Not found"; vertical-alignment: center; font-family: Theme.body-font; font-size: 14px * Theme.ts; color: g.path != "" ? Theme.muted : Theme.faint; overflow: elide; horizontal-stretch: 1; }
                    VerticalLayout { alignment: center; Button { kind: 3; text: "Change"; enabled: App.page == 0; clicked => { App.choose-game-folder(); } } }
                }
            }
            Rectangle { height: 6px; }
            Label { text: "SAVE FOLDERS"; }
            Note {
                font-size: 14px * Theme.ts;
                // Folders change only from the list of saves: a new folder can switch the game
                // under an open save.
                text: App.page == 0
                    ? "Saves in Steam, Steam Cloud, GOG and disc installs are found by themselves. Add saves from anywhere else: a phone, a Switch, another PC."
                    : "Folders can be changed from the list of saves (the arrow, top left).";
            }
            if App.added-folders.length == 0: Text {
                text: "No folders added.";
                font-family: Theme.body-font;
                font-size: 14px * Theme.ts;
                color: Theme.faint;
            }
            Scroller {
                vertical-stretch: 1;
                content-height: App.added-folders.length * 48px;
                VerticalLayout {
                    for f[i] in App.added-folders: Rectangle {
                        height: 48px;
                        Rectangle { y: parent.height - 1px; height: 1px; background: Theme.row-line; }
                        HorizontalLayout {
                            spacing: 14px;
                            Text { text: f; vertical-alignment: center; font-family: Theme.body-font; font-size: 14px * Theme.ts; color: Theme.muted; overflow: elide; horizontal-stretch: 1; }
                            VerticalLayout { alignment: center; Button { kind: 3; text: "Remove"; enabled: App.page == 0; clicked => { App.remove-save-folder(i); } } }
                        }
                    }
                }
            }
            HorizontalLayout {
                alignment: start;
                Button { kind: 3; text: "Add a Save Folder"; enabled: App.page == 0; clicked => { App.add-save-folder(); } }
            }
            if App.page == 1: Rectangle { height: 6px; }
            if App.page == 1: Label { text: "BACKUPS"; }
            if App.page == 1: Note {
                font-size: 14px * Theme.ts;
                text: "Before every save the whole save folder is copied here: " + App.backup-path;
            }
            if App.page == 1: HorizontalLayout {
                alignment: start;
                Button { kind: 3; text: "Open Backups Folder"; clicked => { App.open-backups(); } }
            }
            HorizontalLayout {
                spacing: 14px;
                Text { text: "KOTOR Modern Gamesave Editor v1.0 · Created by RaymanGT"; vertical-alignment: center; font-family: Theme.body-font; font-size: 13px * Theme.ts; color: Theme.faint; horizontal-stretch: 1; }
                Button { width: 170px; kind: 0; text: "Done"; clicked => { App.close-overlay(); } }
            }
        }
    }
}
